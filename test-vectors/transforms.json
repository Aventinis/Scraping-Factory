{
 "description": "Issue #388: the extension's live transform preview (applyTransformsPreview, field-transforms.js) and the generated scripts' _apply_transforms must produce the same value for the same chain. Cases without appliesTo run on both sides; appliesTo [\"js\"] / [\"python\"] limits a case to one side and the note says why. expected null = 'preview unavailable' (JS only).",
 "cases": [
  {
   "name": "no transforms leave the value alone",
   "value": "  x ",
   "transforms": [],
   "expected": "  x "
  },
  {
   "name": "trim strips both ends",
   "value": " \t a b \n",
   "transforms": [
    {
     "kind": "trim"
    }
   ],
   "expected": "a b"
  },
  {
   "name": "regexExtract keeps group 2",
   "value": "tel 12-34",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "(\\d+)-(\\d+)",
     "group": 2
    }
   ],
   "expected": "34"
  },
  {
   "name": "regexExtract without group keeps the whole match",
   "value": "tel 12-34",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "\\d+-\\d+"
    }
   ],
   "expected": "12-34"
  },
  {
   "name": "regexExtract without a match gives empty",
   "value": "kein Preis",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "\\d+",
     "group": 0
    }
   ],
   "expected": ""
  },
  {
   "name": "regexExtract with an out-of-range group gives empty",
   "value": "a1",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "a(\\d)",
     "group": 5
    }
   ],
   "expected": ""
  },
  {
   "name": "regexExtract with a group that did not participate gives empty",
   "value": "ac",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "a(b)?c",
     "group": 1
    }
   ],
   "expected": ""
  },
  {
   "name": "regexExtract anchors",
   "value": "  hello world",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "^\\s*(\\w+)",
     "group": 1
    }
   ],
   "expected": "hello"
  },
  {
   "name": "regexExtract lazy quantifier",
   "value": "12.99 € netto",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "(.+?)\\s*€",
     "group": 1
    }
   ],
   "expected": "12.99"
  },
  {
   "name": "regexExtract with an invalid pattern is unavailable in the preview",
   "value": "x",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "(",
     "group": 0
    }
   ],
   "expected": null,
   "appliesTo": [
    "js"
   ],
   "note": "The companion rejects such a pattern before generating (FieldTransformValidator); the preview reports 'unavailable'."
  },
  {
   "name": "regexExtract \\w is Unicode-aware in Python only",
   "value": "Müller",
   "transforms": [
    {
     "kind": "regexExtract",
     "pattern": "(\\w+)",
     "group": 1
    }
   ],
   "expected": "Müller",
   "appliesTo": [
    "python"
   ],
   "note": "Known divergence: JS RegExp without the u flag treats \\w as ASCII-only, so the preview shows 'M'. Avoid \\w/\\d/\\s on non-ASCII text in the pattern helper or accept the preview difference."
  },
