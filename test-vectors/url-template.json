{
 "description": "Issue #388: which values of one placeholder does a pool of recorded request URLs reveal? The extension's findUrlTemplateMatches (popup/api-config.js, 'Fill from recording') and the generated script's _match_url_against_template (browser discovery) must pick the same requests and extract the same values: same origin and path-segment count, every fixed segment/query value equal, other placeholders free. expected lists each distinct extracted value once, in first-seen order, skipping empty values.",
 "cases": [
  {
   "name": "extracts a path placeholder from sibling requests",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test/api/obst/items",
    "https://shop.test/api/gemuese/items",
    "https://shop.test/api/tiefkuehl/items"
   ],
   "expected": [
    "obst",
    "gemuese",
    "tiefkuehl"
   ]
  },
  {
   "name": "a different fixed segment is a different endpoint",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test/api/obst/products",
    "https://shop.test/other/obst/items"
   ],
   "expected": []
  },
  {
   "name": "a different segment count is a different endpoint",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test/api/obst/items/extra",
    "https://shop.test/api/obst"
   ],
   "expected": []
  },
  {
   "name": "a different host is a different endpoint",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://other.test/api/obst/items"
   ],
   "expected": []
  },
  {
   "name": "a different scheme is a different endpoint",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "http://shop.test/api/obst/items"
   ],
   "expected": []
  },
  {
   "name": "a different port is a different endpoint",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test:8443/api/obst/items"
   ],
   "expected": []
  },
  {
   "name": "repeated values are listed once, in first-seen order",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test/api/b/items",
    "https://shop.test/api/a/items",
    "https://shop.test/api/b/items"
   ],
   "expected": [
    "b",
    "a"
   ]
  },
  {
   "name": "fixed segments are case-sensitive",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test/API/obst/items"
   ],
   "expected": []
  },
  {
   "name": "a trailing slash does not change the segment count",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test/api/obst/items/"
   ],
   "expected": [
    "obst"
   ]
  },
  {
   "name": "query placeholder as the target",
   "template": "https://shop.test/api/items?cat={cat}&page=1",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/items?cat=a&page=1",
    "https://shop.test/api/items?cat=b&page=1"
   ],
   "expected": [
    "a",
    "b"
   ]
  },
  {
   "name": "a different fixed query value is a different endpoint",
   "template": "https://shop.test/api/items?cat={cat}&page=1",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/items?cat=a&page=2"
   ],
   "expected": []
  },
  {
   "name": "a different query key set is a different endpoint",
   "template": "https://shop.test/api/items?cat={cat}&page=1",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/items?cat=a",
    "https://shop.test/api/items?cat=a&page=1&extra=1"
   ],
   "expected": []
  },
  {
   "name": "query parameter order does not matter",
   "template": "https://shop.test/api/items?cat={cat}&page=1",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/items?page=1&cat=z"
   ],
   "expected": [
    "z"
   ]
  },
  {
   "name": "other placeholders are free to differ",
   "template": "https://shop.test/{a}/{b}",
   "target": "a",
   "candidates": [
    "https://shop.test/1/2",
    "https://shop.test/3/4",
    "https://shop.test/1/9"
   ],
   "expected": [
    "1",
    "3"
   ]
  },
  {
   "name": "the target can be any of several placeholders",
   "template": "https://shop.test/{a}/{b}",
   "target": "b",
   "candidates": [
    "https://shop.test/1/2",
    "https://shop.test/3/4"
   ],
   "expected": [
    "2",
    "4"
   ]
  },
  {
   "name": "a placeholder in the query and one in the path",
   "template": "https://shop.test/api/{week}/items?cat={cat}",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/2026-W05/items?cat=a",
    "https://shop.test/api/2026-W06/items?cat=b"
   ],
   "expected": [
    "a",
    "b"
   ]
  },
  {
   "name": "query values are percent-decoded",
   "template": "https://shop.test/api/items?cat={cat}",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/items?cat=a%20b",
    "https://shop.test/api/items?cat=c%26d"
   ],
   "expected": [
    "a b",
    "c&d"
   ]
  },
  {
   "name": "a plus sign in a query value is a space",
   "template": "https://shop.test/api/items?cat={cat}",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/items?cat=a+b"
   ],
   "expected": [
    "a b"
   ]
  },
  {
   "name": "path values stay percent-encoded",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "https://shop.test/api/caf%C3%A9/items"
   ],
   "expected": [
    "caf%C3%A9"
   ]
  },
  {
   "name": "an empty query value is not a value",
   "template": "https://shop.test/api/items?cat={cat}",
   "target": "cat",
   "candidates": [
    "https://shop.test/api/items?cat="
   ],
   "expected": []
  },
  {
   "name": "a candidate that is not an http URL is skipped",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [
    "data:text/plain,hello",
    "https://shop.test/api/obst/items"
   ],
   "expected": [
    "obst"
   ]
  },
  {
   "name": "no candidates",
   "template": "https://shop.test/api/{category}/items",
   "target": "category",
   "candidates": [],
   "expected": []
  }
 ]
}
