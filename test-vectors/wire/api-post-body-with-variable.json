              "numberValue": 50
            },
            "active": {
              "kind": "Boolean",
              "boolValue": true
            },
            "cursor": {
              "kind": "Null"
            },
            "tags": {
              "items": [
                {
                  "kind": "String",
                  "stringValue": "a"
                },
                {
                  "kind": "String",
                  "stringValue": "b"
                }
              ]
            }
          }
        }
      }
    }
  },
  "scriptFileName": null,
  "outputFileName": null
}
