{
  "version": "1",
  "url": "https://example.test/menu",
  "groups": [
    {
      "name": "Category",
      "selector": "section.category",
      "repeating": true,
      "children": [
        {
          "name": "Heading",
          "selector": "h2",
          "mode": "Text"
        },
        {
          "name": "Dish",
          "selector": "li.dish",
          "repeating": true,
          "children": [
            {
              "name": "Name",
              "selector": "h3",
              "mode": "Text"
            },
            {
              "name": "Price",
              "selector": ".price",
              "mode": "Text",
              "transforms": [
                {
                  "kind": "trim"
                },
                {
                  "kind": "toNumber"
                }
              ]
            },
            {
              "name": "Label",
              "selector": "h3",
              "mode": "OwnText"
            },
            {
              "name": "Vegan",
              "selector": ".vegan",
              "mode": "Exists"
            },
            {
              "name": "Link",
              "selector": "a",
              "mode": "Attribute",
              "attribute": "href"
            }
          ]
        }
      ]
    }
  ],
  "scriptFileName": null,
  "outputFileName": null,
  "outputFormat": "Json",
  "deduplication": {
    "keyFields": [
      "Name"
    ],
    "incremental": true,
    "incrementalOutput": "Delta",
    "retention": {
      "kind": "MaxCount",
      "value": 5000
    }
  },
  "headers": [
    {
      "name": "Referer",
      "value": "https://example.test/"
    }
  ],
  "hardening": [
    {
      "kind": "noResult",
      "severity": "Error"
    },
    {
      "kind": "nullRate",
      "severity": "Warning",
      "fieldName": "Price",
      "threshold": 0.5
    },
    {
      "kind": "baseline",
      "severity": "Warning",
      "dropThreshold": 0.25
    },
    {
      "kind": "blocking",
      "severity": "Warning",
      "minBodyLength": 1000,
      "blockPhrases": [
        "Access Denied",
        "Please verify you are human"
      ]
    },
    {
      "kind": "requiredFields",
      "severity": "Error",
      "fieldNames": [
        "Name"
      ]
    }
  ],
  "pagination": {
    "kind": "nextLink",
    "nextLinkSelector": "a.next",
    "maxPages": 4
  }
}
