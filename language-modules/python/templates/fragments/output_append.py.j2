# Issue #342: append this run's result to the existing output file instead of
# replacing it. One rule for schema drift in every format: whatever columns/
# fields the file already has are kept, new ones are added, and a value that
# is missing on either side is empty. An existing file that cannot be read or
# has a different shape (e.g. a JSON object where a list is expected) stops
# the run with a clear message — silently overwriting accumulated data would
# be worse. A missing or empty file is simply the first run. (CSV/JSON/XML
# are merged here before the normal writer runs; SQLite/Excel append inside
# their own writers, see output_tabular.)
import csv as _ap_csv
import json as _ap_json
import os as _ap_os

EXIT_APPEND_FAILED = 10


def _append_failed(path, reason):
    print(f"ERROR: cannot append to {path}: {reason}", file=sys.stderr)
    sys.exit(EXIT_APPEND_FAILED)


def _merge_fieldnames(existing, new):
    return list(existing) + [name for name in new if name not in existing]


# Flat CSV / JSON array: previous rows first, then this run's; the columns are
# the file's own plus any new ones. Returns (fieldnames, rows).
def _append_previous_rows(path, fieldnames, rows):
    if not _ap_os.path.exists(path) or _ap_os.path.getsize(path) == 0:
        return fieldnames, rows
    try:
        with open(path, "r", encoding="utf-8", newline="") as f:
            if path.lower().endswith(".json"):
                previous = _ap_json.load(f)
                if not isinstance(previous, list) or not all(isinstance(item, dict) for item in previous):
                    _append_failed(path, "the existing file is not a JSON list of records.")
                columns = []
                for item in previous:
                    columns = _merge_fieldnames(columns, item.keys())
                return _merge_fieldnames(columns, fieldnames), previous + rows
            reader = _ap_csv.DictReader(f)
            previous = list(reader)
            columns = list(reader.fieldnames or [])
    except (OSError, ValueError, _ap_csv.Error) as error:
        _append_failed(path, f"the existing file could not be read ({type(error).__name__}).")
    merged = _merge_fieldnames(columns, fieldnames)
    return merged, [{name: row.get(name) or "" for name in merged} for row in previous + rows]


# XML: this run's children are appended under the existing root element.
# Returns the root to write — the existing one, extended.
def _append_previous_xml(path, root):
    import xml.etree.ElementTree as _ap_et
    if not _ap_os.path.exists(path) or _ap_os.path.getsize(path) == 0:
        return root
    try:
        existing = _ap_et.parse(path).getroot()
    except (OSError, _ap_et.ParseError) as error:
        _append_failed(path, f"the existing file could not be read ({type(error).__name__}).")
    if existing.tag != root.tag:
        _append_failed(path, f"its root element <{existing.tag}> is not <{root.tag}>.")
    for child in list(root):
        existing.append(child)
    return existing


# JSON tree (an object of tag -> value | list, see _xml_to_dict): a tag that
# occurs in both becomes one list of all occurrences, new tags are added.
def _append_previous_json_tree(path, tree):
    if not _ap_os.path.exists(path) or _ap_os.path.getsize(path) == 0:
        return tree
    try:
        with open(path, "r", encoding="utf-8") as f:
            existing = _ap_json.load(f)
    except (OSError, ValueError) as error:
        _append_failed(path, f"the existing file could not be read ({type(error).__name__}).")
    if not isinstance(existing, dict):
        _append_failed(path, "the existing file is not a JSON object.")
    merged = dict(existing)
    for key, value in tree.items():
        if key in merged:
            old = merged[key] if isinstance(merged[key], list) else [merged[key]]
            merged[key] = old + (value if isinstance(value, list) else [value])
        else:
            merged[key] = value
    return merged


