#@include request_delay
#@include retry
#@include output_append
def main():
{{~ if change_detection_any ~}}
    previous_contents = {block["name"]: (_read_previous_output(block["output_path"]) if block["change_detection"]["enabled"] else None) for block in BLOCKS}
{{~ end ~}}

    per_block_data = {block["name"]: [] for block in BLOCKS if block["shape"] == "flat"}
    per_block_roots = {block["name"]: ET.Element("Ergebnis") for block in BLOCKS if block["shape"] == "group"}
    for url in URLS:
{{~ if robots_check.enabled ~}}
        if not _robots_gate(url):
            continue
{{~ end ~}}
        page_results = scrape(url)
        for block in BLOCKS:
            if block["shape"] == "flat":
                per_block_data[block["name"]].extend(page_results[block["name"]])
            else:
                for el in page_results[block["name"]]:
                    per_block_roots[block["name"]].append(el)

    hardening_failed = False
    for block in BLOCKS:
        name = block["name"]
        if block["shape"] == "flat":
            data = per_block_data[name]
{{~ if hardening_any ~}}
            data, required_fields_failed = _filter_required_fields(block, data)
{{~ end ~}}
{{~ if append_output ~}}
            count = len(data)
            if block["output_is_json"]:
                _, written = _append_previous_rows(block["output_path"], [], data)
                with open(block["output_path"], "w", encoding="utf-8") as f:
                    json.dump(written, f, ensure_ascii=False, indent=2)
            else:
                field_order, written = _append_previous_rows(block["output_path"], block["field_order"], data)
                with open(block["output_path"], "w", newline="", encoding="utf-8") as f:
                    writer = csv.DictWriter(f, fieldnames=field_order)
                    writer.writeheader()
                    writer.writerows(written)
            print(f"Done — [{name}] {count} rows appended to {block['output_path']}")
{{~ else ~}}
            if block["output_is_json"]:
                with open(block["output_path"], "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
            else:
                with open(block["output_path"], "w", newline="", encoding="utf-8") as f:
                    writer = csv.DictWriter(f, fieldnames=block["field_order"])
                    writer.writeheader()
                    writer.writerows(data)
            count = len(data)
            print(f"Done — [{name}] {count} rows written to {block['output_path']}")
{{~ end ~}}
{{~ if hardening_any ~}}
            block_failed = _run_hardening_checks(block, count, lambda field, data=data: [str(row.get(field, "")) for row in data]) or required_fields_failed
{{~ end ~}}
        else:
            root = per_block_roots[name]
            if block["output_is_json"]:
{{~ if append_output ~}}
                json_tree = _append_previous_json_tree(block["output_path"], _xml_to_dict(root))
{{~ end ~}}
                with open(block["output_path"], "w", encoding="utf-8") as f:
                    json.dump({{ if append_output }}json_tree{{ else }}_xml_to_dict(root){{ end }}, f, ensure_ascii=False, indent=2)
            else:
                tree = ET.ElementTree({{ if append_output }}_append_previous_xml(block["output_path"], root){{ else }}root{{ end }})
                _strip_illegal_xml_chars(tree.getroot())
                ET.indent(tree)
                tree.write(block["output_path"], encoding="utf-8", xml_declaration=True)
            count = len(root.findall(".//*"))
            print(f"Done — [{name}] {count} elements {{ if append_output }}appended to{{ else }}written to{{ end }} {block['output_path']}")
{{~ if hardening_any ~}}
            required_fields_failed = _report_required_fields_drops(block)
            block_failed = _run_hardening_checks(block, count, lambda field, root=root: [(el.text or "") for el in root.iter(field)]) or required_fields_failed
{{~ end ~}}

{{~ if change_detection_any ~}}
        if block["change_detection"]["enabled"]:
            with open(block["output_path"], "r", encoding="utf-8") as f:
                new_content = f.read()
            if previous_contents[name] is not None and previous_contents[name] != new_content:
                _notify_change(block, previous_contents[name], new_content)
{{~ end ~}}

{{~ if hardening_any ~}}
        if block["hardening"]["has_baseline"] and not block_failed:
            _write_baseline(block, count)
        hardening_failed = hardening_failed or block_failed
{{~ end ~}}

{{~ if hardening_any ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}
