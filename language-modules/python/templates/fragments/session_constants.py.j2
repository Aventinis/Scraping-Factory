{{~ if persistent_session_enabled ~}}
# Issue #175 (persistent session): on the first run (no saved session file
# yet), the full action sequence below — including any login Fill/Click
# steps — runs as normal, then the resulting cookies/localStorage are saved
# here. Every run after that skips straight past the login-only actions
# (Navigate always still runs) and reuses the saved session instead. The
# file is refreshed after every run, so a rotated/refreshed session token
# is still picked up for next time. If the session ever actually expires,
# there's no automatic fallback to a fresh login — delete this file to
# force one.
#
# WARNING: this file contains live session cookies, effectively login
# credentials for the site — treat it with the same care as a password,
# and never share or commit it.
SESSION_STATE_PATH = OUTPUT_PATH + ".session-state.json"
{{~ end ~}}
