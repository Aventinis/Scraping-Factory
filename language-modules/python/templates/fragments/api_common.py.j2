{{~ else ~}}
                response = requests.post(BOOTSTRAP["url"], **request_kwargs)
{{~ end ~}}
            elif BOOTSTRAP["bodyEncoding"] == "Form":
{{~ if request_delay.enabled ~}}
                _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
                response = _send_with_retry(lambda _u=BOOTSTRAP["url"]: requests.post(_u, data=body, **request_kwargs), _display_url(BOOTSTRAP["url"]))
{{~ else ~}}
                response = requests.post(BOOTSTRAP["url"], data=body, **request_kwargs)
{{~ end ~}}
            else:
{{~ if request_delay.enabled ~}}
                _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
                response = _send_with_retry(lambda _u=BOOTSTRAP["url"]: requests.post(_u, json=body, **request_kwargs), _display_url(BOOTSTRAP["url"]))
{{~ else ~}}
                response = requests.post(BOOTSTRAP["url"], json=body, **request_kwargs)
{{~ end ~}}
        else:
{{~ if request_delay.enabled ~}}
            _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
            response = _send_with_retry(lambda _u=BOOTSTRAP["url"]: requests.get(_u, **request_kwargs), _display_url(BOOTSTRAP["url"]))
{{~ else ~}}
            response = requests.get(BOOTSTRAP["url"], **request_kwargs)
{{~ end ~}}
    except requests.RequestException as e:
        _bootstrap_error(str(e))
    if not response.ok:
        _bootstrap_error(f"HTTP {response.status_code}.")
    try:
        data = response.json()
    except ValueError:
        _bootstrap_error("the response is not JSON.")
    value = _resolve_field(data, BOOTSTRAP["valuePath"])
    if value is None or isinstance(value, (dict, list)) or str(value) == "":
        _bootstrap_error(f"no value found at JSON path '{BOOTSTRAP['valuePath']}' in the response.")
    return {BOOTSTRAP["name"]: str(value)}


def _redact_bootstrap(text):
    for value in _BOOTSTRAP_VALUES.values():
        text = text.replace(quote(value, safe=""), "***").replace(value, "***")
    return text


