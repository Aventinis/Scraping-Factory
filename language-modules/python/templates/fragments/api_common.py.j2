# Decomposes an absolute URL (or a "{name}"-templated URL, read the same
# way — a placeholder is just another path-segment/query-value string as
# far as this is concerned) into origin/path-segments/query-params, the same
# shape parseUrlTemplateParts (popup/api-config.js) builds at configuration
# time.
def _parse_url_parts(url):
    parsed = urlsplit(url)
    path_segments = [seg for seg in parsed.path.split("/") if seg]
    query_params = parse_qsl(parsed.query, keep_blank_values=True)
    return f"{parsed.scheme}://{parsed.netloc}", path_segments, query_params


# Issue #216: runtime port of findUrlTemplateMatches (popup/api-config.js), both
# pinned to test-vectors/url-template.json —
# matches one captured request URL against UrlTemplate itself (not a
# separate pattern, see BrowserDiscoverySource's own doc comment): origin
# and path-segment count must match exactly, every literal path segment/
# query value must match exactly, every OTHER "{name}" placeholder is free
# to differ (it's resolved independently, by another parameter), and
# target_name's own placeholder is the one value actually harvested. Returns
# None for "not a match" (including a candidate_url that isn't even a
# parseable absolute URL — e.g. a data: URI some pages also trigger).
def _match_url_against_template(candidate_url, template, target_name):
    try:
        template_origin, template_path, template_query = _parse_url_parts(template)
        candidate_origin, candidate_path, candidate_query = _parse_url_parts(candidate_url)
    except ValueError:
        return None
    if candidate_origin != template_origin or len(candidate_path) != len(template_path):
        return None

    extracted = None
    for template_segment, candidate_segment in zip(template_path, candidate_path):
        placeholder = _URL_TEMPLATE_PLACEHOLDER_PATTERN.fullmatch(template_segment)
        if placeholder:
            if placeholder.group(1) == target_name:
                extracted = candidate_segment
            continue
        if template_segment != candidate_segment:
            return None

    if sorted(k for k, _ in template_query) != sorted(k for k, _ in candidate_query):
        return None
    candidate_query_values = dict(candidate_query)
    for key, value in template_query:
        placeholder = _URL_TEMPLATE_PLACEHOLDER_PATTERN.fullmatch(value)
        if placeholder:
            if placeholder.group(1) == target_name:
                extracted = candidate_query_values.get(key)
            continue
        if candidate_query_values.get(key) != value:
            return None

    return extracted


def _resolve_frame_locator(page, frame_path):
    scope = page
    for frame_selector in frame_path:
        scope = scope.frame_locator(frame_selector)
    return scope


def _resolve_locator(page, selector, frame_path):
    return _resolve_frame_locator(page, frame_path or []).locator(selector)


# Data-driven port of playwright_scroll_step.py.j2's own fragment — rendered
# there as literal code for the one, fixed-at-generate-time login action
# sequence; here, scroll is just one possible entry in a runtime-interpreted
# action list (see _run_browser_action), so it reads its own settings off
# `action` instead of Scriban template variables.
def _run_scroll_action(page, action):
    frame_path = action.get("framePath")
    container_selector = action.get("containerSelector")
    load_more_selector = action.get("loadMoreButtonSelector")
    # Issue #289: None (the default) keeps the original "jump straight to
    # the current bottom" behavior, correct for classic infinite-scroll
    # (new items simply append below the old ones). When set, each
    # iteration instead moves by exactly this many pixels — needed for a
    # site that only lazy-loads a section once it's actually scrolled
    # *through* (an IntersectionObserver per section), where jumping
    # straight to the bottom skips every section in between.
    step_px = action.get("scrollStepPx")
    prev_height = None
    for _ in range(action.get("maxIterations", 10)):
        if container_selector:
            script = f"el => el.scrollTop += {step_px}" if step_px else "el => el.scrollTop = el.scrollHeight"
            if frame_path:
                _resolve_locator(page, container_selector, frame_path).evaluate(script)
            else:
                page.eval_on_selector(container_selector, script)
        else:
            script = f"window.scrollBy(0, {step_px})" if step_px else "window.scrollTo(0, document.body.scrollHeight)"
            page.evaluate(script)

        if load_more_selector:
            if frame_path:
                button_locator = _resolve_locator(page, load_more_selector, frame_path)
                if button_locator.count() == 0:
                    break
                button_locator.click()
            else:
                button = page.query_selector(load_more_selector)
                if not button:
                    break
                button.click()
            page.wait_for_timeout(action.get("waitAfterMs", 1000))
            continue

        page.wait_for_timeout(action.get("waitAfterMs", 1000))
        # Issue #289: at_bottom defaults to True (a no-op for the stop
        # condition below) when step_px is unset — the original
        # "height == prev_height" signal alone is already correct there.
        # With step_px, that signal alone can trigger too early (a short
        # step can legitimately report the same height for several rounds
        # before genuinely reaching the bottom), so it's combined with
        # "have we actually reached the bottom yet".
        at_bottom = True
        if container_selector:
            if frame_path:
                container = _resolve_locator(page, container_selector, frame_path)
                height = container.evaluate("el => el.scrollHeight")
                if step_px:
                    at_bottom = container.evaluate("el => el.scrollTop + el.clientHeight >= el.scrollHeight - 1")
            else:
                height = page.eval_on_selector(container_selector, "el => el.scrollHeight")
                if step_px:
                    at_bottom = page.eval_on_selector(container_selector, "el => el.scrollTop + el.clientHeight >= el.scrollHeight - 1")
        else:
            height = page.evaluate("document.body.scrollHeight")
            if step_px:
                at_bottom = page.evaluate("window.scrollY + window.innerHeight >= document.body.scrollHeight - 1")
        if height == prev_height and at_bottom:
            break
        prev_height = height


# Generic dispatcher over one BrowserAction dict (see
# PythonApiConfigLiteral.RenderBrowserActions) — WaitFor/Fill/Click/Scroll,
# reused verbatim from BrowserDiscoverySource.Actions rather than needing
# their own per-kind generated code the way the top-level login action
# sequence gets (PythonPlaywrightCodeGenerator).
def _run_browser_action(page, action):
    kind = action["kind"]
    frame_path = action.get("framePath")
    if kind == "waitFor":
        _resolve_locator(page, action["selector"], frame_path).wait_for(timeout=action.get("timeoutMs", 5000))
    elif kind == "fill":
        _resolve_locator(page, action["selector"], frame_path).fill(_require_env(action["environmentVariableName"]))
    elif kind == "click":
        # Issue #267: "first" (default)/"last" click that match; "all" clicks
        # every match in document order, pausing waitAfterMs after each.
        click_target = action.get("target", "first")
        click_locator = _resolve_locator(page, action["selector"], frame_path)
        if click_target == "all":
            click_locator.first.wait_for()
            for click_index in range(click_locator.count()):
                click_locator.nth(click_index).click()
                page.wait_for_timeout(action.get("waitAfterMs", 250))
        elif click_target == "last":
            click_locator.last.click()
        else:
            click_locator.first.click()
    elif kind == "scroll":
        _run_scroll_action(page, action)


# Issue #216: opens DiscoveryUrl in a dedicated, throwaway Playwright
# session, runs the configured action sequence (if any), and harvests every
# distinct value matching target_name's own {placeholder} out of whatever
# requests fired along the way — see _match_url_against_template. headers
# reuses the main request's own resolved HEADERS (set via
# page.set_extra_http_headers), the same "discovery reuses the main
# request's auth" precedent DiscoverySource's own requests.get call already
# established. Issue #217: DiscoveryUrl may itself reference an
# earlier-declared parameter's own value via combo, substituted before
# navigating there.
def _resolve_browser_discovery(source, headers, target_name, combo):
    discovery_url = _substitute_known_parameters(source["discoveryUrl"], combo)
    captured_urls = []
    with sync_playwright() as p:
        browser = p.chromium.launch()
        page = browser.new_page()
        if headers:
            page.set_extra_http_headers(headers)
        page.on("request", lambda request: captured_urls.append(request.url))
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        _send_with_retry(lambda _u=discovery_url: page.goto(_u), _display_url(discovery_url))
{{~ else ~}}
        page.goto(discovery_url)
{{~ end ~}}
        for action in source["actions"]:
            _run_browser_action(page, action)
        browser.close()

    discovered = []
    seen = set()
    for url in captured_urls:
        value = _match_url_against_template(url, URL_TEMPLATE, target_name)
        if value and value not in seen:
            seen.add(value)
            discovered.append(value)
    return discovered
{{~ end ~}}


# Turns a failed request into one clean, actionable error line (and a
# dedicated exit code) instead of a raw requests traceback — a 401/403 in
# particular almost always means missing or wrong authentication, which the
# message says outright, together with what to configure.
EXIT_REQUEST_FAILED = 7


def _display_url(url):
{{~ if has_bootstrap ~}}
    return _redact_bootstrap(url)
{{~ else ~}}
    return url
{{~ end ~}}


def _request_failed(what, url, detail):
    print(f"ERROR: {what} to {_display_url(url)} failed: {detail}", file=sys.stderr)
    sys.exit(EXIT_REQUEST_FAILED)


def _http_error_detail(status_code):
    if status_code in (401, 403):
        reason = "Unauthorized" if status_code == 401 else "Forbidden"
{{~ if has_bootstrap ~}}
        placeholder = "{" + BOOTSTRAP["name"] + "}"
        return (f"HTTP {status_code} ({reason}). The API rejected the request even though a fresh "
                f"bootstrap value was fetched — check that a header (e.g. \"Authorization: Bearer {placeholder}\") "
                f"or the URL actually uses it, and that the bootstrap's JSON path points at the token.")
{{~ else ~}}
        return (f"HTTP {status_code} ({reason}). The API requires authentication that this configuration "
                f"doesn't send — adopt the recorded authentication header (e.g. Authorization) or enable the "
                f"auth bootstrap to fetch a fresh token before every run.")
{{~ end ~}}
    if status_code == 429:
        return "HTTP 429 (Too Many Requests). The API is rate-limiting this script — try again later."
    if status_code >= 500:
        return f"HTTP {status_code}. The API's server reported an error — this is usually temporary, try again later."
    return f"HTTP {status_code}."


def _checked_request(what, url, send):
    try:
        response = send()
    except requests.RequestException as e:
        _request_failed(what, url, f"could not reach the API ({e.__class__.__name__}).")
    return response


def _require_ok(what, url, response):
    if not response.ok:
        _request_failed(what, url, _http_error_detail(response.status_code))


def _json_or_fail(what, url, response):
    try:
        return response.json()
    except ValueError:
        _request_failed(what, url, f"the response is not JSON (Content-Type: {response.headers.get('Content-Type', 'unknown')}).")


