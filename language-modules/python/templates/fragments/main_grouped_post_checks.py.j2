{{~ if dedup.enabled ~}}
    # Issue #225: incremental mode writes a copy without the instances seen in
    # an earlier run; `root` itself (hardening, baseline count, the key
    # collection for the state file) stays the full tree.
    output_root = _tree_without_hidden_fields(_dedup_delta_tree(root))
    written_count = len(output_root.findall(".//*"))
{{~ else ~}}
    output_root = _tree_without_hidden_fields(root)
{{~ end ~}}
{{~ if output_is_json ~}}
{{~ if append_output ~}}
    json_tree = _append_previous_json_tree(OUTPUT_PATH, _xml_to_dict(output_root))
{{~ end ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump({{ if append_output }}json_tree{{ else }}_xml_to_dict(output_root){{ end }}, f, ensure_ascii=False, indent=2)
    count = len(root.findall(".//*"))
{{~ else ~}}
    tree = ET.ElementTree({{ if append_output }}_append_previous_xml(OUTPUT_PATH, output_root){{ else }}output_root{{ end }})
    _strip_illegal_xml_chars(tree.getroot())
    ET.indent(tree)
    tree.write(OUTPUT_PATH, encoding="utf-8", xml_declaration=True)
    count = len(root.findall(".//*"))
{{~ end ~}}
{{~ end ~}}
    print(f"Done — {{ if dedup.enabled }}{written_count}{{ else }}{count}{{ end }} {{ if blueprint_mapping_enabled }}row(s){{ else }}elements{{ end }} {{ if append_output }}appended to{{ else }}written to{{ end }} {OUTPUT_PATH}")
{{~ if dedup.enabled ~}}
    _dedup_report()
{{~ end ~}}
{{~ if change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(root) or _report_required_fields_drops()
{{~ if hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(count)
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
