{{~ if preflight.enabled ~}}
# Issue #219: a single cheap HEAD request against the primary start URL, run
# before the main extraction phase even starts (never via a live Playwright
# page — no browser session needs to launch at all if this skips the run) —
# a target that hasn't changed since the last successful run (same ETag/
# Last-Modified) or isn't reachable at all doesn't need the cost of a real
# scrape. Not every target reliably sends useful ETag/Last-Modified headers
# — when neither is present (or they differ from the stored value, or
# there's no stored value yet), the check can't tell "changed" from
# "unchanged" at all, so it conservatively falls through to a normal run
# rather than risk silently never updating stale data. Missing/corrupt
# sidecar (first run ever, or the file was deleted) is treated the same as
# "no previous state yet".
#@include preflight_state
    headers = {"User-Agent": "Mozilla/5.0 (compatible; ScrapingFactory/1.0; +https://github.com/Aventinis/Scraping-Factory)"}
{{~ if request_headers.enabled ~}}
    headers.update(EXTRA_HTTP_HEADERS)
    if _USER_AGENT:
        headers["User-Agent"] = _USER_AGENT
{{~ end ~}}
{{~ if robots_check.enabled ~}}
    if not _robots_gate(url):
        return "proceed", None, None
{{~ end ~}}
    try:
{{~ if proxy.enabled ~}}
        proxy = _next_proxy()
        proxies = {"http": proxy, "https": proxy} if proxy else None
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _send_with_retry(lambda _u=url: requests.head(_u, headers=headers, proxies=proxies, timeout=10, allow_redirects=True), url)
{{~ else ~}}
        response = requests.head(url, headers=headers, proxies=proxies, timeout=10, allow_redirects=True)
{{~ end ~}}
{{~ else ~}}
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _send_with_retry(lambda _u=url: requests.head(_u, headers=headers, timeout=10, allow_redirects=True), url)
{{~ else ~}}
        response = requests.head(url, headers=headers, timeout=10, allow_redirects=True)
{{~ end ~}}
{{~ end ~}}
#@include preflight_evaluate
{{~ end ~}}
