{{~ if request_delay.enabled ~}}
# Issue #222: optional pause between outbound requests — a minimum gap
# between the starts of two consecutive requests, drawn uniformly from
# [REQUEST_DELAY_MIN_S, REQUEST_DELAY_MAX_S] each time. Only the part of the
# pause that hasn't already elapsed (e.g. while parsing the previous page) is
# actually slept, and the very first request of a run starts immediately.
# Each pause is announced on stdout — so a long run visibly isn't hanging,
# and so the companion's trial run can tell waiting apart from a stuck
# script (PythonScriptVerifier extends its own deadline by exactly the
# announced pause).
import random
import time

REQUEST_DELAY_MIN_S = {{ request_delay.min_s_literal }}
REQUEST_DELAY_MAX_S = {{ request_delay.max_s_literal }}
_last_request_started_at = None


def _pace_request():
    global _last_request_started_at
    if _last_request_started_at is not None:
        remaining = random.uniform(REQUEST_DELAY_MIN_S, REQUEST_DELAY_MAX_S) - (time.monotonic() - _last_request_started_at)
        if remaining > 0:
            print(f"Pausing {remaining:.2f} s before the next request (request delay)...", flush=True)
            time.sleep(remaining)
    _last_request_started_at = time.monotonic()


{{~ end ~}}
