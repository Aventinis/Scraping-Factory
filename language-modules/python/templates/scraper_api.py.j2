            headers[header["name"]] = _URL_TEMPLATE_PLACEHOLDER_PATTERN.sub(
                lambda match: bootstrap_values.get(match.group(1), match.group(0)), header["template"])
            continue
{{~ end ~}}
        headers[header["name"]] = header["value"] if "value" in header else os.environ[header["envVar"]]
    return headers


