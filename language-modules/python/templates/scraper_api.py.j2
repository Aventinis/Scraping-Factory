# Discovery requests reuse the main HEADERS (e.g. an auth token) since a
# discovery endpoint is typically part of the same API as the main request.
# `combo` holds every earlier-declared parameter's own already-resolved
# value (Issue #217) — substituted into a discovery/browserDiscovery
# source's own template before it's used, so e.g. a category-scoped
# discovery endpoint resolves against this specific run's category.
def _resolve_parameter_values(source, headers, parameter_name, combo):
    kind = source["kind"]
    if kind == "staticList":
        return list(source["values"])
    if kind == "range":
        range_type = source["type"]
        if range_type == "IsoWeek":
            return _iso_week_range(source["from"], source["to"], source.get("format", _DEFAULT_ISO_WEEK_FORMAT))
        if range_type == "Date":
            return _date_range(source["from"], source["to"], source.get("format", _DEFAULT_DATE_FORMAT))
        return _number_range(source["from"], source["to"])
    if kind == "discovery":
        url_template = _substitute_known_parameters(source["urlTemplate"], combo)
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _checked_request("Discovery request", url_template, lambda: _send_with_retry(lambda _u=url_template: requests.get(_u, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10), _display_url(url_template)))
{{~ else ~}}
        response = _checked_request("Discovery request", url_template, lambda: requests.get(url_template, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10))
{{~ end ~}}
        _require_ok("Discovery request", url_template, response)
        items = _resolve_items(_json_or_fail("Discovery request", url_template, response), source["itemsPath"])
        return [str(_resolve_field(item, source["valuePath"])) for item in items]
    if kind == "browserDiscovery":
        return _resolve_browser_discovery(source, headers, parameter_name, combo)
    raise ValueError(f"Unknown parameter source: {kind}")


# Best-effort: every ApiParameterSource value is a plain string end to end
# (see _resolve_parameter_values above), so a body variable bound to a
# Number/Boolean parameter needs converting before it fits a strictly-typed
# request body (e.g. a GraphQL server rejecting a stringified number). An
# unparsable value falls back to the raw string rather than raising — a
# strictly-typed target server rejecting it is then a target-site problem
# this can only mitigate, not fully solve (see ApiBodyVariable.CoerceTo).
def _coerce_body_value(value, coerce_to):
    if coerce_to == "Number":
        try:
            return float(value) if "." in value else int(value)
        except ValueError:
            return value
    if coerce_to == "Boolean":
        return value.strip().lower() in ("true", "1", "yes")
    return value


# Renders BODY (Issue #55's request-body tree) into a plain JSON-able Python
# value for one already-resolved parameter combo — an object/array node just
# recurses over its own children, a variable node looks its current value up
# in combo (optionally coerced), and a literal node returns its fixed value
# (kind == "Null" is the one case with no "value" key to read at all, see
# PythonApiConfigLiteral.RenderBody).
def _render_body(node, combo):
    if node is None:
        return None
    if "properties" in node:
        return {key: _render_body(child, combo) for key, child in node["properties"].items()}
    if "items" in node:
        return [_render_body(item, combo) for item in node["items"]]
    if "parameterName" in node:
        return _coerce_body_value(combo[node["parameterName"]], node.get("coerceTo"))
    kind = node["kind"]
    return None if kind == "Null" else node["value"]


{{~ if embedded_json_source ~}}
# Issue #136: for sites that render their complete data into the initial
# page HTML and hydrate the DOM from it client-side (Next.js's
# __NEXT_DATA__, Nuxt's __NUXT__, a generic <script type="application/json">
# state blob, ...), no separate, capturable network request ever happens —
# the JSON is parsed straight out of one <script> tag in the page itself
# instead of out of response.json(). A missing tag or unparseable content is
# a hard failure (unlike a 404 response combination, there's no "this
# combination doesn't exist" fallback for a page that doesn't have the data
# it was expected to).
def _extract_embedded_json(response):
    soup = BeautifulSoup(response.text, "html.parser")
    script_tag = soup.select_one(EMBEDDED_JSON_SOURCE["scriptSelector"])
    if script_tag is None or not script_tag.string:
        raise RuntimeError(
            f"No <script> tag matching selector '{EMBEDDED_JSON_SOURCE['scriptSelector']}' with JSON content was found on {response.url}."
        )
    return json.loads(script_tag.string)
{{~ end ~}}


def _extract_row(record, combo):
    row = dict(combo)
    for field in FIELDS:
        # Issue #206 follow-up: a derived (combineFields/splitField) field
        # has no path of its own — _resolve_json_path("") would otherwise
        # resolve to the whole record rather than "nothing found", so this
        # is guarded explicitly. row already holds every earlier field's own
        # computed value by this point (FIELDS preserves declaration order),
        # which is what the transform chain's own sibling lookup reads.
        if not field["path"]:
            row[field["name"]] = _apply_transforms("", field["transform"], row)
            continue
        value = _resolve_field(record, field["path"])
        row[field["name"]] = "" if value is None else _apply_transforms(str(value), field["transform"], row)
    return row


