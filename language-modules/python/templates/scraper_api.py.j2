import requests
from urllib.parse import quote

URL_TEMPLATE = {{ url_template_literal }}
ITEMS_PATH = {{ items_path_literal }}
FIELDS = {{ fields_literal }}
PARAMETERS = {{ parameters_literal }}
HEADERS = {{ headers_literal }}

_PATH_TOKEN_PATTERN = re.compile(r"[^.\[\]]+|\[\*\]|\[\d+\]")


# Minimal JSON-path DSL: dot-notation for object keys, "[*]" to flatten into
# every element of an array, "[n]" for a specific index. Returns every match
# as a flat list — a bare key/index yields at most one, but "[*]" can yield
# several, which is what lets one path (e.g. "results[*].items") reach into
# more than one array at once.
def _resolve_json_path(data, path):
    values = [data]
    for token in _PATH_TOKEN_PATTERN.findall(path):
        next_values = []
        if token == "[*]":
            for value in values:
                if isinstance(value, list):
                    next_values.extend(value)
        elif token.startswith("["):
            index = int(token[1:-1])
            for value in values:
                if isinstance(value, list) and -len(value) <= index < len(value):
                    next_values.append(value[index])
        else:
            for value in values:
                if isinstance(value, dict) and token in value:
                    next_values.append(value[token])
        values = next_values
    return values


# ItemsPath is expected to resolve to "the list of records", however it gets
# there — a path ending on the list itself (values == [the_list]) and a path
# that already fans out via "[*]" (values == [list_a, list_b, ...]) both end
# up as one or more list matches, so flattening them one level always
# produces the intended flat record list either way.
def _resolve_items(data, path):
    values = _resolve_json_path(data, path)
    if values and all(isinstance(value, list) for value in values):
        return [item for sublist in values for item in sublist]
    return values


def _resolve_field(record, path):
    values = _resolve_json_path(record, path)
    return values[0] if values else None


def _parse_iso_week(value):
    if value == "today":
        year, week, _ = datetime.date.today().isocalendar()
        return year, week
    year_str, week_str = value.split("-W")
    return int(year_str), int(week_str)


def _iso_week_range(from_value, to_value):
    start_year, start_week = _parse_iso_week(from_value)
    end_year, end_week = _parse_iso_week(to_value)
    start_ordinal = datetime.date.fromisocalendar(start_year, start_week, 1).toordinal()
    end_ordinal = datetime.date.fromisocalendar(end_year, end_week, 1).toordinal()

    weeks = []
    ordinal = start_ordinal
    while ordinal <= end_ordinal:
        iso_year, iso_week, _ = datetime.date.fromordinal(ordinal).isocalendar()
        weeks.append(f"{iso_year}-W{iso_week:02d}")
        ordinal += 7
    return weeks


def _date_range(from_value, to_value):
    start = datetime.date.fromisoformat(from_value)
    end = datetime.date.today() if to_value == "today" else datetime.date.fromisoformat(to_value)

    dates = []
    current = start
    while current <= end:
        dates.append(current.isoformat())
        current += datetime.timedelta(days=1)
    return dates


def _number_range(from_value, to_value):
    return [str(n) for n in range(int(from_value), int(to_value) + 1)]


def _build_headers():
    headers = {}
    for header in HEADERS:
        headers[header["name"]] = header["value"] if "value" in header else os.environ[header["envVar"]]
    return headers


# Discovery requests reuse the main HEADERS (e.g. an auth token) since a
# discovery endpoint is typically part of the same API as the main request.
def _resolve_parameter_values(source, headers):
    kind = source["kind"]
    if kind == "staticList":
        return list(source["values"])
    if kind == "range":
        range_type = source["type"]
        if range_type == "IsoWeek":
            return _iso_week_range(source["from"], source["to"])
        if range_type == "Date":
            return _date_range(source["from"], source["to"])
        return _number_range(source["from"], source["to"])
    if kind == "discovery":
        response = requests.get(source["urlTemplate"], headers=headers, timeout=10)
        response.raise_for_status()
        items = _resolve_items(response.json(), source["itemsPath"])
        return [str(_resolve_field(item, source["valuePath"])) for item in items]
    raise ValueError(f"Unbekannte Parameter-Quelle: {kind}")


def _extract_row(record, combo):
    row = dict(combo)
    for field in FIELDS:
        value = _resolve_field(record, field["path"])
        row[field["name"]] = "" if value is None else value
    return row


def scrape():
    headers = _build_headers()
    parameter_names = [parameter["name"] for parameter in PARAMETERS]
    value_lists = [_resolve_parameter_values(parameter["source"], headers) for parameter in PARAMETERS]

    rows = []
    for combo_values in itertools.product(*value_lists):
        combo = dict(zip(parameter_names, combo_values))
        # Every parameter value is URL-encoded before being substituted into
        # UrlTemplate — values discovered at runtime (DiscoverySource) could
        # contain spaces or other characters that aren't valid unescaped in a
        # URL.
        encoded_combo = {name: quote(str(value), safe="") for name, value in combo.items()}
        url = URL_TEMPLATE.format(**encoded_combo)

        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()
        for record in _resolve_items(response.json(), ITEMS_PATH):
            rows.append(_extract_row(record, combo))
    return rows


def main():
    data = scrape()
    fieldnames = [parameter["name"] for parameter in PARAMETERS] + [field["name"] for field in FIELDS]
    with open("output.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(data)
    print(f"Done — {len(data)} rows written to output.csv")


if __name__ == "__main__":
    main()
