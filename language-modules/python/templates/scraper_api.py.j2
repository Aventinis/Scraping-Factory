def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(diff_text):
    host = os.environ[SMTP_HOST_ENV_VAR]
    port = int(os.environ[SMTP_PORT_ENV_VAR]) if SMTP_PORT_ENV_VAR else 587
    username = os.environ.get(SMTP_USERNAME_ENV_VAR) if SMTP_USERNAME_ENV_VAR else None
    password = os.environ.get(SMTP_PASSWORD_ENV_VAR) if SMTP_PASSWORD_ENV_VAR else None
    sender = os.environ[NOTIFY_EMAIL_FROM_ENV_VAR]
    recipient = os.environ[NOTIFY_EMAIL_TO_ENV_VAR]

    msg = MIMEText(diff_text)
    msg["Subject"] = "Scraping Factory: changes detected"
    msg["From"] = sender
    msg["To"] = recipient

    # EHLO first so has_extn() actually knows what the server advertises —
    # opportunistic STARTTLS (upgrade only if offered) works against both a
    # real provider and an unauthenticated local/internal relay that never
    # advertises it, without needing the caller to say which kind it is.
    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(diff_text):
    url = os.environ[WEBHOOK_URL_ENV_VAR]
    payload = json.dumps({"subject": "Scraping Factory: changes detected", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


# Best-effort: by the time this runs, the current run's own output has
# already been written successfully — a notification failure (unreachable
# SMTP host, webhook down, ...) is reported but never fails the overall run.
def _notify_change(old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if CHANGE_DETECTION_NOTIFY == "Email":
            _notify_email(diff_text)
        else:
            _notify_webhook(diff_text)
    except Exception as e:
        print(f"Warning: change notification failed: {e}")
{{~ end ~}}


def scrape():
{{~ if has_bootstrap ~}}
    _BOOTSTRAP_VALUES.update(_run_bootstrap())
    headers = _build_headers(_BOOTSTRAP_VALUES)
    combos = _resolve_parameter_combos(headers, _BOOTSTRAP_VALUES)
{{~ else ~}}
    headers = _build_headers()
    combos = _resolve_parameter_combos(headers)
{{~ end ~}}

    rows = []
    for combo in combos:
        # Every parameter value is URL-encoded before being substituted into
        # UrlTemplate — values discovered at runtime (DiscoverySource) could
        # contain spaces or other characters that aren't valid unescaped in a
        # URL.
        encoded_combo = {name: quote(str(value), safe="") for name, value in {{ if has_bootstrap }}{**_BOOTSTRAP_VALUES, **combo}{{ else }}combo{{ end }}.items()}
        url = URL_TEMPLATE.format(**encoded_combo)

        body = _render_body(BODY, {{ if has_bootstrap }}{**_BOOTSTRAP_VALUES, **combo}{{ else }}combo{{ end }})
        if METHOD == "POST":
            response = requests.post(url, headers=headers, json=body, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10)
        else:
            response = requests.get(url, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10)
        # A 404 is treated as "this combination doesn't exist" and skipped
        # rather than aborting the whole run — Api-Mode tries the full
        # cartesian product of every parameter's values without knowing
        # which combinations are actually valid on the target site (no way
        # to express e.g. "this category has no offers for that week"), so
        # hitting at least one missing combination is expected, not
        # exceptional. Every other error status still aborts immediately —
        # unlike a 404, those more likely mean something is actually wrong
        # (bad auth, server error), and silently skipping them could hide a
        # real problem behind an incomplete but "successful"-looking result.
        # If every combination fails (or nothing was ever valid), the
        # existing "at least one output row" check in PythonScriptVerifier
        # still catches that — this doesn't need to track failures itself.
        if response.status_code == 404:
            print(f"Skipped (404 Not Found): {{ if has_bootstrap }}{_redact_bootstrap(url)}{{ else }}{url}{{ end }}")
            continue
        response.raise_for_status()
{{~ if hardening.enabled ~}}
        _BLOCKING_RESPONSES.append({"url": {{ if has_bootstrap }}_redact_bootstrap(url){{ else }}url{{ end }}, "final_url": {{ if has_bootstrap }}_redact_bootstrap(response.url){{ else }}response.url{{ end }}, "length": len(response.content), "text": response.text})
{{~ end ~}}
{{~ if embedded_json_source ~}}
        data = _extract_embedded_json(response)
{{~ else ~}}
        data = response.json()
{{~ end ~}}
        for record in _resolve_items(data, ITEMS_PATH):
            rows.append(_extract_row(record, combo))
    return rows


def main():
{{~ if change_detection.enabled ~}}
    previous_content = _read_previous_output(OUTPUT_PATH)
{{~ end ~}}
    data = scrape()
{{~ if hardening.enabled ~}}
    data, required_fields_failed = _filter_required_fields(data)
{{~ end ~}}
    # Issue #191: a no-op remap (output_rows is just `data`, fieldnames are
    # the usual parameter+field columns) when no Output Blueprint is set —
    # `data` itself stays keyed by the original field/parameter names
    # throughout either way, since hardening below still needs to look
    # fields up by those original names.
    if BLUEPRINT_MAPPING:
        output_rows = [{m["target"]: row.get(m["source"], "") for m in BLUEPRINT_MAPPING} for row in data]
    else:
        # Issue #206 follow-up: see scraper.py.j2's own identical comment —
        # a HiddenFromOutput field is dropped from the write-time projection
        # only, never from `data` itself.
        output_rows = [{k: v for k, v in row.items() if k not in HIDDEN_FIELD_NAMES} for row in data] if HIDDEN_FIELD_NAMES else data
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(output_rows, f, ensure_ascii=False, indent=2)
{{~ else ~}}
    if BLUEPRINT_MAPPING:
        fieldnames = [m["target"] for m in BLUEPRINT_MAPPING]
    else:
        fieldnames = [parameter["name"] for parameter in PARAMETERS] + [
            field["name"] for field in FIELDS if field["name"] not in HIDDEN_FIELD_NAMES
        ]
    with open(OUTPUT_PATH, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(output_rows)
{{~ end ~}}
    print(f"Done — {len(data)} rows written to {OUTPUT_PATH}")
{{~ if change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(data) or required_fields_failed
{{~ if hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(len(data))
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
