# Issue #224: cursor/token-based pagination. Unlike a RangeSource/
# DiscoverySource parameter (a value list resolved up front), the next page's
# cursor is only revealed by the current page's own response, so each
# parameter combination runs its own sequential chain: page 1 is sent exactly
# as configured, every further page carries the cursor the page before it
# returned — as a query parameter, or at a dot-separated path within the
# request body. The chain ends when no cursor is returned, the optional
# "has next page" flag is falsy, a cursor repeats (an API that keeps handing
# back the same one would otherwise loop forever), or CURSOR_PAGINATION's
# maxPages safety cap is reached.
CURSOR_PAGINATION = {{ cursor_pagination_literal }}


def _with_query_param(url, name, value):
    # Replaces (or appends) one query parameter without re-encoding any of
    # the others — they stay byte-for-byte what UrlTemplate produced.
    base, separator, query = url.partition("?")
    fragment = ""
    if "#" in query:
        query, _, fragment = query.partition("#")
        fragment = "#" + fragment
    elif "#" in base:
        base, _, fragment = base.partition("#")
        fragment = "#" + fragment
    pairs = [pair for pair in query.split("&") if pair and pair.partition("=")[0] != name]
    pairs.append(f"{name}={quote(str(value), safe='')}")
    return f"{base}?{'&'.join(pairs)}{fragment}"


def _set_body_path(body, path, value):
    # Sets one value at a dot-separated object path of the already-rendered
    # request body (e.g. "variables.after" for a GraphQL query), creating
    # missing intermediate objects.
    if not isinstance(body, dict):
        raise RuntimeError("Cursor pagination needs a JSON object as the request body.")
    node = body
    *parents, last = path.split(".")
    for key in parents:
        child = node.get(key)
        if not isinstance(child, dict):
            child = {}
            node[key] = child
        node = child
    node[last] = value


def _apply_cursor(url, body, cursor):
    if CURSOR_PAGINATION["target"] == "Body":
        page_body = copy.deepcopy(body)
        _set_body_path(page_body, CURSOR_PAGINATION["bodyPath"], cursor)
        return url, page_body
    return _with_query_param(url, CURSOR_PAGINATION["queryParameterName"], cursor), body


def _next_cursor(data):
    # None = this was the last page.
    has_next_path = CURSOR_PAGINATION["hasNextPagePath"]
    if has_next_path is not None:
        flag = _resolve_field(data, has_next_path)
        if flag is None or flag is False or str(flag).strip().lower() in ("", "false", "0"):
            return None
    cursor = _resolve_field(data, CURSOR_PAGINATION["nextCursorPath"])
    if cursor is None or isinstance(cursor, (dict, list)) or str(cursor) == "":
        return None
    return cursor


{{~ end ~}}


# Sends ONE request (page) and returns its parsed JSON, or None when the
# endpoint answers 404 (see below). Factored out of scrape() (Issue #224) so
# the same code serves a plain single request and every page of a cursor
# chain.
def _fetch_page_data(url, body, headers):
    if METHOD == "POST":
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _checked_request("Request", url, lambda: _send_with_retry(lambda _u=url: requests.post(_u, headers=headers, json=body, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10), _display_url(url)))
{{~ else ~}}
        response = _checked_request("Request", url, lambda: requests.post(url, headers=headers, json=body, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10))
{{~ end ~}}
    else:
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _checked_request("Request", url, lambda: _send_with_retry(lambda _u=url: requests.get(_u, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10), _display_url(url)))
{{~ else ~}}
        response = _checked_request("Request", url, lambda: requests.get(url, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10))
{{~ end ~}}
    # A 404 is treated as "this combination doesn't exist" and skipped
    # rather than aborting the whole run — Api-Mode tries the full
    # cartesian product of every parameter's values without knowing
    # which combinations are actually valid on the target site (no way
    # to express e.g. "this category has no offers for that week"), so
    # hitting at least one missing combination is expected, not
    # exceptional. Every other error status still aborts immediately —
    # unlike a 404, those more likely mean something is actually wrong
    # (bad auth, server error), and silently skipping them could hide a
    # real problem behind an incomplete but "successful"-looking result.
    # If every combination fails (or nothing was ever valid), the
    # existing "at least one output row" check in PythonScriptVerifier
    # still catches that — this doesn't need to track failures itself.
    if response.status_code == 404:
        print(f"Skipped (404 Not Found): {{ if has_bootstrap }}{_redact_bootstrap(url)}{{ else }}{url}{{ end }}")
        return None
    _require_ok("Request", url, response)
{{~ if hardening.enabled ~}}
    _BLOCKING_RESPONSES.append({"url": {{ if has_bootstrap }}_redact_bootstrap(url){{ else }}url{{ end }}, "final_url": {{ if has_bootstrap }}_redact_bootstrap(response.url){{ else }}response.url{{ end }}, "length": len(response.content), "text": response.text})
{{~ end ~}}
{{~ if embedded_json_source ~}}
    data = _extract_embedded_json(response)
{{~ else ~}}
    data = _json_or_fail("Request", url, response)
{{~ end ~}}
    return data


{{~ if cursor_pagination_enabled ~}}
def _fetch_pages(url, body, headers):
    cursor = None
    seen_cursors = set()
    for page_number in range(1, CURSOR_PAGINATION["maxPages"] + 1):
        page_url, page_body = (url, body) if cursor is None else _apply_cursor(url, body, cursor)
        data = _fetch_page_data(page_url, page_body, headers)
        if data is None:
            # A 404 on page 1 means "this combination doesn't exist"; on a
            # later page it simply ends the chain.
            return
        yield data
        cursor = _next_cursor(data)
        if cursor is None:
            return
        if str(cursor) in seen_cursors:
            print(f"WARNING: cursor '{cursor}' was returned twice - stopping pagination to avoid an endless loop.", file=sys.stderr)
            return
        seen_cursors.add(str(cursor))
    print(f"Stopped after {CURSOR_PAGINATION['maxPages']} page(s) (maxPages) although the API reported more.")
{{~ else ~}}
def _fetch_pages(url, body, headers):
    data = _fetch_page_data(url, body, headers)
    if data is not None:
        yield data
{{~ end ~}}


def scrape():
{{~ if has_bootstrap ~}}
    _BOOTSTRAP_VALUES.update(_run_bootstrap())
    headers = _build_headers(_BOOTSTRAP_VALUES)
    combos = _resolve_parameter_combos(headers, _BOOTSTRAP_VALUES)
{{~ else ~}}
    headers = _build_headers()
    combos = _resolve_parameter_combos(headers)
{{~ end ~}}

    rows = []
    for combo in combos:
        # Every parameter value is URL-encoded before being substituted into
        # UrlTemplate — values discovered at runtime (DiscoverySource) could
        # contain spaces or other characters that aren't valid unescaped in a
        # URL.
        encoded_combo = {name: quote(str(value), safe="") for name, value in {{ if has_bootstrap }}{**_BOOTSTRAP_VALUES, **combo}{{ else }}combo{{ end }}.items()}
        url = URL_TEMPLATE.format(**encoded_combo)

        body = _render_body(BODY, {{ if has_bootstrap }}{**_BOOTSTRAP_VALUES, **combo}{{ else }}combo{{ end }})
        for data in _fetch_pages(url, body, headers):
            for record in _resolve_items(data, ITEMS_PATH):
                rows.append(_extract_row(record, combo))
    return rows


