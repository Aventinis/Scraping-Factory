{{~ else ~}}
                response = requests.post(BOOTSTRAP["url"], json=body, **request_kwargs)
{{~ end ~}}
        else:
{{~ if request_delay.enabled ~}}
            _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
            response = _send_with_retry(lambda _u=BOOTSTRAP["url"]: requests.get(_u, **request_kwargs), _display_url(BOOTSTRAP["url"]))
{{~ else ~}}
            response = requests.get(BOOTSTRAP["url"], **request_kwargs)
