def _extract_row(record, combo):
    row = dict(combo)
    for field in FIELDS:
        # Issue #206 follow-up: a derived (combineFields/splitField) field
        # has no path of its own — _resolve_json_path("") would otherwise
        # resolve to the whole record rather than "nothing found", so this
        # is guarded explicitly. row already holds every earlier field's own
        # computed value by this point (FIELDS preserves declaration order),
        # which is what the transform chain's own sibling lookup reads.
        if not field["path"]:
            row[field["name"]] = _apply_transforms("", field["transform"], row)
            continue
        value = _resolve_field(record, field["path"])
        row[field["name"]] = "" if value is None else _apply_transforms(str(value), field["transform"], row)
    return row


