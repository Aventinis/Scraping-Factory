# Issue #220: a short-lived credential (bearer token, signed URL parameter,
# nonce, ...) fetched fresh at the start of every run from a separate
# bootstrap/login request, instead of being pasted in as a static literal
# that eventually expires. Fetched once per script execution — a token that
# expires mid-run (a very long multi-parameter run) isn't refreshed.
# Credentials in the bootstrap request's own body/headers are read from
# environment variables via _require_env, never written into this script.
# The fetched value itself is never printed: _redact_bootstrap() masks it in
# every URL this script prints (e.g. a "Skipped (404 Not Found)" line).
BOOTSTRAP = {{ bootstrap_literal }}
EXIT_BOOTSTRAP_FAILED = 6
_BOOTSTRAP_VALUES = {}


def _bootstrap_error(message):
    print(f"ERROR: bootstrap request to {BOOTSTRAP['url']} failed: {message}", file=sys.stderr)
    sys.exit(EXIT_BOOTSTRAP_FAILED)


def _resolve_bootstrap_pairs(entries):
