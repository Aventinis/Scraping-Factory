_EXTERNAL_CONFIG_STATIC_LIST_PARAMS = {p["name"] for p in PARAMETERS if p["source"]["kind"] == "staticList"}


def _external_config_error(message):
    print(f"ERROR: The external config file '{EXTERNAL_CONFIG_PATH}' {message}", file=sys.stderr)
    sys.exit(EXIT_EXTERNAL_CONFIG_INVALID)


def _write_default_external_config():
    root = ET.Element("ScrapingFactoryConfig")
    ET.SubElement(root, "OutputFileName").text = "{{ output_filename }}"
    params_el = ET.SubElement(root, "ApiParameters")
    for p in PARAMETERS:
        if p["source"]["kind"] != "staticList":
            continue
        param_el = ET.SubElement(params_el, "Parameter")
        param_el.set("name", p["name"])
        for value in p["source"]["values"]:
            ET.SubElement(param_el, "Value").text = value
    try:
        tree = ET.ElementTree(root)
        ET.indent(tree)
        tree.write(EXTERNAL_CONFIG_PATH, encoding="utf-8", xml_declaration=True)
    except OSError as e:
        print(f"Warning: could not create default external config file '{EXTERNAL_CONFIG_PATH}': {e}", file=sys.stderr)


def _load_external_config():
    if not os.path.exists(EXTERNAL_CONFIG_PATH):
        _write_default_external_config()
        return {}
    try:
        root = ET.parse(EXTERNAL_CONFIG_PATH).getroot()
    except ET.ParseError as e:
        _external_config_error(f"is not valid XML: {e}")
    if root.tag != "ScrapingFactoryConfig":
        _external_config_error(f"has an unexpected root element '<{root.tag}>' (expected '<ScrapingFactoryConfig>').")

    result = {}

    output_el = root.find("OutputFileName")
    if output_el is not None:
        name = (output_el.text or "").strip()
        if not name:
            _external_config_error("has an empty <OutputFileName> element.")
        result["output_file_name"] = name

    param_values = {}
    for param_el in root.findall("./ApiParameters/Parameter"):
        name = param_el.get("name")
        if not name:
            _external_config_error("has a <Parameter> element missing its required 'name' attribute.")
        if name not in _EXTERNAL_CONFIG_STATIC_LIST_PARAMS:
            _external_config_error(
                f"has a <Parameter name=\"{name}\"> that doesn't match any known fixed-value-list "
                "parameter — was the scraper regenerated since this file was created?"
            )
        values = [(v.text or "").strip() for v in param_el.findall("Value")]
        values = [v for v in values if v]
        if not values:
            _external_config_error(f"has a <Parameter name=\"{name}\"> with no non-empty <Value> entries.")
        param_values[name] = values
    result["api_parameter_values"] = param_values

    return result


_EXTERNAL_CONFIG = _load_external_config()
if _EXTERNAL_CONFIG.get("output_file_name"):
