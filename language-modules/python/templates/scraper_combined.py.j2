# Generated by Scraping Factory
# Mode:   Combined ({{ component_count }} component(s), each its own independent scrape)
# Components: {{ for c in components }}{{ c.name_literal }}{{ if !for.last }}, {{ end }}{{ end }}
# Run:    python {{ script_filename }}.py
#
# Each component below is a complete, independent scraper (its own URL,
# engine, browser actions, proxy, hardening, etc.) generated exactly as if it
# had been downloaded on its own — this script just runs every one of them in
# turn and merges their results into one combined {{ output_filename }}.json,
# keyed by each component's own name.
#
# Every component runs inside its own subdirectory next to this script
# (not a temporary one) so that features relying on state between separate
# runs — a saved login session, an editable config file, the "compare to
# last run" hardening check — keep working exactly as they would if that
# component were run standalone.

import base64
import json
import os
import subprocess
import sys

COMPONENTS = [
{{~ for c in components ~}}
    {"name": {{ c.name_literal }}, "source_b64": {{ c.source_b64_literal }}},
{{~ end ~}}
]

OUTPUT_PATH = "{{ output_filename }}.json"

# A component exiting with one of these codes still produced valid output —
# see PythonScriptVerifier.MissingEnvVarExitCode/HardeningFailedExitCode on
# the companion side, which these three literals must be kept in sync with:
#   0  = ordinary success
#   78 = EXIT_MISSING_ENV_VAR (a Proxy/login env var wasn't set — the
#        component still ran, just without that feature)
#   2  = EXIT_HARDENING_FAILED (a hardening check flagged the result, but the
#        component's own output was still written)
# Any other exit code means the component produced no reliable output at all.
COMPATIBLE_EXIT_CODES = (0, 78, 2)


def _component_dir(name):
    # A fixed subdirectory next to this script's own file, not
    # tempfile.TemporaryDirectory() — sidecar files a component itself
    # writes (a saved login session, an editable *.config.xml, the
    # hardening baseline count) must persist across separate runs of this
    # combined script, exactly as they would for that component run alone.
    base_dir = os.path.dirname(os.path.abspath(__file__))
    component_dir = os.path.join(base_dir, "{{ output_filename }}_components", name)
    os.makedirs(component_dir, exist_ok=True)
    return component_dir


def _run_component(component):
    component_dir = _component_dir(component["name"])
    script_path = os.path.join(component_dir, "component.py")
    source = base64.b64decode(component["source_b64"]).decode("utf-8")
    with open(script_path, "w", encoding="utf-8") as f:
        f.write(source)

    # No explicit env= here: the child process inherits this script's own
    # environment, which is how proxy/login environment variables reach each
    # component without any per-component wiring in this wrapper.
    result = subprocess.run(
        [sys.executable, "component.py"], cwd=component_dir, capture_output=True, text=True,
    )
    if result.returncode not in COMPATIBLE_EXIT_CODES:
        raise RuntimeError(
            f"Component '{component['name']}' failed (exit code {result.returncode}):\n{result.stderr}"
        )
    if result.returncode != 0:
        print(
            f"WARNING: component '{component['name']}' exited with code {result.returncode} "
            "(still usable, see stderr below):\n" + result.stderr,
            file=sys.stderr,
        )

    output_path = os.path.join(component_dir, "output.json")
    if not os.path.exists(output_path):
        raise RuntimeError(f"Component '{component['name']}' produced no output.json.")
    with open(output_path, encoding="utf-8") as f:
        return json.load(f)


def main():
    merged = {}
    for component in COMPONENTS:
        print(f"Running component '{component['name']}'...")
        merged[component["name"]] = _run_component(component)

    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(merged, f, ensure_ascii=False, indent=2)
    print(f"Wrote {OUTPUT_PATH}")


if __name__ == "__main__":
    main()
