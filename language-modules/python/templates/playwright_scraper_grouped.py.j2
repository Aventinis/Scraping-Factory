# A FillStep's credential or Proxy's URL list must come from an environment
# variable that's actually set — this distinguishes "expected configuration
# gap" from an arbitrary script bug via a dedicated exit code instead of a
# raw, unhandled KeyError traceback.
EXIT_MISSING_ENV_VAR = 78


def _require_env(name):
    value = os.environ.get(name)
    if value is None:
        print(f"Error: required environment variable '{name}' is not set.", file=sys.stderr)
        sys.exit(EXIT_MISSING_ENV_VAR)
    return value
{{~ end ~}}

{{~ if proxy.enabled ~}}
# Issue #88 (proxy support): PROXY_ENV_VAR is an environment-variable
# *name* holding a comma-separated list of proxy URLs — never a literal
# proxy address baked into the script, same as FillStep credentials. If
# more than one is present, browser launches rotate through them
# round-robin. A missing (not just empty) env var doesn't abort the run —
# it's treated as "no proxy configured", with a warning printed and the
# run flagged via EXIT_MISSING_ENV_VAR at the very end, once the script has
# otherwise completed successfully.
PROXY_ENV_VAR = {{ proxy.env_var_literal }}
_PROXY_ENV_VALUE = os.environ.get(PROXY_ENV_VAR)
_PROXY_ENV_MISSING = _PROXY_ENV_VALUE is None
if _PROXY_ENV_MISSING:
    print(f"Warning: environment variable '{PROXY_ENV_VAR}' is not set — connecting without a proxy.", file=sys.stderr)
_PROXY_LIST = [p.strip() for p in (_PROXY_ENV_VALUE or "").split(",") if p.strip()]
_proxy_cycle = itertools.cycle(_PROXY_LIST) if _PROXY_LIST else None


def _next_proxy():
    return next(_proxy_cycle) if _proxy_cycle else None


def _next_playwright_proxy():
    proxy = _next_proxy()
    if not proxy:
        return None
    parsed = urllib.parse.urlsplit(proxy)
    server = f"{parsed.scheme}://{parsed.hostname}"
    if parsed.port:
        server += f":{parsed.port}"
    result = {"server": server}
    if parsed.username:
        result["username"] = parsed.username
    if parsed.password:
        result["password"] = parsed.password
    return result
{{~ end ~}}

{{~ if hardening.enabled ~}}
# Issue #129 (script hardening): each configured check independently prints
# a warning (script still exits 0) or an error (script exits
# EXIT_HARDENING_FAILED) once scraping is done — lets a script re-run later
# (e.g. via cron, weeks after generation) detect that it silently stopped
# finding anything, instead of writing an empty output file and exiting 0
# as if nothing were wrong.
EXIT_HARDENING_FAILED = 2

HARDENING = {{ hardening.checks_literal }}

# Issue #132 (blocking-detection check): a snapshot of each URL's rendered
# page (final URL, content length, content) is captured in scrape() below,
# right after all browser actions complete — the page actually about to be
# scraped, not an intermediate redirect a login flow legitimately passes
# through. Populated even when no "blocking" check is configured; the
# runtime cost of appending an already-in-memory string is negligible.
_BLOCKING_RESPONSES = []

# Issue #133 (required-fields check, container mode): matched globally by
# tag name anywhere in the built tree (same convention the nullRate check
# already established for this exact ambiguity) — REQUIRED_FIELD_NAMES is
# the plain list of names to check, empty when no "requiredFields" check is
# configured, in which case extract_group()'s own call site below is a
# guaranteed no-op.
_REQUIRED_FIELDS_CHECK = next((c for c in HARDENING if c["kind"] == "requiredFields"), None)
REQUIRED_FIELD_NAMES = _REQUIRED_FIELDS_CHECK["fieldNames"] if _REQUIRED_FIELDS_CHECK else []
_required_fields_dropped_count = 0


# Called from extract_group() right after a *repeating* group's one
# instance is fully built (never for a non-repeating group, which has no
# "instance" to drop) — checks whether any required field anywhere in this
# instance's own subtree is empty, dropping the whole instance if so.
# extract_group() already recurses bottom-up, so this naturally drops the
# nearest enclosing repeating instance, whichever nesting level actually
# contains the problem — an inner repeating group's own bad instance is
# dropped without disturbing its outer container. A required field name
# matching nothing in this subtree is a silent no-op (typo/renamed field),
# the same "skip rather than error" convention the nullRate check's own
# zero-match case already uses.
def _passes_required_fields(el):
    global _required_fields_dropped_count
    for name in REQUIRED_FIELD_NAMES:
        for match in el.iter(name):
            if not (match.text or "").strip():
                _required_fields_dropped_count += 1
                return False
    return True


# Unlike flat mode's "N of M rows" message, dropping can happen at more
# than one nesting level in one run, so there's no single well-defined "of
# M" denominator here — a plain count is reported instead.
def _report_required_fields_drops():
    if _REQUIRED_FIELDS_CHECK is None or _required_fields_dropped_count == 0:
        return False
    message = f"Dropped {_required_fields_dropped_count} element(s) missing a required field."
    if _REQUIRED_FIELDS_CHECK["severity"] == "Error":
        print(f"ERROR: {message}", file=sys.stderr)
        return True
    print(f"WARNING: {message}", file=sys.stderr)
    return False

{{~ if hardening.has_baseline ~}}
# Issue #131 (baseline check): a small sidecar file next to the script's own
# output records the result count from the last run that passed cleanly
# (see main()'s own "only write when not hardening_failed" call site) — a
# bad run must never become the new normal for the next comparison. Missing/
# corrupt sidecar (first run ever, or the file was deleted) is treated the
# same as "no baseline yet", not an error.
BASELINE_PATH = OUTPUT_PATH + ".hardening-baseline.json"


def _read_baseline():
    try:
        with open(BASELINE_PATH, "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(count):
    with open(BASELINE_PATH, "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)
{{~ end ~}}


def _run_hardening_checks(root):
    has_error = False
    result_count = len(root.findall(".//*"))
    for check in HARDENING:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = "No data was extracted — at least one selector likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            # Issue #130: matched globally by tag name across the whole
            # output tree, not scoped to whichever parent group the field is
            # nested under (see NullRateCheck's own doc comment) — catches a
            # field whose selector quietly starts matching the wrong thing
            # (still returns a value, always empty) even though the overall
            # element count stays healthy.
            field = check["field"]
            elements = list(root.iter(check["field"]))
            total = len(elements)
            if total == 0:
                continue
            empty = sum(1 for el in elements if not (el.text or "").strip())
            rate = empty / total
            if rate > check["threshold"]:
                message = f"Field '{field}': {rate:.0%} of occurrences are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            # Issue #131: catches a gradual drop in result volume that
            # neither noResult (only fires at exactly zero) nor nullRate
            # (only watches one field) would ever trip — e.g. a paginated
            # list quietly losing entries. No baseline yet (first run, or
            # the sidecar file was deleted) simply has nothing to compare
            # against.
            baseline = _read_baseline()
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "blocking":
            # Issue #132: three signals, all evaluated per captured response
            # — a redirect to a different host (always checked), a body
            # shorter than minBodyLength (skipped when None), and a
            # case-insensitive match against blockPhrases.
            for entry in _BLOCKING_RESPONSES:
                reasons = []
                if urllib.parse.urlsplit(entry["url"]).netloc != urllib.parse.urlsplit(entry["final_url"]).netloc:
                    reasons.append(f"redirected to a different host ({entry['final_url']})")
                if check["minBodyLength"] is not None and entry["length"] < check["minBodyLength"]:
                    reasons.append(f"response body is only {entry['length']} bytes (minimum: {check['minBodyLength']})")
                matched_phrases = [p for p in check["blockPhrases"] if p.lower() in entry["text"].lower()]
                if matched_phrases:
                    reasons.append(f"matched block phrase(s): {', '.join(matched_phrases)}")
                if reasons:
                    message = f"Possible blocking detected for {entry['url']}: {'; '.join(reasons)}."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error
{{~ end ~}}

GROUPS = {{ groups_literal }}


# Issue #84: best-effort numeric normalization for a "toNumber" transform —
# finds the first numeric-looking substring and normalizes its decimal
# separator to '.', stripping thousands separators/currency symbols. When
# both '.' and ',' appear, the rightmost one is treated as the decimal point
# (handles both "1.234,56" and "1,234.56"); a single separator appearing more
# than once is treated as a thousands separator and stripped; a single
# separator appearing exactly once is treated as the decimal point (so
# "12,99"/"12.99" both work, at the cost of a genuinely ambiguous
# single-occurrence case like "1.234" always being read as 1.234, never as
# 1234 — chain a regex-extract transform first if that's not what's wanted).
# Empty string if nothing numeric is found.
def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Applies a field's ordered transform chain (node["transform"], built by
# PythonFieldTransformLiteral) — each step's output feeds the next step's
# input, in the order the user configured them in. Not called for
# node["mode"] == "exists" — see extract_group below.
def _apply_transforms(value, transforms):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
    return value


# A node's own "frame_path" (Issue #42, Phase 3) is always resolved fresh
# from `page` — an absolute top-to-target chain, independent of how deeply
# nested the node is in the tree or whether any ancestor also has a
# frame_path. Locator (what a FrameLocator chain returns) has no
# query_selector/query_selector_all of its own, only ElementHandle does — so
# a resolved group match is converted via .element_handle() right away,
# letting every recursive call below keep using query_selector/
# query_selector_all exactly as before this existed, regardless of whether
# *this* node was framed.
def _resolve_frame_locator(page, frame_path):
    scope = page
    for frame_selector in frame_path:
        scope = scope.frame_locator(frame_selector)
    return scope


# Used by the WaitFor/Fill/Click/Scroll action fragments rendered into the
# scrape() body below (one per playwright_*_step.py.j2 template) — same
# helper as playwright_scraper.py.j2's, duplicated rather than shared since
# the two shell templates don't share any Python source, only the same
# Scriban fragment templates rendered into both.
def _resolve_locator(page, selector, frame_path):
    return _resolve_frame_locator(page, frame_path or []).locator(selector)


def _resolve_group_matches(page, scope, node):
    frame_path = node.get("frame_path")
    if not frame_path:
        if node["repeating"]:
            return scope.query_selector_all(node["selector"])
        found = scope.query_selector(node["selector"])
        return [found] if found else []

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    if node["repeating"]:
        return [item.element_handle() for item in locator.all()]
    return [locator.first.element_handle()] if locator.count() > 0 else []


def _resolve_field_match(page, scope, node):
    frame_path = node.get("frame_path")
    if not frame_path:
        return scope.query_selector(node["selector"])

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    return locator.first if locator.count() > 0 else None


# Same tree walk as the Static engine's scraper_grouped.py.j2 — only the two
# DOM-access calls differ (query_selector_all/query_selector here vs.
# select/select_one there), the recursive group/data-field logic is
# identical. `page` is threaded through explicitly (rather than relying on
# closure capture) purely so frame_path resolution — always relative to the
# top-level page, never to `scope` — has something to resolve from
# regardless of how deep the current recursion already is.
def extract_group(page, scope, node):
    if "children" in node:
        matches = _resolve_group_matches(page, scope, node)

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            for child in node["children"]:
                result = extract_group(page, match, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
{{~ if hardening.enabled ~}}
            if node["repeating"] and not _passes_required_fields(el):
                continue
{{~ end ~}}
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    found = _resolve_field_match(page, scope, node)
    if node["mode"] == "exists":
        el.text = "true" if found else "false"
    elif found is None:
        el.text = ""
    elif node["mode"] == "attribute":
        el.text = _apply_transforms(found.get_attribute(node["attribute"]) or "", node["transform"])
    elif node["mode"] == "ownText":
        # Direct text-node children only, excluding any nested element's own
        # text — see scraper_grouped.py.j2's own doc comment on this same
        # branch for the "why" (a badge inside a name heading, etc.).
        # ElementHandle has no built-in "own text" accessor, unlike
        # BeautifulSoup's .contents, so this needs a small evaluate() call.
        own_text = found.evaluate(
            "el => Array.from(el.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join('')"
        ).strip()
        el.text = _apply_transforms(own_text, node["transform"])
    else:
        el.text = _apply_transforms((found.text_content() or "").strip(), node["transform"])
    return el


{{~ if output_is_json ~}}
# Converts the group tree (already extracted into ET.Element form by
# extract_group above) into nested dicts/lists for JSON output — reusing the
# same extraction walk instead of a second, JSON-specific one. A tag that
# occurs more than once among one element's children — several matches of a
# repeating group, or same-named sibling fields/groups, which Container-Mode
# explicitly allows — becomes a JSON list; a tag occurring exactly once stays
# a plain nested value.
def _xml_to_dict(element):
    children = list(element)
    if not children:
        return element.text or ""
    result = {}
    for child in children:
        value = _xml_to_dict(child)
        if child.tag not in result:
            result[child.tag] = value
        elif isinstance(result[child.tag], list):
            result[child.tag].append(value)
        else:
            result[child.tag] = [result[child.tag], value]
    return result
{{~ end ~}}


{{~ if change_detection.enabled ~}}
def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(diff_text):
    host = os.environ[SMTP_HOST_ENV_VAR]
    port = int(os.environ[SMTP_PORT_ENV_VAR]) if SMTP_PORT_ENV_VAR else 587
    username = os.environ.get(SMTP_USERNAME_ENV_VAR) if SMTP_USERNAME_ENV_VAR else None
    password = os.environ.get(SMTP_PASSWORD_ENV_VAR) if SMTP_PASSWORD_ENV_VAR else None
    sender = os.environ[NOTIFY_EMAIL_FROM_ENV_VAR]
    recipient = os.environ[NOTIFY_EMAIL_TO_ENV_VAR]

    msg = MIMEText(diff_text)
    msg["Subject"] = "Scraping Factory: changes detected"
    msg["From"] = sender
    msg["To"] = recipient

    # EHLO first so has_extn() actually knows what the server advertises —
    # opportunistic STARTTLS (upgrade only if offered) works against both a
    # real provider and an unauthenticated local/internal relay that never
    # advertises it, without needing the caller to say which kind it is.
    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(diff_text):
    url = os.environ[WEBHOOK_URL_ENV_VAR]
    payload = json.dumps({"subject": "Scraping Factory: changes detected", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


# Best-effort: by the time this runs, the current run's own output has
# already been written successfully — a notification failure (unreachable
# SMTP host, webhook down, ...) is reported but never fails the overall run.
def _notify_change(old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if CHANGE_DETECTION_NOTIFY == "Email":
            _notify_email(diff_text)
        else:
            _notify_webhook(diff_text)
    except Exception as e:
        print(f"Warning: change notification failed: {e}")
{{~ end ~}}


def scrape(url):
    with sync_playwright() as p:
        browser = p.chromium.launch({{ if proxy.enabled }}proxy=_next_playwright_proxy(){{ end }})
        page = browser.new_page()
{{ actions }}
{{~ if hardening.enabled ~}}
        # Playwright has no single raw response body to measure after JS
        # execution — "length" approximates it as the rendered page's own
        # UTF-8-encoded size instead of a true network byte count.
        _page_content = page.content()
        _BLOCKING_RESPONSES.append(
            {"url": url, "final_url": page.url, "length": len(_page_content.encode("utf-8")), "text": _page_content}
        )
{{~ end ~}}

        # Multiple top-level groups are siblings in GROUPS, but XML needs
        # exactly one root element — wrap them all in a single <Ergebnis>.
        root = ET.Element("Ergebnis")
        for node in GROUPS:
            for el in extract_group(page, page, node):
                root.append(el)

        browser.close()
        return root


def main():
{{~ if change_detection.enabled ~}}
    previous_content = _read_previous_output(OUTPUT_PATH)
{{~ end ~}}
    # Issue #83: each URL's own scrape() already wraps its matches in an
    # <Ergebnis> element (see above) — combine every URL's children into one
    # final <Ergebnis>, the same sibling-merging pattern already used for
    # multiple root groups from a single URL.
    root = ET.Element("Ergebnis")
    for url in URLS:
        for el in scrape(url):
            root.append(el)
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(_xml_to_dict(root), f, ensure_ascii=False, indent=2)
    count = len(root.findall(".//*"))
    print(f"Done — {count} elements written to {{ output_filename }}.json")
{{~ else ~}}
    tree = ET.ElementTree(root)
    ET.indent(tree)
    tree.write(OUTPUT_PATH, encoding="utf-8", xml_declaration=True)
    count = len(root.findall(".//*"))
    print(f"Done — {count} elements written to {{ output_filename }}.xml")
{{~ end ~}}
{{~ if change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(root) or _report_required_fields_drops()
{{~ if hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(count)
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
