            "el => Array.from(el.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join('')"
        ).strip()
        return _apply_transforms(own_text, node["transform"])
    return _apply_transforms((found.text_content() or "").strip(), node["transform"])


# Flattens the group tree into denormalized rows for BLUEPRINT_MAPPING —
# see scraper_grouped.py.j2's identical _flatten_group_tree_for_blueprint
# for the full design reasoning (always returns a list of context dicts;
# only a relevant repeating group's own instance boundary ever multiplies
# it). `page` is threaded through purely for _resolve_group_matches/
# _resolve_field_match's own FramePath resolution, same as extract_group().
def _flatten_group_tree_for_blueprint(page, scope, node, context):
    if "children" in node:
        if not _blueprint_subtree_has_mapped_field(node):
            return [context]

        matches = _resolve_group_matches(page, scope, node)

        all_contexts = []
        for match in matches:
            instance_contexts = [context]
            for child in node["children"]:
                next_contexts = []
                for ctx in instance_contexts:
                    next_contexts.extend(_flatten_group_tree_for_blueprint(page, match, child, ctx))
                instance_contexts = next_contexts
            all_contexts.extend(instance_contexts)
        return all_contexts

    value = _resolve_flatten_leaf_value(page, scope, node)
    if node["name"] in BLUEPRINT_MAPPING_BY_SOURCE:
        return [{**context, node["name"]: value}]
    return [context]


# Issue #244: a second, tree-shaped Output Blueprint target schema — see
# scraper_grouped.py.j2's own identical-in-spirit BLUEPRINT_TREE_MAPPING/
# _build_blueprint_node doc comments for the full design reasoning. This is
# the Browser-engine mirror: the only real difference is that
# _blueprint_walk_suffix below delegates every step straight to
# _resolve_group_matches (already handling repeating/non-repeating AND
# FramePath uniformly, unlike the Static engine's own plain select/
# select_one pair), and every function threads `page` through for the same
# reason extract_group()/_flatten_group_tree_for_blueprint already do.
BLUEPRINT_TREE_MAPPING = {{ blueprint_tree_mapping_literal }}

_BLUEPRINT_GROUP_BY_NAME = {}
_BLUEPRINT_LEAF_BY_NAME = {}
_BLUEPRINT_PATH_BY_NAME = {}


def _blueprint_index_source_tree(nodes, ancestors):
    for node in nodes:
        if "children" in node:
            _BLUEPRINT_GROUP_BY_NAME.setdefault(node["name"], node)
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _blueprint_index_source_tree(node["children"], ancestors + [node])
        else:
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _BLUEPRINT_LEAF_BY_NAME.setdefault(node["name"], node)


_blueprint_index_source_tree(GROUPS, [])


def _blueprint_repeating_chain(name):
    return [g["name"] for g in _BLUEPRINT_PATH_BY_NAME.get(name, []) if g["repeating"]]


def _blueprint_full_path(name):
    ancestors = _BLUEPRINT_PATH_BY_NAME.get(name, [])
    group = _BLUEPRINT_GROUP_BY_NAME.get(name)
    return ancestors + [group] if group is not None else ancestors


def _blueprint_walk_suffix(page, scopes, suffix):
    for group in suffix:
        next_scopes = []
        for scope in scopes:
            next_scopes.extend(_resolve_group_matches(page, scope, group))
        scopes = next_scopes
    return scopes


# See scraper_grouped.py.j2's identical function for the full "trusts
# ScrapingPlanValidator's own generate-time guarantee, doesn't re-validate"
# reasoning.
def _blueprint_resolve_group_chain(target_children, ancestor_chain):
    chains = [_blueprint_repeating_chain(c["source"]) for c in target_children if "source" in c]
    non_empty = [c for c in chains if c]
    return max(non_empty, key=len) if non_empty else ancestor_chain


def _build_blueprint_node(page, top_scope, scope, ancestor_chain, ancestor_full_path, target_node):
    if "children" in target_node:
        row_chain = _blueprint_resolve_group_chain(target_node["children"], ancestor_chain)
        full_path = _blueprint_full_path(row_chain[-1]) if row_chain else ancestor_full_path
        instances = _blueprint_walk_suffix(page, [scope], full_path[len(ancestor_full_path):])

        elements = []
        for instance in instances:
            el = ET.Element(target_node["name"])
            for child in target_node["children"]:
                result = _build_blueprint_node(page, top_scope, instance, row_chain, full_path, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            elements.append(el)
        return elements

    source_name = target_node["source"]
    leaf_node = _BLUEPRINT_LEAF_BY_NAME[source_name]
    chain = _blueprint_repeating_chain(source_name)
    if chain:
        scopes = _blueprint_walk_suffix(page, [scope], _blueprint_full_path(source_name)[len(ancestor_full_path):])
    else:
        scopes = _blueprint_walk_suffix(page, [top_scope], _blueprint_full_path(source_name))

    resolved = scopes[0] if scopes else None
    el = ET.Element(target_node["name"])
    el.text = ("false" if leaf_node["mode"] == "exists" else "") if resolved is None else _resolve_flatten_leaf_value(page, resolved, leaf_node)
    return el


def _build_blueprint_tree(page, target_roots):
    elements = []
    for target_node in target_roots:
        result = _build_blueprint_node(page, page, page, [], [], target_node)
        if isinstance(result, list):
            elements.extend(result)
        else:
            elements.append(result)
    return elements


#@include transforms


# A node's own "frame_path" (Issue #42, Phase 3) is always resolved fresh
# from `page` — an absolute top-to-target chain, independent of how deeply
# nested the node is in the tree or whether any ancestor also has a
# frame_path. Locator (what a FrameLocator chain returns) has no
# query_selector/query_selector_all of its own, only ElementHandle does — so
# a resolved group match is converted via .element_handle() right away,
# letting every recursive call below keep using query_selector/
# query_selector_all exactly as before this existed, regardless of whether
# *this* node was framed.
def _resolve_frame_locator(page, frame_path):
    scope = page
    for frame_selector in frame_path:
        scope = scope.frame_locator(frame_selector)
    return scope


# Used by the WaitFor/Fill/Click/Scroll action fragments rendered into the
# scrape() body below (one per playwright_*_step.py.j2 template) — same
# helper as playwright_scraper.py.j2's, duplicated rather than shared since
# the two shell templates don't share any Python source, only the same
# Scriban fragment templates rendered into both.
def _resolve_locator(page, selector, frame_path):
    return _resolve_frame_locator(page, frame_path or []).locator(selector)


def _resolve_group_matches(page, scope, node):
    frame_path = node.get("frame_path")
    if not frame_path:
        if node["repeating"]:
            return scope.query_selector_all(node["selector"])
        found = scope.query_selector(node["selector"])
        return [found] if found else []

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    if node["repeating"]:
        return [item.element_handle() for item in locator.all()]
    return [locator.first.element_handle()] if locator.count() > 0 else []


def _resolve_field_match(page, scope, node):
    # Issue #206 follow-up: a derived (combineFields/splitField) field has
    # no selector of its own — see scraper_grouped.py.j2's own identical
    # guard.
    if not node["selector"]:
        return None
    frame_path = node.get("frame_path")
    if not frame_path:
        return scope.query_selector(node["selector"])

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    return locator.first if locator.count() > 0 else None


# Same tree walk as the Static engine's scraper_grouped.py.j2 — only the two
# DOM-access calls differ (query_selector_all/query_selector here vs.
# select/select_one there), the recursive group/data-field logic is
# identical. `page` is threaded through explicitly (rather than relying on
# closure capture) purely so frame_path resolution — always relative to the
# top-level page, never to `scope` — has something to resolve from
# regardless of how deep the current recursion already is.
def extract_group(page, scope, node, siblings=None):
    if "children" in node:
        matches = _resolve_group_matches(page, scope, node)

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            # Issue #206: el is this group instance's own in-construction
            # element — see scraper_grouped.py.j2's own identical doc
            # comment on this same pattern.
            for child in node["children"]:
                result = extract_group(page, match, child, el)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
{{~ if hardening.enabled ~}}
            if node["repeating"] and not _passes_required_fields(el):
                continue
{{~ end ~}}
{{~ if dedup.enabled ~}}
            if node["repeating"] and not _dedup_register_instance(el):
                continue
{{~ end ~}}
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    # Issue #206 follow-up: see scraper_grouped.py.j2's own identical doc
    # comment — a derived field's whole value comes from this call, so it
    # must always run through _apply_transforms rather than short-circuiting
    # to "" the way an ordinary missing-match does below.
    if not node["selector"]:
        el.text = "false" if node["mode"] == "exists" else _apply_transforms("", node["transform"], siblings)
        return el
    found = _resolve_field_match(page, scope, node)
    if node["mode"] == "exists":
        el.text = "true" if found else "false"
    elif found is None:
        el.text = ""
    elif node["mode"] == "attribute":
        value = _apply_transforms(found.get_attribute(node["attribute"]) or "", node["transform"], siblings)
        # Issue #213: see scraper_grouped.py.j2's own identical doc comment —
        # applied after transforms, replaces the raw URL with its own
        # downloaded local file path.
        el.text = _download_resource(page, value, node.get("maxDownloadSizeBytes"), node.get("allowedContentTypes")) if node.get("download") and value else value
    elif node["mode"] == "ownText":
        # Direct text-node children only, excluding any nested element's own
        # text — see scraper_grouped.py.j2's own doc comment on this same
        # branch for the "why" (a badge inside a name heading, etc.).
        # ElementHandle has no built-in "own text" accessor, unlike
        # BeautifulSoup's .contents, so this needs a small evaluate() call.
        own_text = found.evaluate(
            "el => Array.from(el.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join('')"
        ).strip()
        el.text = _apply_transforms(own_text, node["transform"], siblings)
    else:
        el.text = _apply_transforms((found.text_content() or "").strip(), node["transform"], siblings)
    return el


{{~ if output_is_json ~}}
# Converts the group tree (already extracted into ET.Element form by
# extract_group above) into nested dicts/lists for JSON output — reusing the
# same extraction walk instead of a second, JSON-specific one. A tag that
# occurs more than once among one element's children — several matches of a
# repeating group, or same-named sibling fields/groups, which Container-Mode
# explicitly allows — becomes a JSON list; a tag occurring exactly once stays
# a plain nested value.
def _xml_to_dict(element):
    children = list(element)
    if not children:
        return element.text or ""
    result = {}
    for child in children:
        value = _xml_to_dict(child)
        if child.tag not in result:
            result[child.tag] = value
        elif isinstance(result[child.tag], list):
            result[child.tag].append(value)
        else:
            result[child.tag] = [result[child.tag], value]
    return result
{{~ end ~}}


