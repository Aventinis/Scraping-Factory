import xml.etree.ElementTree as ET
from playwright.sync_api import sync_playwright

URL = "{{ url }}"

GROUPS = {{ groups_literal }}


# Same tree walk as the Static engine's scraper_grouped.py.j2 — only the two
# DOM-access calls differ (query_selector_all/query_selector here vs.
# select/select_one there), the recursive group/data-field logic is
# identical.
def extract_group(scope, node):
    if "children" in node:
        if node["repeating"]:
            matches = scope.query_selector_all(node["selector"])
        else:
            found = scope.query_selector(node["selector"])
            matches = [found] if found else []

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            for child in node["children"]:
                result = extract_group(match, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    if node["mode"] == "exists":
        el.text = "true" if scope.query_selector(node["selector"]) else "false"
    else:
        found = scope.query_selector(node["selector"])
        if found is None:
            el.text = ""
        elif node["mode"] == "attribute":
            el.text = found.get_attribute(node["attribute"]) or ""
        else:
            el.text = (found.text_content() or "").strip()
    return el


def scrape(url):
    with sync_playwright() as p:
        browser = p.chromium.launch()
        page = browser.new_page()
{{ actions }}

        # Multiple top-level groups are siblings in GROUPS, but XML needs
        # exactly one root element — wrap them all in a single <Ergebnis>.
        root = ET.Element("Ergebnis")
        for node in GROUPS:
            for el in extract_group(page, node):
                root.append(el)

        browser.close()
        return root


def main():
    root = scrape(URL)
    tree = ET.ElementTree(root)
    ET.indent(tree)
    tree.write("{{ output_filename }}.xml", encoding="utf-8", xml_declaration=True)
    count = len(root.findall(".//*"))
    print(f"Done — {count} elements written to {{ output_filename }}.xml")


if __name__ == "__main__":
    main()
