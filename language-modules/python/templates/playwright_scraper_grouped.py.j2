def _blueprint_repeating_chain(name):
    return [g["name"] for g in _BLUEPRINT_PATH_BY_NAME.get(name, []) if g["repeating"]]


def _blueprint_full_path(name):
    ancestors = _BLUEPRINT_PATH_BY_NAME.get(name, [])
    group = _BLUEPRINT_GROUP_BY_NAME.get(name)
    return ancestors + [group] if group is not None else ancestors


def _blueprint_walk_suffix(page, scopes, suffix):
    for group in suffix:
        next_scopes = []
        for scope in scopes:
            next_scopes.extend(_resolve_group_matches(page, scope, group))
        scopes = next_scopes
    return scopes


# See scraper_grouped.py.j2's identical function for the full "trusts
# ScrapingPlanValidator's own generate-time guarantee, doesn't re-validate"
# reasoning.
def _blueprint_resolve_group_chain(target_children, ancestor_chain):
    chains = [_blueprint_repeating_chain(c["source"]) for c in target_children if "source" in c]
    non_empty = [c for c in chains if c]
    return max(non_empty, key=len) if non_empty else ancestor_chain


def _build_blueprint_node(page, top_scope, scope, ancestor_chain, ancestor_full_path, target_node):
    if "children" in target_node:
        row_chain = _blueprint_resolve_group_chain(target_node["children"], ancestor_chain)
        full_path = _blueprint_full_path(row_chain[-1]) if row_chain else ancestor_full_path
        instances = _blueprint_walk_suffix(page, [scope], full_path[len(ancestor_full_path):])

        elements = []
        for instance in instances:
            el = ET.Element(target_node["name"])
            for child in target_node["children"]:
                result = _build_blueprint_node(page, top_scope, instance, row_chain, full_path, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            elements.append(el)
        return elements

    source_name = target_node["source"]
    leaf_node = _BLUEPRINT_LEAF_BY_NAME[source_name]
    chain = _blueprint_repeating_chain(source_name)
    if chain:
        scopes = _blueprint_walk_suffix(page, [scope], _blueprint_full_path(source_name)[len(ancestor_full_path):])
    else:
        scopes = _blueprint_walk_suffix(page, [top_scope], _blueprint_full_path(source_name))

    resolved = scopes[0] if scopes else None
    el = ET.Element(target_node["name"])
    el.text = ("false" if leaf_node["mode"] == "exists" else "") if resolved is None else _resolve_flatten_leaf_value(page, resolved, leaf_node)
    return el


def _build_blueprint_tree(page, target_roots):
    elements = []
    for target_node in target_roots:
        result = _build_blueprint_node(page, page, page, [], [], target_node)
        if isinstance(result, list):
            elements.extend(result)
        else:
            elements.append(result)
    return elements


