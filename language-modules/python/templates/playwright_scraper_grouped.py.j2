# Resolves one leaf field's raw value exactly like extract_group()'s own
# leaf branch — see scraper_grouped.py.j2's identical-in-spirit
# _resolve_flatten_leaf_value for the full "why a separate function"
# reasoning, including the Issue #213 note that Download is deliberately
# not applied here (a flattened Output Blueprint row keeps the raw URL), and
# the Issue #206 note that a combineFields/splitField transform has no
# sibling element to resolve against here either (see scraper_grouped.py.j2's
# own identical doc comment).
# Uses _resolve_field_match (defined further below, resolved lazily at
# call time — Python doesn't require def order to match call order) so
# FramePath-scoped fields work here exactly like they do for
# extract_group() itself.
def _resolve_flatten_leaf_value(page, scope, node):
    found = _resolve_field_match(page, scope, node)
    if node["mode"] == "exists":
        return "true" if found else "false"
    if found is None:
        return ""
    if node["mode"] == "attribute":
        return _apply_transforms(found.get_attribute(node["attribute"]) or "", node["transform"])
    if node["mode"] == "ownText":
