# Issue #88 (proxy support): PROXY_ENV_VAR is an environment-variable
# *name* holding a comma-separated list of proxy URLs — never a literal
# proxy address baked into the script, same as FillStep credentials. If
# more than one is present, browser launches rotate through them
# round-robin. A missing (not just empty) env var doesn't abort the run —
# it's treated as "no proxy configured", with a warning printed and the
# run flagged via EXIT_MISSING_ENV_VAR at the very end, once the script has
# otherwise completed successfully.
PROXY_ENV_VAR = {{ proxy.env_var_literal }}
_PROXY_ENV_VALUE = os.environ.get(PROXY_ENV_VAR)
_PROXY_ENV_MISSING = _PROXY_ENV_VALUE is None
if _PROXY_ENV_MISSING:
    print(f"Warning: environment variable '{PROXY_ENV_VAR}' is not set — connecting without a proxy.", file=sys.stderr)
_PROXY_LIST = [p.strip() for p in (_PROXY_ENV_VALUE or "").split(",") if p.strip()]
_proxy_cycle = itertools.cycle(_PROXY_LIST) if _PROXY_LIST else None


def _next_proxy():
    return next(_proxy_cycle) if _proxy_cycle else None


def _next_playwright_proxy():
    proxy = _next_proxy()
    if not proxy:
        return None
    parsed = urllib.parse.urlsplit(proxy)
    server = f"{parsed.scheme}://{parsed.hostname}"
    if parsed.port:
        server += f":{parsed.port}"
    result = {"server": server}
    if parsed.username:
        result["username"] = parsed.username
    if parsed.password:
        result["password"] = parsed.password
    return result
{{~ end ~}}

{{~ if hardening.enabled ~}}
# Issue #129 (script hardening): each configured check independently prints
# a warning (script still exits 0) or an error (script exits
# EXIT_HARDENING_FAILED) once scraping is done — lets a script re-run later
# (e.g. via cron, weeks after generation) detect that it silently stopped
# finding anything, instead of writing an empty output file and exiting 0
# as if nothing were wrong.
EXIT_HARDENING_FAILED = 2

HARDENING = {{ hardening.checks_literal }}

# Issue #132 (blocking-detection check): a snapshot of each URL's rendered
# page (final URL, content length, content) is captured in scrape() below,
# right after all browser actions complete — the page actually about to be
# scraped, not an intermediate redirect a login flow legitimately passes
# through. Populated even when no "blocking" check is configured; the
# runtime cost of appending an already-in-memory string is negligible.
_BLOCKING_RESPONSES = []

# Issue #133 (required-fields check, container mode): matched globally by
# tag name anywhere in the built tree (same convention the nullRate check
# already established for this exact ambiguity) — REQUIRED_FIELD_NAMES is
# the plain list of names to check, empty when no "requiredFields" check is
# configured, in which case extract_group()'s own call site below is a
# guaranteed no-op.
_REQUIRED_FIELDS_CHECK = next((c for c in HARDENING if c["kind"] == "requiredFields"), None)
REQUIRED_FIELD_NAMES = _REQUIRED_FIELDS_CHECK["fieldNames"] if _REQUIRED_FIELDS_CHECK else []
_required_fields_dropped_count = 0


# Called from extract_group() right after a *repeating* group's one
# instance is fully built (never for a non-repeating group, which has no
# "instance" to drop) — checks whether any required field anywhere in this
# instance's own subtree is empty, dropping the whole instance if so.
# extract_group() already recurses bottom-up, so this naturally drops the
# nearest enclosing repeating instance, whichever nesting level actually
# contains the problem — an inner repeating group's own bad instance is
# dropped without disturbing its outer container. A required field name
# matching nothing in this subtree is a silent no-op (typo/renamed field),
# the same "skip rather than error" convention the nullRate check's own
# zero-match case already uses.
def _passes_required_fields(el):
    global _required_fields_dropped_count
    for name in REQUIRED_FIELD_NAMES:
        for match in el.iter(name):
            if not (match.text or "").strip():
                _required_fields_dropped_count += 1
                return False
    return True


# Unlike flat mode's "N of M rows" message, dropping can happen at more
# than one nesting level in one run, so there's no single well-defined "of
# M" denominator here — a plain count is reported instead.
def _report_required_fields_drops():
    if _REQUIRED_FIELDS_CHECK is None or _required_fields_dropped_count == 0:
        return False
    message = f"Dropped {_required_fields_dropped_count} element(s) missing a required field."
    if _REQUIRED_FIELDS_CHECK["severity"] == "Error":
        print(f"ERROR: {message}", file=sys.stderr)
        return True
    print(f"WARNING: {message}", file=sys.stderr)
    return False

{{~ if hardening.has_baseline ~}}
# Issue #131 (baseline check): a small sidecar file next to the script's own
# output records the result count from the last run that passed cleanly
# (see main()'s own "only write when not hardening_failed" call site) — a
# bad run must never become the new normal for the next comparison. Missing/
# corrupt sidecar (first run ever, or the file was deleted) is treated the
# same as "no baseline yet", not an error.
BASELINE_PATH = OUTPUT_PATH + ".hardening-baseline.json"


def _read_baseline():
    try:
        with open(BASELINE_PATH, "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(count):
    with open(BASELINE_PATH, "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)
{{~ end ~}}


def _run_hardening_checks(root):
    has_error = False
    result_count = len(root.findall(".//*"))
    for check in HARDENING:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = "No data was extracted — at least one selector likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            # Issue #130: matched globally by tag name across the whole
            # output tree, not scoped to whichever parent group the field is
            # nested under (see NullRateCheck's own doc comment) — catches a
            # field whose selector quietly starts matching the wrong thing
            # (still returns a value, always empty) even though the overall
            # element count stays healthy.
            field = check["field"]
            elements = list(root.iter(check["field"]))
            total = len(elements)
            if total == 0:
                continue
            empty = sum(1 for el in elements if not (el.text or "").strip())
            rate = empty / total
            if rate > check["threshold"]:
                message = f"Field '{field}': {rate:.0%} of occurrences are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            # Issue #131: catches a gradual drop in result volume that
            # neither noResult (only fires at exactly zero) nor nullRate
            # (only watches one field) would ever trip — e.g. a paginated
            # list quietly losing entries. No baseline yet (first run, or
            # the sidecar file was deleted) simply has nothing to compare
            # against.
            baseline = _read_baseline()
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "blocking":
            # Issue #132: three signals, all evaluated per captured response
            # — a redirect to a different host (always checked), a body
            # shorter than minBodyLength (skipped when None), and a
            # case-insensitive match against blockPhrases.
            for entry in _BLOCKING_RESPONSES:
                reasons = []
                if urllib.parse.urlsplit(entry["url"]).netloc != urllib.parse.urlsplit(entry["final_url"]).netloc:
                    reasons.append(f"redirected to a different host ({entry['final_url']})")
                if check["minBodyLength"] is not None and entry["length"] < check["minBodyLength"]:
                    reasons.append(f"response body is only {entry['length']} bytes (minimum: {check['minBodyLength']})")
                matched_phrases = [p for p in check["blockPhrases"] if p.lower() in entry["text"].lower()]
                if matched_phrases:
                    reasons.append(f"matched block phrase(s): {', '.join(matched_phrases)}")
                if reasons:
                    message = f"Possible blocking detected for {entry['url']}: {'; '.join(reasons)}."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error
{{~ end ~}}

