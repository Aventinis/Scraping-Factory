def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(block, diff_text):
    cd = block["change_detection"]
    host = os.environ[cd["smtp_host_env_var"]]
    port = int(os.environ[cd["smtp_port_env_var"]]) if cd["smtp_port_env_var"] else 587
    username = os.environ.get(cd["smtp_username_env_var"]) if cd["smtp_username_env_var"] else None
    password = os.environ.get(cd["smtp_password_env_var"]) if cd["smtp_password_env_var"] else None
    sender = os.environ[cd["from_env_var"]]
    recipient = os.environ[cd["to_env_var"]]

    msg = MIMEText(diff_text)
    msg["Subject"] = f"Scraping Factory: changes detected ({block['name']})"
    msg["From"] = sender
    msg["To"] = recipient

    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(block, diff_text):
    cd = block["change_detection"]
    url = os.environ[cd["webhook_url_env_var"]]
    payload = json.dumps({"subject": f"Scraping Factory: changes detected ({block['name']})", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


def _notify_change(block, old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if block["change_detection"]["notify"] == "Email":
            _notify_email(block, diff_text)
        else:
            _notify_webhook(block, diff_text)
    except Exception as e:
        print(f"Warning: [{block['name']}] change notification failed: {e}")
{{~ end ~}}


def scrape(url):
    with sync_playwright() as p:
        browser = p.chromium.launch({{ if proxy.enabled }}proxy=_next_playwright_proxy(){{ end }})
{{~ if persistent_session_enabled ~}}
        _session_exists = os.path.exists(SESSION_STATE_PATH)
        context = browser.new_context(storage_state=SESSION_STATE_PATH if _session_exists else None)
        page = context.new_page()
{{ navigate_action }}
{{~ if has_login_actions ~}}
        if not _session_exists:
{{ login_actions }}
{{~ end ~}}
{{~ else ~}}
        page = browser.new_page()
{{ actions }}
{{~ end ~}}

        results = {block["name"]: [] for block in BLOCKS}
        page_number = 1
        while True:
{{~ if hardening_any ~}}
            _page_content = page.content()
            _BLOCKING_RESPONSES.append(
                {"url": page.url, "final_url": page.url, "length": len(_page_content.encode("utf-8")), "text": _page_content}
            )
{{~ end ~}}
            any_new = False
            for block in BLOCKS:
                if block["shape"] == "flat":
                    page_rows = _extract_flat_block(block, page)
                    if page_rows:
                        any_new = True
                    results[block["name"]].extend(page_rows)
                else:
                    required = next((c["fieldNames"] for c in block["hardening"]["checks"] if c["kind"] == "requiredFields"), [])
                    page_elements = []
                    for node in block["groups"]:
                        page_elements.extend(extract_group(page, page, node, required, block["name"]))
                    if page_elements:
                        any_new = True
                    results[block["name"]].extend(page_elements)

            if not any_new:
                break

{{~ if pagination.enabled ~}}
            if page_number >= PAGINATION_MAX_PAGES:
                break
            page_number += 1
{{~ if pagination.kind == "nextLink" ~}}
            next_el = page.query_selector(PAGINATION_NEXT_LINK_SELECTOR)
            next_href = next_el.get_attribute("href") if next_el else None
            if not next_href:
                break
            page.goto(urllib.parse.urljoin(page.url, next_href), wait_until="load", timeout=30000)
{{~ else ~}}
            page.goto(PAGINATION_URL_TEMPLATE.format(url=url, page=page_number), wait_until="load", timeout=30000)
{{~ end ~}}
{{~ else ~}}
            break
{{~ end ~}}

{{~ if persistent_session_enabled ~}}
        context.storage_state(path=SESSION_STATE_PATH)
{{~ end ~}}
        browser.close()
        return results


def main():
{{~ if change_detection_any ~}}
    previous_contents = {block["name"]: (_read_previous_output(block["output_path"]) if block["change_detection"]["enabled"] else None) for block in BLOCKS}
{{~ end ~}}

    per_block_data = {block["name"]: [] for block in BLOCKS if block["shape"] == "flat"}
    per_block_roots = {block["name"]: ET.Element("Ergebnis") for block in BLOCKS if block["shape"] == "group"}
    for url in URLS:
        page_results = scrape(url)
        for block in BLOCKS:
            if block["shape"] == "flat":
                per_block_data[block["name"]].extend(page_results[block["name"]])
            else:
                for el in page_results[block["name"]]:
                    per_block_roots[block["name"]].append(el)

    hardening_failed = False
    for block in BLOCKS:
        name = block["name"]
        if block["shape"] == "flat":
            data = per_block_data[name]
{{~ if hardening_any ~}}
            data, required_fields_failed = _filter_required_fields(block, data)
{{~ end ~}}
            if block["output_is_json"]:
                with open(block["output_path"], "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
            else:
                with open(block["output_path"], "w", newline="", encoding="utf-8") as f:
                    writer = csv.DictWriter(f, fieldnames=block["field_order"])
                    writer.writeheader()
                    writer.writerows(data)
            count = len(data)
            print(f"Done — [{name}] {count} rows written to {block['output_path']}")
{{~ if hardening_any ~}}
            block_failed = _run_hardening_checks(block, count, lambda field, data=data: [str(row.get(field, "")) for row in data]) or required_fields_failed
{{~ end ~}}
        else:
            root = per_block_roots[name]
            if block["output_is_json"]:
                with open(block["output_path"], "w", encoding="utf-8") as f:
                    json.dump(_xml_to_dict(root), f, ensure_ascii=False, indent=2)
            else:
                tree = ET.ElementTree(root)
                ET.indent(tree)
                tree.write(block["output_path"], encoding="utf-8", xml_declaration=True)
            count = len(root.findall(".//*"))
            print(f"Done — [{name}] {count} elements written to {block['output_path']}")
{{~ if hardening_any ~}}
            required_fields_failed = _report_required_fields_drops(block)
            block_failed = _run_hardening_checks(block, count, lambda field, root=root: [(el.text or "") for el in root.iter(field)]) or required_fields_failed
{{~ end ~}}

{{~ if change_detection_any ~}}
        if block["change_detection"]["enabled"]:
            with open(block["output_path"], "r", encoding="utf-8") as f:
                new_content = f.read()
            if previous_contents[name] is not None and previous_contents[name] != new_content:
                _notify_change(block, previous_contents[name], new_content)
{{~ end ~}}

{{~ if hardening_any ~}}
        if block["hardening"]["has_baseline"] and not block_failed:
            _write_baseline(block, count)
        hardening_failed = hardening_failed or block_failed
{{~ end ~}}

{{~ if hardening_any ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
