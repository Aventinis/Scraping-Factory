def _extract_flat_block(block, page):
    frame_paths = block["frame_paths"]
    columns = {name: _resolve_elements(page, sel, frame_paths.get(name)) for name, sel in block["selectors"].items()}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name, elements in columns.items():
            if i < len(elements):
                attr = block["attributes"].get(name)
                raw_value = (elements[i].get_attribute(attr) or "") if attr else (elements[i].text_content() or "").strip()
                row[name] = _apply_transforms(raw_value, block["transforms"].get(name, []), row)
            else:
                row[name] = ""
        rows.append(row)
    return rows


def _resolve_group_matches(page, scope, node):
    frame_path = node.get("frame_path")
    if not frame_path:
        if node["repeating"]:
            return scope.query_selector_all(node["selector"])
        found = scope.query_selector(node["selector"])
        return [found] if found else []

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    if node["repeating"]:
        return [item.element_handle() for item in locator.all()]
    return [locator.first.element_handle()] if locator.count() > 0 else []


def _resolve_field_match(page, scope, node):
    frame_path = node.get("frame_path")
    if not frame_path:
        return scope.query_selector(node["selector"])

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    return locator.first if locator.count() > 0 else None


# Same tree walk as scraper_blocks.py.j2's own extract_group() — only the two
# DOM-access calls differ (query_selector_all/query_selector via the resolve_*
# helpers above vs. select/select_one there), mirroring the exact same
# relationship playwright_scraper_grouped.py.j2 already has to
# scraper_grouped.py.j2. `page` is threaded through explicitly for frame_path
# resolution, same reason playwright_scraper_grouped.py.j2's own extract_group
# already does.
def extract_group(page, scope, node, required_field_names, block_name, siblings=None):
    if "children" in node:
        matches = _resolve_group_matches(page, scope, node)

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            # Issue #206: el is this group instance's own in-construction
            # element — see scraper_grouped.py.j2's own identical doc
            # comment on this same pattern.
            for child in node["children"]:
                result = extract_group(page, match, child, required_field_names, block_name, el)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            if node["repeating"] and required_field_names:
                dropped = False
                for name in required_field_names:
                    for req_match in el.iter(name):
                        if not (req_match.text or "").strip():
                            _REQUIRED_FIELDS_DROPPED[block_name] += 1
                            dropped = True
                            break
                    if dropped:
                        break
                if dropped:
                    continue
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    found = _resolve_field_match(page, scope, node)
    if node["mode"] == "exists":
        el.text = "true" if found else "false"
    elif found is None:
        el.text = ""
    elif node["mode"] == "attribute":
        el.text = _apply_transforms(found.get_attribute(node["attribute"]) or "", node["transform"], siblings)
    elif node["mode"] == "ownText":
        own_text = found.evaluate(
            "el => Array.from(el.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join('')"
        ).strip()
        el.text = _apply_transforms(own_text, node["transform"], siblings)
    else:
        el.text = _apply_transforms((found.text_content() or "").strip(), node["transform"], siblings)
    return el


