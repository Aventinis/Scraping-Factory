EXIT_HARDENING_FAILED = 2

_BLOCKING_RESPONSES = []


def _read_baseline(block):
    try:
        with open(block["output_path"] + ".hardening-baseline.json", "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(block, count):
    with open(block["output_path"] + ".hardening-baseline.json", "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)


def _run_hardening_checks(block, result_count, field_values):
    has_error = False
    prefix = f"[{block['name']}] "
    for check in block["hardening"]["checks"]:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = prefix + "No data was extracted — at least one selector likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            field = check["field"]
            values = field_values(field)
            total = len(values)
            if total == 0:
                continue
            empty = sum(1 for v in values if not v.strip())
            rate = empty / total
            if rate > check["threshold"]:
                message = f"{prefix}Field '{field}': {rate:.0%} of occurrences are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            baseline = _read_baseline(block)
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"{prefix}Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "blocking":
            for entry in _BLOCKING_RESPONSES:
                reasons = []
                if urlsplit(entry["url"]).netloc != urlsplit(entry["final_url"]).netloc:
                    reasons.append(f"redirected to a different host ({entry['final_url']})")
                if check["minBodyLength"] is not None and entry["length"] < check["minBodyLength"]:
                    reasons.append(f"response body is only {entry['length']} bytes (minimum: {check['minBodyLength']})")
                matched_phrases = [p for p in check["blockPhrases"] if p.lower() in entry["text"].lower()]
                if matched_phrases:
                    reasons.append(f"matched block phrase(s): {', '.join(matched_phrases)}")
                if reasons:
                    message = f"{prefix}Possible blocking detected for {entry['url']}: {'; '.join(reasons)}."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error


def _filter_required_fields(block, data):
    check = next((c for c in block["hardening"]["checks"] if c["kind"] == "requiredFields"), None)
    if check is None:
        return data, False
    total = len(data)
    filtered = [row for row in data if all(str(row.get(name, "")).strip() for name in check["fieldNames"])]
    dropped = total - len(filtered)
    if dropped == 0:
        return filtered, False
    message = f"[{block['name']}] Dropped {dropped} of {total} row(s) missing a required field."
    if check["severity"] == "Error":
        print(f"ERROR: {message}", file=sys.stderr)
        return filtered, True
    print(f"WARNING: {message}", file=sys.stderr)
    return filtered, False


def _report_required_fields_drops(block):
    dropped = _REQUIRED_FIELDS_DROPPED.get(block["name"], 0)
    check = next((c for c in block["hardening"]["checks"] if c["kind"] == "requiredFields"), None)
    if check is None or dropped == 0:
        return False
    message = f"[{block['name']}] Dropped {dropped} element(s) missing a required field."
    if check["severity"] == "Error":
        print(f"ERROR: {message}", file=sys.stderr)
        return True
    print(f"WARNING: {message}", file=sys.stderr)
    return False
{{~ end ~}}


def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Issue #205: safe, explicit type-conversion transforms -- unlike toNumber's
# best-effort heuristic extraction, these either produce a well-formed value
# or fall back to their own clearly defined "onError" behavior
# ("KeepOriginal" leaves the pre-conversion value untouched, "UseDefault"
# substitutes the transform's own configured "defaultValue") rather than
# silently guessing.
_DATE_FORMAT_TOKEN_PATTERNS = {"yyyy": r"(?P<yyyy>\d{4})", "mm": r"(?P<mm>\d{1,2})", "dd": r"(?P<dd>\d{1,2})"}


def _type_conversion_fallback(value, on_error, default_value):
    return default_value if on_error == "UseDefault" else value


def _to_integer(value, on_error, default_value):
    stripped = value.strip()
    if re.fullmatch(r"[+-]?\d+", stripped):
        return str(int(stripped))
    return _type_conversion_fallback(value, on_error, default_value)


def _to_boolean(value, on_error, default_value):
    normalized = value.strip().lower()
    if normalized in ("true", "1", "yes", "y"):
        return "True"
    if normalized in ("false", "0", "no", "n"):
        return "False"
    return _type_conversion_fallback(value, on_error, default_value)


# source_format is the same "{yyyy}"/"{mm}"/"{dd}" mini-template
# RangeSource.Format (RangeFormat.cs) already uses for ISO week/date
# parameters, compiled into a regex the same way (escape the literal
# template, then substitute each placeholder for its own capture group) so a
# format string valid on the companion side parses identically here. Also
# rejects a structurally-matching but non-existent calendar date (e.g.
# "2026-02-30") via date()'s own ValueError, not just a pattern match.
def _to_date(value, source_format, on_error, default_value):
    pattern = re.escape(source_format)
    for token, token_pattern in _DATE_FORMAT_TOKEN_PATTERNS.items():
        pattern = pattern.replace(re.escape("{" + token + "}"), token_pattern)
    match = re.fullmatch(pattern, value.strip())
    if match:
        try:
            return date(int(match.group("yyyy")), int(match.group("mm")), int(match.group("dd"))).isoformat()
        except ValueError:
            pass
    return _type_conversion_fallback(value, on_error, default_value)


def _apply_transforms(value, transforms):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
        elif kind == "toInteger":
            value = _to_integer(value, t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
        elif kind == "toBoolean":
            value = _to_boolean(value, t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
        elif kind == "toDate":
            value = _to_date(value, t.get("sourceFormat", "{yyyy}-{mm}-{dd}"), t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
    return value


def _resolve_frame_locator(page, frame_path):
    scope = page
    for frame_selector in frame_path:
        scope = scope.frame_locator(frame_selector)
    return scope


def _resolve_elements(page, selector, frame_path):
    if not frame_path:
        return page.query_selector_all(selector)
    return _resolve_frame_locator(page, frame_path).locator(selector).all()


def _resolve_locator(page, selector, frame_path):
    return _resolve_frame_locator(page, frame_path or []).locator(selector)


def _extract_flat_block(block, page):
    frame_paths = block["frame_paths"]
    columns = {name: _resolve_elements(page, sel, frame_paths.get(name)) for name, sel in block["selectors"].items()}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name, elements in columns.items():
            if i < len(elements):
                attr = block["attributes"].get(name)
                raw_value = (elements[i].get_attribute(attr) or "") if attr else (elements[i].text_content() or "").strip()
                row[name] = _apply_transforms(raw_value, block["transforms"].get(name, []))
            else:
                row[name] = ""
        rows.append(row)
    return rows


def _resolve_group_matches(page, scope, node):
    frame_path = node.get("frame_path")
    if not frame_path:
        if node["repeating"]:
            return scope.query_selector_all(node["selector"])
        found = scope.query_selector(node["selector"])
        return [found] if found else []

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    if node["repeating"]:
        return [item.element_handle() for item in locator.all()]
    return [locator.first.element_handle()] if locator.count() > 0 else []


def _resolve_field_match(page, scope, node):
    frame_path = node.get("frame_path")
    if not frame_path:
        return scope.query_selector(node["selector"])

    locator = _resolve_frame_locator(page, frame_path).locator(node["selector"])
    return locator.first if locator.count() > 0 else None


# Same tree walk as scraper_blocks.py.j2's own extract_group() — only the two
# DOM-access calls differ (query_selector_all/query_selector via the resolve_*
# helpers above vs. select/select_one there), mirroring the exact same
# relationship playwright_scraper_grouped.py.j2 already has to
# scraper_grouped.py.j2. `page` is threaded through explicitly for frame_path
# resolution, same reason playwright_scraper_grouped.py.j2's own extract_group
# already does.
def extract_group(page, scope, node, required_field_names, block_name):
    if "children" in node:
        matches = _resolve_group_matches(page, scope, node)

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            for child in node["children"]:
                result = extract_group(page, match, child, required_field_names, block_name)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            if node["repeating"] and required_field_names:
                dropped = False
                for name in required_field_names:
                    for req_match in el.iter(name):
                        if not (req_match.text or "").strip():
                            _REQUIRED_FIELDS_DROPPED[block_name] += 1
                            dropped = True
                            break
                    if dropped:
                        break
                if dropped:
                    continue
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    found = _resolve_field_match(page, scope, node)
    if node["mode"] == "exists":
        el.text = "true" if found else "false"
    elif found is None:
        el.text = ""
    elif node["mode"] == "attribute":
        el.text = _apply_transforms(found.get_attribute(node["attribute"]) or "", node["transform"])
    elif node["mode"] == "ownText":
        own_text = found.evaluate(
            "el => Array.from(el.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join('')"
        ).strip()
        el.text = _apply_transforms(own_text, node["transform"])
    else:
        el.text = _apply_transforms((found.text_content() or "").strip(), node["transform"])
    return el


