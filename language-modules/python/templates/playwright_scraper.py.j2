{{~ if change_detection.enabled ~}}
# Issue #87 (change detection): every *_ENV_VAR below is an environment-
# variable *name* (never the actual credential/target value) — read via
# os.environ[...] at runtime, exactly like FillStep already does for login
# credentials.
CHANGE_DETECTION_NOTIFY = {{ change_detection.notify_literal }}
SMTP_HOST_ENV_VAR = {{ change_detection.smtp_host_env_var_literal }}
SMTP_PORT_ENV_VAR = {{ change_detection.smtp_port_env_var_literal }}
SMTP_USERNAME_ENV_VAR = {{ change_detection.smtp_username_env_var_literal }}
SMTP_PASSWORD_ENV_VAR = {{ change_detection.smtp_password_env_var_literal }}
NOTIFY_EMAIL_FROM_ENV_VAR = {{ change_detection.from_env_var_literal }}
NOTIFY_EMAIL_TO_ENV_VAR = {{ change_detection.to_env_var_literal }}
WEBHOOK_URL_ENV_VAR = {{ change_detection.webhook_url_env_var_literal }}
{{~ end ~}}

{{~ if needs_exit_helper ~}}
# A FillStep's credential or Proxy's URL list must come from an environment
# variable that's actually set — this distinguishes "expected configuration
# gap" from an arbitrary script bug via a dedicated exit code instead of a
# raw, unhandled KeyError traceback.
EXIT_MISSING_ENV_VAR = 78


def _require_env(name):
    value = os.environ.get(name)
    if value is None:
        print(f"Error: required environment variable '{name}' is not set.", file=sys.stderr)
        sys.exit(EXIT_MISSING_ENV_VAR)
    return value
{{~ end ~}}

{{~ if proxy.enabled ~}}
# Issue #88 (proxy support): PROXY_ENV_VAR is an environment-variable
# *name* holding a comma-separated list of proxy URLs — never a literal
# proxy address baked into the script, same as FillStep credentials. If
# more than one is present, browser launches rotate through them
# round-robin. A missing (not just empty) env var doesn't abort the run —
# it's treated as "no proxy configured", with a warning printed and the
# run flagged via EXIT_MISSING_ENV_VAR at the very end, once the script has
# otherwise completed successfully.
PROXY_ENV_VAR = {{ proxy.env_var_literal }}
_PROXY_ENV_VALUE = os.environ.get(PROXY_ENV_VAR)
_PROXY_ENV_MISSING = _PROXY_ENV_VALUE is None
if _PROXY_ENV_MISSING:
    print(f"Warning: environment variable '{PROXY_ENV_VAR}' is not set — connecting without a proxy.", file=sys.stderr)
_PROXY_LIST = [p.strip() for p in (_PROXY_ENV_VALUE or "").split(",") if p.strip()]
_proxy_cycle = itertools.cycle(_PROXY_LIST) if _PROXY_LIST else None


def _next_proxy():
    return next(_proxy_cycle) if _proxy_cycle else None


def _next_playwright_proxy():
    proxy = _next_proxy()
    if not proxy:
        return None
    parsed = urllib.parse.urlsplit(proxy)
    server = f"{parsed.scheme}://{parsed.hostname}"
    if parsed.port:
        server += f":{parsed.port}"
    result = {"server": server}
    if parsed.username:
        result["username"] = parsed.username
    if parsed.password:
        result["password"] = parsed.password
    return result
{{~ end ~}}

{{~ if hardening.enabled ~}}
# Issue #129 (script hardening): each configured check independently prints
# a warning (script still exits 0) or an error (script exits
# EXIT_HARDENING_FAILED) once scraping is done — lets a script re-run later
# (e.g. via cron, weeks after generation) detect that it silently stopped
# finding anything, instead of writing an empty output file and exiting 0
# as if nothing were wrong.
EXIT_HARDENING_FAILED = 2

HARDENING = {{ hardening.checks_literal }}

{{~ if hardening.has_baseline ~}}
# Issue #131 (baseline check): a small sidecar file next to the script's own
# output records the result count from the last run that passed cleanly
# (see main()'s own "only write when not hardening_failed" call site) — a
# bad run must never become the new normal for the next comparison. Missing/
# corrupt sidecar (first run ever, or the file was deleted) is treated the
# same as "no baseline yet", not an error.
BASELINE_PATH = OUTPUT_PATH + ".hardening-baseline.json"


def _read_baseline():
    try:
        with open(BASELINE_PATH, "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(count):
    with open(BASELINE_PATH, "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)
{{~ end ~}}


def _run_hardening_checks(data):
    has_error = False
    result_count = len(data)
    for check in HARDENING:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = "No data was extracted — at least one selector likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            # Issue #130: catches a field whose selector quietly starts
            # matching the wrong thing (still returns a value, always empty)
            # even though the overall row count stays healthy.
            field = check["field"]
            if result_count == 0:
                continue
            empty = sum(1 for row in data if not str(row.get(field, "")).strip())
            rate = empty / result_count
            if rate > check["threshold"]:
                message = f"Field '{field}': {rate:.0%} of rows are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            # Issue #131: catches a gradual drop in result volume that
            # neither noResult (only fires at exactly zero) nor nullRate
            # (only watches one field) would ever trip — e.g. a paginated
            # list quietly losing entries. No baseline yet (first run, or
            # the sidecar file was deleted) simply has nothing to compare
            # against.
            baseline = _read_baseline()
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error
{{~ end ~}}

SELECTORS = {
{{- for field in fields }}
    "{{ field.name }}": "{{ field.selector }}",
{{- end }}
}

ATTRIBUTES = {
{{- for field in fields }}{{- if field.attribute }}
    "{{ field.name }}": "{{ field.attribute }}",
{{- end }}{{- end }}
}

# Issue #84: per-field post-processing chain (trim/regex extract/replace/
# to-number), applied in order after the raw value is read — see
# _apply_transforms below. Empty list = today's behavior, value unchanged.
TRANSFORMS = {
{{- for field in fields }}
    "{{ field.name }}": {{ field.transforms_literal }},
{{- end }}
}

# A field's own selector is evaluated against the top-level page unless it
# has a FRAME_PATH entry — an ordered list of CSS selectors identifying each
# iframe from the top document down to the frame the field actually lives
# in. Shadow DOM needs no equivalent: Playwright's own selector engine
# pierces open shadow roots automatically for a plain CSS selector.
FRAME_PATHS = {
{{- for field in fields }}{{- if field.frame_path }}
    "{{ field.name }}": [{{ for sel in field.frame_path }}"{{ sel }}"{{ if !for.last }}, {{ end }}{{ end }}],
{{- end }}{{- end }}
}


# Issue #84: best-effort numeric normalization for a "toNumber" transform —
# finds the first numeric-looking substring and normalizes its decimal
# separator to '.', stripping thousands separators/currency symbols. When
# both '.' and ',' appear, the rightmost one is treated as the decimal point
# (handles both "1.234,56" and "1,234.56"); a single separator appearing more
# than once is treated as a thousands separator and stripped; a single
# separator appearing exactly once is treated as the decimal point (so
# "12,99"/"12.99" both work, at the cost of a genuinely ambiguous
# single-occurrence case like "1.234" always being read as 1.234, never as
# 1234 — chain a regex-extract transform first if that's not what's wanted).
# Empty string if nothing numeric is found.
def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Applies a field's ordered transform chain — each step's output feeds the
# next step's input, in the order the user configured them in.
def _apply_transforms(value, transforms):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
    return value


def _resolve_frame_locator(page, frame_path):
    scope = page
    for frame_selector in frame_path:
        scope = scope.frame_locator(frame_selector)
    return scope


# ElementHandle (from query_selector_all) and Locator (from a FrameLocator
# chain) expose the same .text_content()/.get_attribute() methods, so the
# extraction loop below doesn't need to know or care which one it got — only
# resolving "selector string" -> "list of element-like objects" differs.
def _resolve_elements(page, selector, frame_path):
    if not frame_path:
        return page.query_selector_all(selector)
    return _resolve_frame_locator(page, frame_path).locator(selector).all()


# Used by the WaitFor/Fill/Click/Scroll action fragments rendered into the
# scrape() body below (one per playwright_*_step.py.j2 template) — a plain
# page.locator(selector) when frame_path is unset, the same frame-scoped
# Locator _resolve_elements builds otherwise. Page has .locator() too, so
# _resolve_frame_locator(page, []) returning page unchanged already makes
# this uniform without a separate branch here.
def _resolve_locator(page, selector, frame_path):
    return _resolve_frame_locator(page, frame_path or []).locator(selector)


{{~ if change_detection.enabled ~}}
def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(diff_text):
    host = os.environ[SMTP_HOST_ENV_VAR]
    port = int(os.environ[SMTP_PORT_ENV_VAR]) if SMTP_PORT_ENV_VAR else 587
    username = os.environ.get(SMTP_USERNAME_ENV_VAR) if SMTP_USERNAME_ENV_VAR else None
    password = os.environ.get(SMTP_PASSWORD_ENV_VAR) if SMTP_PASSWORD_ENV_VAR else None
    sender = os.environ[NOTIFY_EMAIL_FROM_ENV_VAR]
    recipient = os.environ[NOTIFY_EMAIL_TO_ENV_VAR]

    msg = MIMEText(diff_text)
    msg["Subject"] = "Scraping Factory: changes detected"
    msg["From"] = sender
    msg["To"] = recipient

    # EHLO first so has_extn() actually knows what the server advertises —
    # opportunistic STARTTLS (upgrade only if offered) works against both a
    # real provider and an unauthenticated local/internal relay that never
    # advertises it, without needing the caller to say which kind it is.
    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(diff_text):
    url = os.environ[WEBHOOK_URL_ENV_VAR]
    payload = json.dumps({"subject": "Scraping Factory: changes detected", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


# Best-effort: by the time this runs, the current run's own output has
# already been written successfully — a notification failure (unreachable
# SMTP host, webhook down, ...) is reported but never fails the overall run.
def _notify_change(old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if CHANGE_DETECTION_NOTIFY == "Email":
            _notify_email(diff_text)
        else:
            _notify_webhook(diff_text)
    except Exception as e:
        print(f"Warning: change notification failed: {e}")
{{~ end ~}}


def scrape(url):
    with sync_playwright() as p:
        browser = p.chromium.launch({{ if proxy.enabled }}proxy=_next_playwright_proxy(){{ end }})
        page = browser.new_page()
{{ actions }}

        columns = {name: _resolve_elements(page, sel, FRAME_PATHS.get(name)) for name, sel in SELECTORS.items()}
        n = max((len(v) for v in columns.values()), default=0)

        rows = []
        for i in range(n):
            row = {}
            for name, elements in columns.items():
                if i < len(elements):
                    attr = ATTRIBUTES.get(name)
                    raw_value = (elements[i].get_attribute(attr) or "") if attr else (elements[i].text_content() or "").strip()
                    row[name] = _apply_transforms(raw_value, TRANSFORMS.get(name, []))
                else:
                    row[name] = ""
            rows.append(row)

        browser.close()
        return rows


def main():
{{~ if change_detection.enabled ~}}
    previous_content = _read_previous_output(OUTPUT_PATH)
{{~ end ~}}
    data = []
    for url in URLS:
        data.extend(scrape(url))
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print(f"Done — {len(data)} rows written to {{ output_filename }}.json")
{{~ else ~}}
    with open(OUTPUT_PATH, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(SELECTORS.keys()))
        writer.writeheader()
        writer.writerows(data)
    print(f"Done — {len(data)} rows written to {{ output_filename }}.csv")
{{~ end ~}}
{{~ if change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(data)
{{~ if hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(len(data))
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
