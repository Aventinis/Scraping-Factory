from playwright.sync_api import sync_playwright

URL = "{{ url }}"

SELECTORS = {
{{- for field in fields }}
    "{{ field.name }}": "{{ field.selector }}",
{{- end }}
}

ATTRIBUTES = {
{{- for field in fields }}{{- if field.attribute }}
    "{{ field.name }}": "{{ field.attribute }}",
{{- end }}{{- end }}
}


def scrape(url):
    with sync_playwright() as p:
        browser = p.chromium.launch()
        page = browser.new_page()
{{ actions }}

        columns = {name: page.query_selector_all(sel) for name, sel in SELECTORS.items()}
        n = max((len(v) for v in columns.values()), default=0)

        rows = []
        for i in range(n):
            row = {}
            for name, elements in columns.items():
                if i < len(elements):
                    attr = ATTRIBUTES.get(name)
                    row[name] = (elements[i].get_attribute(attr) or "") if attr else (elements[i].text_content() or "").strip()
                else:
                    row[name] = ""
            rows.append(row)

        browser.close()
        return rows


def main():
    data = scrape(URL)
    with open("output.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(SELECTORS.keys()))
        writer.writeheader()
        writer.writerows(data)
    print(f"Done — {len(data)} rows written to output.csv")


if __name__ == "__main__":
    main()
