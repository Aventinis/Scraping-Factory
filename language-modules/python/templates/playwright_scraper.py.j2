def _extract_page_rows(page):
    # Issue #206 follow-up: see scraper.py.j2's own identical doc comment —
    # a derived (combineFields/splitField) field has no selector of its own
    # and is computed separately below, once per row.
    columns = {name: _resolve_elements(page, sel, FRAME_PATHS.get(name)) for name, sel in SELECTORS.items() if sel}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name in SELECTORS:
            if name not in columns:
                row[name] = _apply_transforms("", TRANSFORMS.get(name, []), row)
                continue
            elements = columns[name]
            if i < len(elements):
                attr = ATTRIBUTES.get(name)
                raw_value = (elements[i].get_attribute(attr) or "") if attr else (elements[i].text_content() or "").strip()
                value = _apply_transforms(raw_value, TRANSFORMS.get(name, []), row)
                # Issue #213/#214: see scraper.py.j2's own identical doc
                # comment — applied after transforms, only ever True for an
                # attribute-mode field (validated upstream).
                if attr and DOWNLOAD.get(name) and value:
                    value = _download_resource(page, value, MAX_DOWNLOAD_SIZE.get(name), ALLOWED_CONTENT_TYPES.get(name))
                row[name] = value
            else:
                row[name] = ""
        rows.append(row)
    return rows


