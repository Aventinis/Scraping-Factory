def main():
{{~ if preflight.enabled ~}}
    preflight_status, preflight_etag, preflight_last_modified = _run_preflight_check(URLS[0])
    if preflight_status == "unreachable":
        sys.exit(EXIT_PREFLIGHT_UNREACHABLE)
    if preflight_status == "unchanged":
        print("Preflight check: no change detected since the last run — skipping.")
        sys.exit(EXIT_PREFLIGHT_UNCHANGED)
{{~ end ~}}
{{~ if change_detection.enabled ~}}
    previous_content = _read_previous_output(OUTPUT_PATH)
{{~ end ~}}
{{~ if discovered_urls.enabled ~}}
    all_urls = list(URLS)
    for discovered_url in _discover_additional_urls():
        if discovered_url not in all_urls:
            all_urls.append(discovered_url)
{{~ else ~}}
    all_urls = URLS
{{~ end ~}}
    data = []
    for url in all_urls:
        data.extend(scrape(url))
{{~ if hardening.enabled ~}}
    data, required_fields_failed = _filter_required_fields(data)
{{~ end ~}}
{{~ if dedup.enabled ~}}
    data, dedup_keys = _dedup_filter_rows(data)
    written_data = _dedup_new_rows(data, dedup_keys)
{{~ else ~}}
    written_data = data
{{~ end ~}}
    # Issue #191: BLUEPRINT_MAPPING, when set, takes over the write-time
    # remap entirely instead of FIELD_OUTPUT_NAMES — it already fully
    # determines the output's column names *and* order, and any source
    # field with no entry in it is dropped rather than written under its
    # own name. Issue #178: otherwise, a no-op remap when no field was
    # renamed via the external config (FIELD_OUTPUT_NAMES is then empty) —
    # `data` itself stays keyed by the original field names throughout
    # either way, since hardening/change detection below still need to look
    # fields up by those original names.
    if BLUEPRINT_MAPPING:
        output_rows = [{m["target"]: row.get(m["source"], "") for m in BLUEPRINT_MAPPING} for row in written_data]
        output_fieldnames = [m["target"] for m in BLUEPRINT_MAPPING]
    else:
        # Issue #206 follow-up: a HiddenFromOutput field is dropped here —
        # at the write-time projection only, same as FIELD_OUTPUT_NAMES —
        # never from `data` itself, which hardening/change detection (and
        # any combineFields/splitField transform referencing it) still need
        # to see under its real name.
        output_rows = [
            {FIELD_OUTPUT_NAMES.get(k, k): v for k, v in row.items() if k not in HIDDEN_FIELD_NAMES}
            for row in written_data
        ]
        output_fieldnames = [FIELD_OUTPUT_NAMES.get(name, name) for name in SELECTORS.keys() if name not in HIDDEN_FIELD_NAMES]
{{~ if dedup.append ~}}
    output_rows = _dedup_with_previous_output(output_rows, output_fieldnames)
{{~ end ~}}
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(output_rows, f, ensure_ascii=False, indent=2)
{{~ else ~}}
    with open(OUTPUT_PATH, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=output_fieldnames)
        writer.writeheader()
        writer.writerows(output_rows)
{{~ end ~}}
    print(f"Done — {{ if dedup.enabled }}{len(output_rows)}{{ else }}{len(data)}{{ end }} rows written to {OUTPUT_PATH}")
{{~ if change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(data) or required_fields_failed
{{~ if hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(len(data))
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if preflight.enabled ~}}
    # Only reached if hardening (when enabled) didn't just sys.exit() above —
    # a run that's about to be flagged as hardening-failed must never
    # advance the preflight state, same "don't let a bad run become the new
    # normal" rule BaselineCheck's own write already follows.
    _write_preflight_state(preflight_etag, preflight_last_modified)
{{~ end ~}}
{{~ if dedup.enabled ~}}
    _dedup_save_state([key for key in dedup_keys if key is not None])
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
