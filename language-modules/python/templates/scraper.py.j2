{{~ if hardening.enabled ~}}
# Issue #129 (script hardening): each configured check independently prints
# a warning (script still exits 0) or an error (script exits
# EXIT_HARDENING_FAILED) once scraping is done — lets a script re-run later
# (e.g. via cron, weeks after generation) detect that it silently stopped
# finding anything, instead of writing an empty output file and exiting 0
# as if nothing were wrong.
EXIT_HARDENING_FAILED = 2

HARDENING = {{ hardening.checks_literal }}

# Issue #132 (blocking-detection check): a snapshot of each request's raw
# response (final URL, body length, body text) is captured in scrape()
# below, independently of the already-extracted data — a blocked response
# can still produce a non-empty (but garbage) result that passes
# noResult/nullRate. Populated even when no "blocking" check is configured;
# the runtime cost of appending an already-in-memory string is negligible.
_BLOCKING_RESPONSES = []

{{~ if hardening.has_baseline ~}}
# Issue #131 (baseline check): a small sidecar file next to the script's own
# output records the result count from the last run that passed cleanly
# (see main()'s own "only write when not hardening_failed" call site) — a
# bad run must never become the new normal for the next comparison. Missing/
# corrupt sidecar (first run ever, or the file was deleted) is treated the
# same as "no baseline yet", not an error.
BASELINE_PATH = OUTPUT_PATH + ".hardening-baseline.json"


def _read_baseline():
    try:
        with open(BASELINE_PATH, "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(count):
    with open(BASELINE_PATH, "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)
{{~ end ~}}


def _run_hardening_checks(data):
    has_error = False
    result_count = len(data)
    for check in HARDENING:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = "No data was extracted — at least one selector likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            # Issue #130: catches a field whose selector quietly starts
            # matching the wrong thing (still returns a value, always empty)
            # even though the overall row count stays healthy.
            field = check["field"]
            if result_count == 0:
                continue
            empty = sum(1 for row in data if not str(row.get(field, "")).strip())
            rate = empty / result_count
            if rate > check["threshold"]:
                message = f"Field '{field}': {rate:.0%} of rows are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            # Issue #131: catches a gradual drop in result volume that
            # neither noResult (only fires at exactly zero) nor nullRate
            # (only watches one field) would ever trip — e.g. a paginated
            # list quietly losing entries. No baseline yet (first run, or
            # the sidecar file was deleted) simply has nothing to compare
            # against.
            baseline = _read_baseline()
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "blocking":
            # Issue #132: three signals, all evaluated per captured response
            # — a redirect to a different host (always checked), a body
            # shorter than minBodyLength (skipped when None), and a
            # case-insensitive match against blockPhrases.
            for entry in _BLOCKING_RESPONSES:
                reasons = []
                if urlsplit(entry["url"]).netloc != urlsplit(entry["final_url"]).netloc:
                    reasons.append(f"redirected to a different host ({entry['final_url']})")
                if check["minBodyLength"] is not None and entry["length"] < check["minBodyLength"]:
                    reasons.append(f"response body is only {entry['length']} bytes (minimum: {check['minBodyLength']})")
                matched_phrases = [p for p in check["blockPhrases"] if p.lower() in entry["text"].lower()]
                if matched_phrases:
                    reasons.append(f"matched block phrase(s): {', '.join(matched_phrases)}")
                if reasons:
                    message = f"Possible blocking detected for {entry['url']}: {'; '.join(reasons)}."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error


# Issue #133: unlike _run_hardening_checks above (a post-hoc pass over
# already-final data), this changes what actually gets written — called
# from main() before the output file is written, not after. Filtering
# always happens regardless of severity; only whether the run itself is
# flagged as failed depends on it, so an all-Warning configuration still
# guarantees the output file never contains a row missing a required
# value, without necessarily failing the whole run.
def _filter_required_fields(data):
    check = next((c for c in HARDENING if c["kind"] == "requiredFields"), None)
    if check is None:
        return data, False
    total = len(data)
    filtered = [row for row in data if all(str(row.get(name, "")).strip() for name in check["fieldNames"])]
    dropped = total - len(filtered)
    if dropped == 0:
        return filtered, False
    message = f"Dropped {dropped} of {total} row(s) missing a required field."
    if check["severity"] == "Error":
        print(f"ERROR: {message}", file=sys.stderr)
        return filtered, True
    print(f"WARNING: {message}", file=sys.stderr)
    return filtered, False
{{~ end ~}}

