# Generated by Scraping Factory
# Target: {{ config.url }}
# Fields: {{ for field in config.fields }}{{ field.name }}{{ if !for.last }}, {{ end }}{{ end }}
# Run:    python scraper.py

import csv
import requests
from bs4 import BeautifulSoup

URL = "{{ config.url }}"

SELECTORS = {
{{- for field in config.fields }}
    "{{ field.name }}": "{{ field.selector }}",
{{- end }}
}

ATTRIBUTES = {
{{- for field in config.fields }}{{- if field.attribute }}
    "{{ field.name }}": "{{ field.attribute }}",
{{- end }}{{- end }}
}


def scrape(url):
    response = requests.get(url, timeout=10)
    response.raise_for_status()
    # Use response.content (bytes) instead of response.text: requests guesses
    # the encoding from the Content-Type header, defaulting to ISO-8859-1 when
    # no charset is given — which mangles UTF-8 pages that only declare their
    # charset via <meta charset>. BeautifulSoup detects that meta tag itself.
    soup = BeautifulSoup(response.content, "html.parser")

    columns = {name: soup.select(sel) for name, sel in SELECTORS.items()}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name, elements in columns.items():
            if i < len(elements):
                attr = ATTRIBUTES.get(name)
                row[name] = elements[i].get(attr, "").strip() if attr else elements[i].get_text(strip=True)
            else:
                row[name] = ""
        rows.append(row)
    return rows


def main():
    data = scrape(URL)
    with open("output.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(SELECTORS.keys()))
        writer.writeheader()
        writer.writerows(data)
    print(f"Done — {len(data)} rows written to output.csv")


if __name__ == "__main__":
    main()
