# Issue #84: best-effort numeric normalization for a "toNumber" transform —
# finds the first numeric-looking substring and normalizes its decimal
# separator to '.', stripping thousands separators/currency symbols. When
# both '.' and ',' appear, the rightmost one is treated as the decimal point
# (handles both "1.234,56" and "1,234.56"); a single separator appearing more
# than once is treated as a thousands separator and stripped; a single
# separator appearing exactly once is treated as the decimal point (so
# "12,99"/"12.99" both work, at the cost of a genuinely ambiguous
# single-occurrence case like "1.234" always being read as 1.234, never as
# 1234 — chain a regex-extract transform first if that's not what's wanted).
# Empty string if nothing numeric is found.
def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Issue #205: safe, explicit type-conversion transforms -- unlike toNumber's
# best-effort heuristic extraction, these either produce a well-formed value
# or fall back to their own clearly defined "onError" behavior
# ("KeepOriginal" leaves the pre-conversion value untouched, "UseDefault"
# substitutes the transform's own configured "defaultValue") rather than
# silently guessing.
_DATE_FORMAT_TOKEN_PATTERNS = {"yyyy": r"(?P<yyyy>\d{4})", "mm": r"(?P<mm>\d{1,2})", "dd": r"(?P<dd>\d{1,2})"}


def _type_conversion_fallback(value, on_error, default_value):
    return default_value if on_error == "UseDefault" else value


def _to_integer(value, on_error, default_value):
    stripped = value.strip()
    if re.fullmatch(r"[+-]?\d+", stripped):
        return str(int(stripped))
    return _type_conversion_fallback(value, on_error, default_value)


def _to_boolean(value, on_error, default_value):
    normalized = value.strip().lower()
    if normalized in ("true", "1", "yes", "y"):
        return "True"
    if normalized in ("false", "0", "no", "n"):
        return "False"
    return _type_conversion_fallback(value, on_error, default_value)


# source_format is the same "{yyyy}"/"{mm}"/"{dd}" mini-template
# RangeSource.Format (RangeFormat.cs) already uses for ISO week/date
# parameters, compiled into a regex the same way (escape the literal
# template, then substitute each placeholder for its own capture group) so a
# format string valid on the companion side parses identically here. Also
# rejects a structurally-matching but non-existent calendar date (e.g.
# "2026-02-30") via date()'s own ValueError, not just a pattern match.
def _to_date(value, source_format, on_error, default_value):
    pattern = re.escape(source_format)
    for token, token_pattern in _DATE_FORMAT_TOKEN_PATTERNS.items():
        pattern = pattern.replace(re.escape("{" + token + "}"), token_pattern)
    match = re.fullmatch(pattern, value.strip())
    if match:
        try:
            return date(int(match.group("yyyy")), int(match.group("mm")), int(match.group("dd"))).isoformat()
        except ValueError:
            pass
    return _type_conversion_fallback(value, on_error, default_value)


# Applies a field's ordered transform chain — each step's output feeds the
# next step's input, in the order the user configured them in.
# Issue #206: looks up another field's own already-computed value for
# CombineFieldsTransform/SplitFieldTransform. `siblings` is whatever
# representation the calling shape already has on hand at this point in
# extraction — a plain dict for flat/API-flat mode's in-progress row, or the
# in-construction parent ET.Element for container/API-tree mode (only that
# element's own direct children are considered, i.e. only siblings under the
# very same immediate parent group — see ScrapingPlanValidator's
# ValidateFieldTransformOrdering for why this is guaranteed to already be
# populated for a valid config). Missing/not-yet-computed simply resolves to
# "" rather than raising, the same "don't fail the whole row/element over
# one field" spirit every other transform here already follows.
def _resolve_transform_sibling(siblings, name):
    if siblings is None:
        return ""
    if isinstance(siblings, dict):
        return siblings.get(name, "")
    found = siblings.find(name)
    return (found.text or "") if found is not None else ""


def _apply_transforms(value, transforms, siblings=None):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
        elif kind == "toInteger":
            value = _to_integer(value, t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
        elif kind == "toBoolean":
            value = _to_boolean(value, t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
        elif kind == "toDate":
            value = _to_date(value, t.get("sourceFormat", "{yyyy}-{mm}-{dd}"), t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
        elif kind == "combineFields":
            value = t.get("separator", " ").join(_resolve_transform_sibling(siblings, n) for n in t.get("sourceFieldNames", []))
        elif kind == "splitField":
            parts = _resolve_transform_sibling(siblings, t.get("sourceFieldName", "")).split(t.get("separator", " "))
            idx = t.get("index", 0)
            value = parts[idx] if 0 <= idx < len(parts) else ""
    return value


{{~ if config.change_detection.enabled ~}}
def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(diff_text):
    host = os.environ[SMTP_HOST_ENV_VAR]
    port = int(os.environ[SMTP_PORT_ENV_VAR]) if SMTP_PORT_ENV_VAR else 587
    username = os.environ.get(SMTP_USERNAME_ENV_VAR) if SMTP_USERNAME_ENV_VAR else None
    password = os.environ.get(SMTP_PASSWORD_ENV_VAR) if SMTP_PASSWORD_ENV_VAR else None
    sender = os.environ[NOTIFY_EMAIL_FROM_ENV_VAR]
    recipient = os.environ[NOTIFY_EMAIL_TO_ENV_VAR]

    msg = MIMEText(diff_text)
    msg["Subject"] = "Scraping Factory: changes detected"
    msg["From"] = sender
    msg["To"] = recipient

    # EHLO first so has_extn() actually knows what the server advertises —
    # opportunistic STARTTLS (upgrade only if offered) works against both a
    # real provider and an unauthenticated local/internal relay that never
    # advertises it, without needing the caller to say which kind it is.
    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(diff_text):
    url = os.environ[WEBHOOK_URL_ENV_VAR]
    payload = json.dumps({"subject": "Scraping Factory: changes detected", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


# Best-effort: by the time this runs, the current run's own output has
# already been written successfully — a notification failure (unreachable
# SMTP host, webhook down, ...) is reported but never fails the overall run.
def _notify_change(old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if CHANGE_DETECTION_NOTIFY == "Email":
            _notify_email(diff_text)
        else:
            _notify_webhook(diff_text)
    except Exception as e:
        print(f"Warning: change notification failed: {e}")
{{~ end ~}}


def _extract_page_rows(soup, base_url):
    # Issue #206 follow-up: a field derived from a combineFields/splitField
    # transform has no selector of its own (SELECTORS[name] == "") — it's
    # excluded from the selector-match zip below and instead computed once
    # per row, in SELECTORS' own declaration order, from whatever sibling
    # values are already in `row` by that point.
    columns = {name: soup.select(sel) for name, sel in SELECTORS.items() if sel}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name in SELECTORS:
            if name not in columns:
                row[name] = _apply_transforms("", TRANSFORMS.get(name, []), row)
                continue
            elements = columns[name]
            if i < len(elements):
                attr = ATTRIBUTES.get(name)
                raw_value = elements[i].get(attr, "").strip() if attr else elements[i].get_text(strip=True)
                value = _apply_transforms(raw_value, TRANSFORMS.get(name, []), row)
                # Issue #213/#214: replaces the raw URL with its own
                # downloaded local file path — applied AFTER transforms, the
                # same order the container-mode templates already use. Only
                # ever True for an attribute-mode field (validated upstream).
                if attr and DOWNLOAD.get(name) and value:
                    value = _download_resource(value, base_url, MAX_DOWNLOAD_SIZE.get(name), ALLOWED_CONTENT_TYPES.get(name))
                row[name] = value
            else:
                row[name] = ""
        rows.append(row)
    return rows


{{~ if config.preflight.enabled ~}}
# Issue #219: a single cheap HEAD request against the primary start URL, run
# before the main extraction phase even starts — a target that hasn't
# changed since the last successful run (same ETag/Last-Modified) or isn't
# reachable at all doesn't need the full cost of a real scrape. Not every
# target reliably sends useful ETag/Last-Modified headers — when neither is
# present (or they differ from the stored value, or there's no stored value
# yet), the check can't tell "changed" from "unchanged" at all, so it
# conservatively falls through to a normal run rather than risk silently
# never updating stale data. Missing/corrupt sidecar (first run ever, or the
# file was deleted) is treated the same as "no previous state yet".
PREFLIGHT_STATE_PATH = OUTPUT_PATH + ".preflight-state.json"
EXIT_PREFLIGHT_UNCHANGED = 4
EXIT_PREFLIGHT_UNREACHABLE = 5


def _read_preflight_state():
    try:
        with open(PREFLIGHT_STATE_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except (FileNotFoundError, ValueError, OSError):
        return {}


def _write_preflight_state(etag, last_modified):
    with open(PREFLIGHT_STATE_PATH, "w", encoding="utf-8") as f:
        json.dump({"etag": etag, "lastModified": last_modified}, f)


# Returns (status, etag, last_modified) — status is "unreachable" (the
# request itself failed or came back with an error status), "unchanged" (a
# response header matches the value stored from the last successful run),
# or "proceed" (no comparable header, no previous state yet, or the value
# differs — the main run should go ahead as normal).
def _run_preflight_check(url):
    try:
        response = requests.head(url, headers=HEADERS, {{ if config.proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10, allow_redirects=True)
        response.raise_for_status()
    except Exception as e:
        print(f"ERROR: Preflight check failed — target is unreachable: {url} ({e})", file=sys.stderr)
        return "unreachable", None, None

    etag = response.headers.get("ETag")
    last_modified = response.headers.get("Last-Modified")
    previous = _read_preflight_state()
    if etag and previous.get("etag") == etag:
        return "unchanged", etag, last_modified
    if not etag and last_modified and previous.get("lastModified") == last_modified:
        return "unchanged", etag, last_modified
    return "proceed", etag, last_modified
{{~ end ~}}


{{~ if config.discovered_urls.enabled ~}}
# Issue #218: fetches DISCOVERED_URLS_PAGE_URL and harvests every distinct
# href matching DISCOVERED_URLS_LINK_SELECTOR, resolved to an absolute URL
# via urljoin against the page it was found on, capped at DISCOVERED_URLS_MAX
# (order of appearance, not sorted) — a misconfigured selector matching an
# entire sitemap/nav tree shouldn't silently balloon a run to thousands of
# pages. Deliberately plain requests+BeautifulSoup, never whatever engine the
# main scrape itself uses — the same "discovery doesn't need the full
# machinery of the main run" precedent DiscoverySource/BrowserDiscoverySource
# already established for API mode. A failed fetch/parse is a warning, not a
# crash — the main run still proceeds with URLS/AdditionalUrls as already
# configured, the same "degrade, don't crash" treatment a failed Download
# already gets.
def _discover_additional_urls():
    try:
        response = requests.get(DISCOVERED_URLS_PAGE_URL, headers=HEADERS, {{ if config.proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10)
        response.raise_for_status()
        soup = BeautifulSoup(response.content, "html.parser")
    except Exception as e:
        print(f"WARNING: Could not discover additional URLs from {DISCOVERED_URLS_PAGE_URL}: {e}")
        return []

    discovered = []
    for el in soup.select(DISCOVERED_URLS_LINK_SELECTOR):
        href = el.get("href")
        if not href:
            continue
        absolute_url = urljoin(DISCOVERED_URLS_PAGE_URL, href)
        if absolute_url not in discovered:
            discovered.append(absolute_url)
        if len(discovered) >= DISCOVERED_URLS_MAX:
            break
    return discovered
{{~ end ~}}


def scrape(url):
    rows = []
    page_number = 1
    page_url = url
    while page_url:
        response = requests.get(page_url, headers=HEADERS, {{ if config.proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10)
        response.raise_for_status()
{{~ if config.hardening.enabled ~}}
        _BLOCKING_RESPONSES.append({"url": page_url, "final_url": response.url, "length": len(response.content), "text": response.text})
{{~ end ~}}
        # Use response.content (bytes) instead of response.text: requests
        # guesses the encoding from the Content-Type header, defaulting to
        # ISO-8859-1 when no charset is given — which mangles UTF-8 pages
        # that only declare their charset via <meta charset>. BeautifulSoup
        # detects that meta tag itself.
        soup = BeautifulSoup(response.content, "html.parser")
        page_rows = _extract_page_rows(soup, response.url)
        if not page_rows:
            break
        rows.extend(page_rows)

{{~ if config.pagination.enabled ~}}
        if page_number >= PAGINATION_MAX_PAGES:
            break
        page_number += 1
{{~ if config.pagination.kind == "nextLink" ~}}
        next_tag = soup.select_one(PAGINATION_NEXT_LINK_SELECTOR)
        next_href = next_tag.get("href") if next_tag else None
        page_url = urljoin(page_url, next_href) if next_href else None
{{~ else ~}}
        page_url = PAGINATION_URL_TEMPLATE.format(url=url, page=page_number)
{{~ end ~}}
{{~ else ~}}
        page_url = None
{{~ end ~}}
    return rows


def main():
{{~ if config.preflight.enabled ~}}
    preflight_status, preflight_etag, preflight_last_modified = _run_preflight_check(URLS[0])
    if preflight_status == "unreachable":
        sys.exit(EXIT_PREFLIGHT_UNREACHABLE)
    if preflight_status == "unchanged":
        print("Preflight check: no change detected since the last run — skipping.")
        sys.exit(EXIT_PREFLIGHT_UNCHANGED)
{{~ end ~}}
{{~ if config.change_detection.enabled ~}}
    previous_content = _read_previous_output(OUTPUT_PATH)
{{~ end ~}}
{{~ if config.discovered_urls.enabled ~}}
    all_urls = list(URLS)
    for discovered_url in _discover_additional_urls():
        if discovered_url not in all_urls:
            all_urls.append(discovered_url)
{{~ else ~}}
    all_urls = URLS
{{~ end ~}}
    data = []
    for url in all_urls:
        data.extend(scrape(url))
{{~ if config.hardening.enabled ~}}
    data, required_fields_failed = _filter_required_fields(data)
{{~ end ~}}
    # Issue #191: BLUEPRINT_MAPPING, when set, takes over the write-time
    # remap entirely instead of FIELD_OUTPUT_NAMES — it already fully
    # determines the output's column names *and* order, and any source
    # field with no entry in it is dropped rather than written under its
    # own name. Issue #178: otherwise, a no-op remap when no field was
    # renamed via the external config (FIELD_OUTPUT_NAMES is then empty) —
    # `data` itself stays keyed by the original field names throughout
    # either way, since hardening/change detection below still need to look
    # fields up by those original names.
    if BLUEPRINT_MAPPING:
        output_rows = [{m["target"]: row.get(m["source"], "") for m in BLUEPRINT_MAPPING} for row in data]
        output_fieldnames = [m["target"] for m in BLUEPRINT_MAPPING]
    else:
        # Issue #206 follow-up: a HiddenFromOutput field is dropped here —
        # at the write-time projection only, same as FIELD_OUTPUT_NAMES —
        # never from `data` itself, which hardening/change detection (and
        # any combineFields/splitField transform referencing it) still need
        # to see under its real name.
        output_rows = [
            {FIELD_OUTPUT_NAMES.get(k, k): v for k, v in row.items() if k not in HIDDEN_FIELD_NAMES}
            for row in data
        ]
        output_fieldnames = [FIELD_OUTPUT_NAMES.get(name, name) for name in SELECTORS.keys() if name not in HIDDEN_FIELD_NAMES]
{{~ if config.output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(output_rows, f, ensure_ascii=False, indent=2)
{{~ else ~}}
    with open(OUTPUT_PATH, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=output_fieldnames)
        writer.writeheader()
        writer.writerows(output_rows)
{{~ end ~}}
    print(f"Done — {len(data)} rows written to {OUTPUT_PATH}")
{{~ if config.change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if config.hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(data) or required_fields_failed
{{~ if config.hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(len(data))
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if config.preflight.enabled ~}}
    # Only reached if hardening (when enabled) didn't just sys.exit() above —
    # a run that's about to be flagged as hardening-failed must never
    # advance the preflight state, same "don't let a bad run become the new
    # normal" rule BaselineCheck's own write already follows.
    _write_preflight_state(preflight_etag, preflight_last_modified)
{{~ end ~}}
{{~ if config.proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
