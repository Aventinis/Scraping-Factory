# Fields: {{ for field in config.fields }}{{ field.name }}{{ if !for.last }}, {{ end }}{{ end }}
# Run:    python {{ config.script_filename }}.py

{{~ if config.output_is_json ~}}
import json
{{~ else ~}}
import csv
{{~ end ~}}
import re
import requests
from bs4 import BeautifulSoup

URL = "{{ config.url }}"

# Many sites (Wikipedia among them) reject the bare "python-requests/x.y"
# default User-Agent with 403 Forbidden — an honest, identifying UA (not a
# spoofed browser) is enough to pass that check on most sites.
HEADERS = {"User-Agent": "Mozilla/5.0 (compatible; ScrapingFactory/1.0; +https://github.com/Aventinis/Scraping-Factory)"}

SELECTORS = {
{{- for field in config.fields }}
    "{{ field.name }}": "{{ field.selector }}",
{{- end }}
}

ATTRIBUTES = {
{{- for field in config.fields }}{{- if field.attribute }}
    "{{ field.name }}": "{{ field.attribute }}",
{{- end }}{{- end }}
}

# Issue #84: per-field post-processing chain (trim/regex extract/replace/
# to-number), applied in order after the raw value is read — see
# _apply_transforms below. Empty list = today's behavior, value unchanged.
TRANSFORMS = {
{{- for field in config.fields }}
    "{{ field.name }}": {{ field.transforms_literal }},
{{- end }}
}


# Issue #84: best-effort numeric normalization for a "toNumber" transform —
# finds the first numeric-looking substring and normalizes its decimal
# separator to '.', stripping thousands separators/currency symbols. When
# both '.' and ',' appear, the rightmost one is treated as the decimal point
# (handles both "1.234,56" and "1,234.56"); a single separator appearing more
# than once is treated as a thousands separator and stripped; a single
# separator appearing exactly once is treated as the decimal point (so
# "12,99"/"12.99" both work, at the cost of a genuinely ambiguous
# single-occurrence case like "1.234" always being read as 1.234, never as
# 1234 — chain a regex-extract transform first if that's not what's wanted).
# Empty string if nothing numeric is found.
def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Applies a field's ordered transform chain — each step's output feeds the
# next step's input, in the order the user configured them in.
def _apply_transforms(value, transforms):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
    return value


def scrape(url):
    response = requests.get(url, headers=HEADERS, timeout=10)
    response.raise_for_status()
    # Use response.content (bytes) instead of response.text: requests guesses
    # the encoding from the Content-Type header, defaulting to ISO-8859-1 when
    # no charset is given — which mangles UTF-8 pages that only declare their
    # charset via <meta charset>. BeautifulSoup detects that meta tag itself.
    soup = BeautifulSoup(response.content, "html.parser")

    columns = {name: soup.select(sel) for name, sel in SELECTORS.items()}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name, elements in columns.items():
            if i < len(elements):
                attr = ATTRIBUTES.get(name)
                raw_value = elements[i].get(attr, "").strip() if attr else elements[i].get_text(strip=True)
                row[name] = _apply_transforms(raw_value, TRANSFORMS.get(name, []))
            else:
                row[name] = ""
        rows.append(row)
    return rows


def main():
    data = scrape(URL)
{{~ if config.output_is_json ~}}
    with open("{{ config.output_filename }}.json", "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print(f"Done — {len(data)} rows written to {{ config.output_filename }}.json")
{{~ else ~}}
    with open("{{ config.output_filename }}.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(SELECTORS.keys()))
        writer.writeheader()
        writer.writerows(data)
    print(f"Done — {len(data)} rows written to {{ config.output_filename }}.csv")
{{~ end ~}}


if __name__ == "__main__":
    main()
