# Issue #192: optional Output Blueprint field mapping. Unlike Container-Mode
# (scraper_grouped.py.j2), there's no OutputBlueprintFlattening call on the
# companion side proving upfront that the mapped fields resolve to one
# unambiguous row layout — ApiGroup has no explicit "repeating" flag
# (Architecture Decision #6), so whether a node actually repeats is only
# known once the real JSON response is resolved here, at run time. See
# _flatten_api_group_for_blueprint below for the runtime mirror of that same
# check, which raises a RuntimeError instead (surfacing as an ordinary 422
# trial-run verification failure) when it finds a conflict.
BLUEPRINT_MAPPING = {{ blueprint_mapping_literal }}
BLUEPRINT_MAPPING_BY_SOURCE = {m["source"]: m["target"] for m in BLUEPRINT_MAPPING}
_blueprint_resolved_chain = None  # None until the first repeating+relevant group is found


def _blueprint_subtree_has_mapped_field(node):
    if "children" in node:
        return any(_blueprint_subtree_has_mapped_field(child) for child in node["children"])
    return node["name"] in BLUEPRINT_MAPPING_BY_SOURCE


def _blueprint_chain_prefix_match(a, b):
    n = min(len(a), len(b))
    return a[:n] == b[:n]


# Runtime mirror of the companion's own OutputBlueprintFlattening.
# ResolveContainerRowScope + _flatten_group_tree_for_blueprint in one pass
# (see scraper_grouped.py.j2's identical-in-spirit walker for the full
# "always returns a list of context dicts" design) — the one difference is
# that "is this node repeating" has to be resolved dynamically here
# (mirroring _extract_api_group's own _is_repeating_instance check) instead
# of being read off a static config flag, and the "do the mapped fields
# share one ancestor chain" check has to happen incrementally as that
# repeating-ness is discovered, tracked via the module-level
# _blueprint_resolved_chain across every call (including separate parameter
# combinations/requests within the same run).
#
# Issue #206 note: same as scraper_grouped.py.j2's own
# _resolve_flatten_leaf_value — there's no in-construction sibling element
# to resolve a combineFields/splitField transform's own reference against
# here, so it resolves to "" for a Blueprint-mapped field. Out of scope for
# this first version, same as Download already is for Blueprint flattening.
def _flatten_api_group_for_blueprint(scope, node, context, repeating_ancestors):
    global _blueprint_resolved_chain
    if "children" in node:
        if not _blueprint_subtree_has_mapped_field(node):
            return [context]

        raw_matches = _resolve_json_path(scope, node["path"])
        is_repeating = bool(raw_matches) and all(isinstance(v, list) for v in raw_matches)
        instances = _resolve_items(scope, node["path"])

        next_ancestors = repeating_ancestors
        if is_repeating:
            this_chain = repeating_ancestors + [node["name"]]
            if _blueprint_resolved_chain is None:
                _blueprint_resolved_chain = this_chain
            elif not _blueprint_chain_prefix_match(this_chain, _blueprint_resolved_chain):
                raise RuntimeError(
                    "Output Blueprint: the mapped fields span more than one independent repeating group "
                    f"('{this_chain[-1]}' and '{_blueprint_resolved_chain[-1]}' are not on the same nesting "
                    "path) — there is no single row layout that would include every mapped field without "
                    "either duplicating rows or dropping data. Map fields from only one repeating branch."
                )
            elif len(this_chain) > len(_blueprint_resolved_chain):
                _blueprint_resolved_chain = this_chain
            next_ancestors = this_chain

        all_contexts = []
        for instance in instances:
            instance_contexts = [context]
            for child in node["children"]:
                next_contexts = []
                for ctx in instance_contexts:
                    next_contexts.extend(_flatten_api_group_for_blueprint(instance, child, ctx, next_ancestors))
                instance_contexts = next_contexts
            all_contexts.extend(instance_contexts)
        return all_contexts

    value = _resolve_field(scope, node["path"])
    if node["name"] in BLUEPRINT_MAPPING_BY_SOURCE:
        resolved = "" if value is None else _apply_transforms(str(value), node["transform"])
        return [{**context, node["name"]: resolved}]
    return [context]


# Issue #244: a second, tree-shaped Output Blueprint target schema — the
# API-tree mirror of scraper_grouped.py.j2's own BLUEPRINT_TREE_MAPPING/
# _build_blueprint_node (see its doc comments for the full design
# reasoning). Unlike Container-Mode, ApiGroup has no explicit Repeating flag
# (Architecture Decision #6) — whether a given ancestor group is actually
# repeating can only be known once the real JSON response is resolved, so
# _blueprint_resolve_leaf_chain below determines it dynamically (mirroring
# _extract_api_group's own _is_repeating_instance check) instead of reading
# a static flag, and _blueprint_resolve_group_chain raises RuntimeError on
# conflict — the same 422-trial-run-failure precedent BLUEPRINT_MAPPING's
# own runtime ambiguity check already established for this exact static-vs-
# runtime asymmetry, only now scoped to one target group's own direct
# fields at a time instead of the whole mapping (a tree target's own
# nesting is what confines a genuine conflict to one branch instead of the
# whole request — Issue #244's own resolution of #192's open question).
# A field nested under the wrong target group entirely (not actually
# reachable from that group's own resolved scope at all) isn't separately
# detected here — Container-Mode's own equivalent case gets a dedicated
# generate-time check (OutputBlueprintFlattening.
# ResolveContainerTreeRowScopes) precisely because it CAN be checked
# statically there; no such check exists for this shape, so a badly nested
# mapping here simply resolves to a missing/empty value at runtime instead
# of a clear error.
BLUEPRINT_TREE_MAPPING = {{ blueprint_tree_mapping_literal }}

_BLUEPRINT_GROUP_BY_NAME = {}
_BLUEPRINT_LEAF_BY_NAME = {}
_BLUEPRINT_PATH_BY_NAME = {}


def _blueprint_index_source_tree(nodes, ancestors):
    for node in nodes:
        if "children" in node:
            _BLUEPRINT_GROUP_BY_NAME.setdefault(node["name"], node)
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _blueprint_index_source_tree(node["children"], ancestors + [node])
        else:
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _BLUEPRINT_LEAF_BY_NAME.setdefault(node["name"], node)


_blueprint_index_source_tree(GROUPS, [])


# The FULL structural ancestor path (purely from the static GROUPS shape,
# no data involved) plus, when `name` itself names a group, that group's own
# node appended last — same meaning as scraper_grouped.py.j2's identical
# helper. Which of these ancestors actually turn out to be repeating is
# resolved separately, dynamically, by _blueprint_resolve_leaf_chain below.
def _blueprint_full_path(name):
    ancestors = _BLUEPRINT_PATH_BY_NAME.get(name, [])
    group = _BLUEPRINT_GROUP_BY_NAME.get(name)
    return ancestors + [group] if group is not None else ancestors


def _blueprint_walk_suffix(scopes, suffix):
    for group in suffix:
        next_scopes = []
        for scope in scopes:
            next_scopes.extend(_resolve_items(scope, group["path"]))
        scopes = next_scopes
    return scopes


# Walks `suffix` from `scope` one group at a time — using the first resolved
# instance to continue deeper, the same "resolved once, applies globally"
# pragmatism BLUEPRINT_MAPPING's own runtime chain resolution already
# accepts — returning the names among `suffix` that resolved as repeating.
# The dynamic, per-scope counterpart of scraper_grouped.py.j2's static
# _blueprint_repeating_chain lookup.
def _blueprint_resolve_leaf_chain(scope, suffix):
    chain = []
    current = scope
    for group in suffix:
        raw = _resolve_json_path(current, group["path"])
        if raw and all(isinstance(v, list) for v in raw):
            chain.append(group["name"])
        instances = _resolve_items(current, group["path"])
        if not instances:
            break
        current = instances[0]
    return chain


# Resolves this target group's own row scope exactly like
# scraper_grouped.py.j2's own _blueprint_resolve_group_chain — the deepest
# repeating source ancestor its direct leaf fields agree on, falling back to
# ancestor_chain when none of them add further nesting — but, unlike that
# static version, actually walks `scope` to find out, and raises on
# conflict instead of trusting a generate-time guarantee that doesn't exist
# for this shape (see this section's own doc comment above).
def _blueprint_resolve_group_chain(scope, ancestor_chain, ancestor_full_path, target_children):
    chains = []
    for source_name in (c["source"] for c in target_children if "source" in c):
        suffix = _blueprint_full_path(source_name)[len(ancestor_full_path):]
        chains.append(ancestor_chain + _blueprint_resolve_leaf_chain(scope, suffix))

    deeper = [c for c in chains if len(c) > len(ancestor_chain)]
    if not deeper:
        return ancestor_chain

    winner = max(deeper, key=len)
    for chain in deeper:
        if not (len(chain) <= len(winner) and winner[:len(chain)] == chain):
            raise RuntimeError(
                "Output Blueprint: the mapped fields under one target group span more than one independent "
                f"repeating group ('{chain[-1]}' and '{winner[-1]}' are not on the same nesting path) — there "
                "is no single row layout that would include every mapped field without either duplicating "
                "rows or dropping data. Nest them under separate target groups instead."
            )
    return winner


# See scraper_grouped.py.j2's identical-in-spirit _build_blueprint_node for
# the full design reasoning (list for a target group, single Element for a
# target leaf; `top_scope` resolves a "broadcast" field — one with no
# repeating source ancestor anywhere in its lineage — independently of the
# current recursion depth). Issue #206 note: same as
# _flatten_api_group_for_blueprint above — no sibling element to resolve a
# combineFields/splitField transform against here.
def _build_blueprint_node(top_scope, scope, ancestor_chain, ancestor_full_path, target_node):
    if "children" in target_node:
        row_chain = _blueprint_resolve_group_chain(scope, ancestor_chain, ancestor_full_path, target_node["children"])
        full_path = _blueprint_full_path(row_chain[-1]) if row_chain else ancestor_full_path
        instances = _blueprint_walk_suffix([scope], full_path[len(ancestor_full_path):])

        elements = []
        for instance in instances:
            el = ET.Element(target_node["name"])
            for child in target_node["children"]:
                result = _build_blueprint_node(top_scope, instance, row_chain, full_path, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            elements.append(el)
        return elements

    source_name = target_node["source"]
    leaf_node = _BLUEPRINT_LEAF_BY_NAME[source_name]
    full_path = _blueprint_full_path(source_name)
    global_chain = _blueprint_resolve_leaf_chain(top_scope, full_path)
    if global_chain:
        scopes = _blueprint_walk_suffix([scope], full_path[len(ancestor_full_path):])
    else:
        # Broadcast: this field has no repeating source ancestor anywhere in
        # its lineage, so it's resolved relative to the whole response, not
        # wherever the current target group instance happens to be.
        scopes = _blueprint_walk_suffix([top_scope], full_path)

    resolved = scopes[0] if scopes else None
    value = None if resolved is None else _resolve_field(resolved, leaf_node["path"])
    el = ET.Element(target_node["name"])
    el.text = "" if value is None else _apply_transforms(str(value), leaf_node["transform"])
    return el


def _build_blueprint_tree(top_scope, target_roots):
    elements = []
    for target_node in target_roots:
        result = _build_blueprint_node(top_scope, top_scope, [], [], target_node)
        if isinstance(result, list):
            elements.extend(result)
        else:
            elements.append(result)
    return elements

