# Discovery requests reuse the main HEADERS (e.g. an auth token) since a
# discovery endpoint is typically part of the same API as the main request.
# `combo` holds every earlier-declared parameter's own already-resolved
# value (Issue #217) — substituted into a discovery/browserDiscovery
# source's own template before it's used, so e.g. a category-scoped
# discovery endpoint resolves against this specific run's category.
def _resolve_parameter_values(source, headers, parameter_name, combo):
    kind = source["kind"]
    if kind == "staticList":
        return list(source["values"])
    if kind == "range":
        range_type = source["type"]
        if range_type == "IsoWeek":
            return _iso_week_range(source["from"], source["to"], source.get("format", _DEFAULT_ISO_WEEK_FORMAT))
        if range_type == "Date":
            return _date_range(source["from"], source["to"], source.get("format", _DEFAULT_DATE_FORMAT))
        return _number_range(source["from"], source["to"])
    if kind == "discovery":
        url_template = _substitute_known_parameters(source["urlTemplate"], combo)
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _checked_request("Discovery request", url_template, lambda: _send_with_retry(lambda _u=url_template: requests.get(_u, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10), _display_url(url_template)))
{{~ else ~}}
        response = _checked_request("Discovery request", url_template, lambda: requests.get(url_template, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10))
{{~ end ~}}
        _require_ok("Discovery request", url_template, response)
        items = _resolve_items(_json_or_fail("Discovery request", url_template, response), source["itemsPath"])
        return [str(_resolve_field(item, source["valuePath"])) for item in items]
    if kind == "browserDiscovery":
        return _resolve_browser_discovery(source, headers, parameter_name, combo)
    raise ValueError(f"Unknown parameter source: {kind}")


# Best-effort: every ApiParameterSource value is a plain string end to end
# (see _resolve_parameter_values above), so a body variable bound to a
# Number/Boolean parameter needs converting before it fits a strictly-typed
# request body (e.g. a GraphQL server rejecting a stringified number). An
# unparsable value falls back to the raw string rather than raising — a
# strictly-typed target server rejecting it is then a target-site problem
# this can only mitigate, not fully solve (see ApiBodyVariable.CoerceTo).
def _coerce_body_value(value, coerce_to):
    if coerce_to == "Number":
        try:
            return float(value) if "." in value else int(value)
        except ValueError:
            return value
    if coerce_to == "Boolean":
        return value.strip().lower() in ("true", "1", "yes")
    return value


# Renders BODY (Issue #55's request-body tree) into a plain JSON-able Python
# value for one already-resolved parameter combo — an object/array node just
# recurses over its own children, a variable node looks its current value up
# in combo (optionally coerced), and a literal node returns its fixed value
# (kind == "Null" is the one case with no "value" key to read at all, see
# PythonApiConfigLiteral.RenderBody).
def _render_body(node, combo):
    if node is None:
        return None
    if "properties" in node:
        return {key: _render_body(child, combo) for key, child in node["properties"].items()}
    if "items" in node:
        return [_render_body(item, combo) for item in node["items"]]
    if "parameterName" in node:
        return _coerce_body_value(combo[node["parameterName"]], node.get("coerceTo"))
    kind = node["kind"]
    return None if kind == "Null" else node["value"]


{{~ if embedded_json_source ~}}
# Issue #136: for sites that render their complete data into the initial
# page HTML and hydrate the DOM from it client-side (Next.js's
# __NEXT_DATA__, Nuxt's __NUXT__, a generic <script type="application/json">
# state blob, ...), no separate, capturable network request ever happens —
# the JSON is parsed straight out of one <script> tag in the page itself
# instead of out of response.json(). A missing tag or unparseable content is
# a hard failure (unlike a 404 response combination, there's no "this
# combination doesn't exist" fallback for a page that doesn't have the data
# it was expected to).
def _extract_embedded_json(response):
    soup = BeautifulSoup(response.text, "html.parser")
    script_tag = soup.select_one(EMBEDDED_JSON_SOURCE["scriptSelector"])
    if script_tag is None or not script_tag.string:
        raise RuntimeError(
            f"No <script> tag matching selector '{EMBEDDED_JSON_SOURCE['scriptSelector']}' with JSON content was found on {response.url}."
        )
    return json.loads(script_tag.string)
{{~ end ~}}


# Walks the API-Mode tree at runtime: a group node ("children" in node)
# resolves its path against `scope` (N instances if the result is a JSON
# array, at most 1 otherwise — see ApiGroup's doc comment on why this is
# inferred rather than an explicit flag like Container-Mode's "repeating")
# and recurses into each instance; a field leaf reads a single value from
# `scope` directly. One function handles any nesting depth without the
# template needing to mirror the tree structure — the same pattern
# extract_group() already uses for Container-Mode's CSS-selector tree.
def _extract_api_group(scope, node, siblings=None):
    if "children" in node:
        instances = _resolve_items(scope, node["path"])
{{~ if hardening.enabled ~}}
        # Issue #204: ApiGroup has no explicit "repeating" flag (see its own
        # doc comment) — whether this node's Path resolved to a JSON array
        # (N droppable, row-like instances) or an object/scalar (at most
        # one, structurally-expected instance) is re-derived here the same
        # way _resolve_items itself infers it, so required-fields dropping
        # below only ever applies to a genuinely repeating group's own bad
        # instance — mirroring container mode's own "if node['repeating']"
        # gate on _passes_required_fields (a non-repeating instance has no
        # "row" to drop without removing structurally-expected content).
        _raw_matches = _resolve_json_path(scope, node["path"])
        _is_repeating_instance = bool(_raw_matches) and all(isinstance(v, list) for v in _raw_matches)
{{~ end ~}}
        elements = []
        for instance in instances:
            el = ET.Element(node["name"])
            # Issue #206: el is this group instance's own in-construction
            # element — see scraper_grouped.py.j2's own identical doc
            # comment on this same pattern.
            for child in node["children"]:
                result = _extract_api_group(instance, child, el)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
{{~ if hardening.enabled ~}}
            if _is_repeating_instance and not _passes_required_fields(el):
                continue
{{~ end ~}}
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    # Issue #206 follow-up: a derived (combineFields/splitField) field has
    # no path of its own — _resolve_json_path("") would otherwise resolve to
    # the whole scope object rather than "nothing found", so this is
    # guarded explicitly rather than relying on that coincidence. The
    # transform chain still always runs (its own combine/split branch
    # ignores the "" passed here and reads siblings instead), unlike the
    # ordinary "path resolved to nothing" case just below.
    if not node["path"]:
        el.text = _apply_transforms("", node["transform"], siblings)
        return el
    value = _resolve_field(scope, node["path"])
    el.text = "" if value is None else _apply_transforms(str(value), node["transform"], siblings)
    return el


{{~ if output_is_json ~}}
# Converts the group tree (already extracted into ET.Element form by
# _extract_api_group above) into nested dicts/lists for JSON output — same
# helper/reasoning as scraper_grouped.py.j2's own _xml_to_dict (Container-
# Mode). A tag occurring more than once among one element's children
# becomes a JSON list; a tag occurring exactly once stays a plain nested
# value.
def _xml_to_dict(element):
    children = list(element)
    if not children:
        return element.text or ""
    result = {}
    for child in children:
        value = _xml_to_dict(child)
        if child.tag not in result:
            result[child.tag] = value
        elif isinstance(result[child.tag], list):
            result[child.tag].append(value)
        else:
            result[child.tag] = [result[child.tag], value]
    return result
{{~ end ~}}


{{~ if change_detection.enabled ~}}
def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(diff_text):
    host = os.environ[SMTP_HOST_ENV_VAR]
    port = int(os.environ[SMTP_PORT_ENV_VAR]) if SMTP_PORT_ENV_VAR else 587
    username = os.environ.get(SMTP_USERNAME_ENV_VAR) if SMTP_USERNAME_ENV_VAR else None
    password = os.environ.get(SMTP_PASSWORD_ENV_VAR) if SMTP_PASSWORD_ENV_VAR else None
    sender = os.environ[NOTIFY_EMAIL_FROM_ENV_VAR]
    recipient = os.environ[NOTIFY_EMAIL_TO_ENV_VAR]

    msg = MIMEText(diff_text)
    msg["Subject"] = "Scraping Factory: changes detected"
    msg["From"] = sender
    msg["To"] = recipient

    # EHLO first so has_extn() actually knows what the server advertises —
    # opportunistic STARTTLS (upgrade only if offered) works against both a
    # real provider and an unauthenticated local/internal relay that never
    # advertises it, without needing the caller to say which kind it is.
    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(diff_text):
    url = os.environ[WEBHOOK_URL_ENV_VAR]
    payload = json.dumps({"subject": "Scraping Factory: changes detected", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


# Best-effort: by the time this runs, the current run's own output has
# already been written successfully — a notification failure (unreachable
# SMTP host, webhook down, ...) is reported but never fails the overall run.
def _notify_change(old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if CHANGE_DETECTION_NOTIFY == "Email":
            _notify_email(diff_text)
        else:
            _notify_webhook(diff_text)
    except Exception as e:
        print(f"Warning: change notification failed: {e}")
{{~ end ~}}


{{~ if cursor_pagination_enabled ~}}
# Issue #224: cursor/token-based pagination. Unlike a RangeSource/
# DiscoverySource parameter (a value list resolved up front), the next page's
# cursor is only revealed by the current page's own response, so each
# parameter combination runs its own sequential chain: page 1 is sent exactly
# as configured, every further page carries the cursor the page before it
# returned — as a query parameter, or at a dot-separated path within the
# request body. The chain ends when no cursor is returned, the optional
# "has next page" flag is falsy, a cursor repeats (an API that keeps handing
# back the same one would otherwise loop forever), or CURSOR_PAGINATION's
# maxPages safety cap is reached.
CURSOR_PAGINATION = {{ cursor_pagination_literal }}


def _with_query_param(url, name, value):
    # Replaces (or appends) one query parameter without re-encoding any of
    # the others — they stay byte-for-byte what UrlTemplate produced.
    base, separator, query = url.partition("?")
    fragment = ""
    if "#" in query:
        query, _, fragment = query.partition("#")
        fragment = "#" + fragment
    elif "#" in base:
        base, _, fragment = base.partition("#")
        fragment = "#" + fragment
    pairs = [pair for pair in query.split("&") if pair and pair.partition("=")[0] != name]
    pairs.append(f"{name}={quote(str(value), safe='')}")
    return f"{base}?{'&'.join(pairs)}{fragment}"


def _set_body_path(body, path, value):
    # Sets one value at a dot-separated object path of the already-rendered
    # request body (e.g. "variables.after" for a GraphQL query), creating
    # missing intermediate objects.
    if not isinstance(body, dict):
        raise RuntimeError("Cursor pagination needs a JSON object as the request body.")
    node = body
    *parents, last = path.split(".")
    for key in parents:
        child = node.get(key)
        if not isinstance(child, dict):
            child = {}
            node[key] = child
        node = child
    node[last] = value


def _apply_cursor(url, body, cursor):
    if CURSOR_PAGINATION["target"] == "Body":
        page_body = copy.deepcopy(body)
        _set_body_path(page_body, CURSOR_PAGINATION["bodyPath"], cursor)
        return url, page_body
    return _with_query_param(url, CURSOR_PAGINATION["queryParameterName"], cursor), body


def _next_cursor(data):
    # None = this was the last page.
    has_next_path = CURSOR_PAGINATION["hasNextPagePath"]
    if has_next_path is not None:
        flag = _resolve_field(data, has_next_path)
        if flag is None or flag is False or str(flag).strip().lower() in ("", "false", "0"):
            return None
    cursor = _resolve_field(data, CURSOR_PAGINATION["nextCursorPath"])
    if cursor is None or isinstance(cursor, (dict, list)) or str(cursor) == "":
        return None
    return cursor


{{~ end ~}}


# Sends ONE request (page) and returns its parsed JSON, or None when the
# endpoint answers 404 (see below). Factored out of scrape() (Issue #224) so
# the same code serves a plain single request and every page of a cursor
# chain.
def _fetch_page_data(url, body, headers):
    if METHOD == "POST":
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _checked_request("Request", url, lambda: _send_with_retry(lambda _u=url: requests.post(_u, headers=headers, json=body, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10), _display_url(url)))
{{~ else ~}}
        response = _checked_request("Request", url, lambda: requests.post(url, headers=headers, json=body, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10))
{{~ end ~}}
    else:
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _checked_request("Request", url, lambda: _send_with_retry(lambda _u=url: requests.get(_u, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10), _display_url(url)))
{{~ else ~}}
        response = _checked_request("Request", url, lambda: requests.get(url, headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10))
{{~ end ~}}
    # A 404 is treated as "this combination doesn't exist" and skipped
    # rather than aborting the whole run — same reasoning as the flat
    # (CSV) API-Mode template, see scraper_api.py.j2.
    if response.status_code == 404:
        print(f"Skipped (404 Not Found): {{ if has_bootstrap }}{_redact_bootstrap(url)}{{ else }}{url}{{ end }}")
        return None
    _require_ok("Request", url, response)
{{~ if hardening.enabled ~}}
    _BLOCKING_RESPONSES.append({"url": {{ if has_bootstrap }}_redact_bootstrap(url){{ else }}url{{ end }}, "final_url": {{ if has_bootstrap }}_redact_bootstrap(response.url){{ else }}response.url{{ end }}, "length": len(response.content), "text": response.text})
{{~ end ~}}
{{~ if embedded_json_source ~}}
    data = _extract_embedded_json(response)
{{~ else ~}}
    data = _json_or_fail("Request", url, response)
{{~ end ~}}
    return data


{{~ if cursor_pagination_enabled ~}}
def _fetch_pages(url, body, headers):
    cursor = None
    seen_cursors = set()
    for page_number in range(1, CURSOR_PAGINATION["maxPages"] + 1):
        page_url, page_body = (url, body) if cursor is None else _apply_cursor(url, body, cursor)
        data = _fetch_page_data(page_url, page_body, headers)
        if data is None:
            # A 404 on page 1 means "this combination doesn't exist"; on a
            # later page it simply ends the chain.
            return
        yield data
        cursor = _next_cursor(data)
        if cursor is None:
            return
        if str(cursor) in seen_cursors:
            print(f"WARNING: cursor '{cursor}' was returned twice - stopping pagination to avoid an endless loop.", file=sys.stderr)
            return
        seen_cursors.add(str(cursor))
    print(f"Stopped after {CURSOR_PAGINATION['maxPages']} page(s) (maxPages) although the API reported more.")
{{~ else ~}}
def _fetch_pages(url, body, headers):
    data = _fetch_page_data(url, body, headers)
    if data is not None:
        yield data
{{~ end ~}}


def scrape():
{{~ if has_bootstrap ~}}
    _BOOTSTRAP_VALUES.update(_run_bootstrap())
    headers = _build_headers(_BOOTSTRAP_VALUES)
    combos = _resolve_parameter_combos(headers, _BOOTSTRAP_VALUES)
{{~ else ~}}
    headers = _build_headers()
    combos = _resolve_parameter_combos(headers)
{{~ end ~}}

    # Multiple root groups (and/or multiple parameter combinations, each its
    # own request) are siblings in GROUPS/across requests, but XML needs
    # exactly one root element — wrap them all in a single <Ergebnis>
    # element, same as Container-Mode.
    root = ET.Element("Ergebnis")
    blueprint_rows = []
    blueprint_tree_elements = []
    for combo in combos:
        # Every parameter value is URL-encoded before being substituted into
        # UrlTemplate — values discovered at runtime (DiscoverySource) could
        # contain spaces or other characters that aren't valid unescaped in a
        # URL.
        encoded_combo = {name: quote(str(value), safe="") for name, value in {{ if has_bootstrap }}{**_BOOTSTRAP_VALUES, **combo}{{ else }}combo{{ end }}.items()}
        url = URL_TEMPLATE.format(**encoded_combo)

        body = _render_body(BODY, {{ if has_bootstrap }}{**_BOOTSTRAP_VALUES, **combo}{{ else }}combo{{ end }})
        for data in _fetch_pages(url, body, headers):
            for node in GROUPS:
                for el in _extract_api_group(data, node):
                    root.append(el)
{{~ if blueprint_mapping_enabled ~}}
            for node in GROUPS:
                blueprint_rows.extend(_flatten_api_group_for_blueprint(data, node, {}, []))
{{~ end ~}}
{{~ if blueprint_tree_mapping_enabled ~}}
            blueprint_tree_elements.extend(_build_blueprint_tree(data, BLUEPRINT_TREE_MAPPING))
{{~ end ~}}
    return root, blueprint_rows, blueprint_tree_elements


{{~ if request_delay.enabled ~}}
# Issue #222: optional pause between outbound requests — a minimum gap
# between the starts of two consecutive requests, drawn uniformly from
# [REQUEST_DELAY_MIN_S, REQUEST_DELAY_MAX_S] each time. Only the part of the
# pause that hasn't already elapsed (e.g. while parsing the previous page) is
# actually slept, and the very first request of a run starts immediately.
# Each pause is announced on stdout — so a long run visibly isn't hanging,
# and so the companion's trial run can tell waiting apart from a stuck
# script (PythonScriptVerifier extends its own deadline by exactly the
# announced pause).
import random
import time

REQUEST_DELAY_MIN_S = {{ request_delay.min_s_literal }}
REQUEST_DELAY_MAX_S = {{ request_delay.max_s_literal }}
_last_request_started_at = None


def _pace_request():
    global _last_request_started_at
    if _last_request_started_at is not None:
        remaining = random.uniform(REQUEST_DELAY_MIN_S, REQUEST_DELAY_MAX_S) - (time.monotonic() - _last_request_started_at)
        if remaining > 0:
            print(f"Pausing {remaining:.2f} s before the next request (request delay)...", flush=True)
            time.sleep(remaining)
    _last_request_started_at = time.monotonic()


{{~ end ~}}
{{~ if retry.enabled ~}}
# Issue #223: optional retry with backoff on transient request failures — a
# connection error/timeout, or one of RETRY_ON_STATUS_CODES. Between attempts
# the script waits RETRY_DELAY_S (doubled after every retry when
# RETRY_EXPONENTIAL), or exactly what a 429/503's Retry-After header asks
# for; every wait is capped at RETRY_MAX_WAIT_S. Each retry is announced on
# stdout, so a scheduled run never degrades silently (and so the companion's
# trial run can tell the wait apart from a stuck script). Any other status
# (404/401/403, ...) is returned immediately, and once every attempt has
# failed, the last response is returned / the last error re-raised — exactly
# what the caller would have seen without retries.
import time

RETRY_MAX_ATTEMPTS = {{ retry.max_attempts }}
RETRY_DELAY_S = {{ retry.delay_s_literal }}
RETRY_EXPONENTIAL = {{ retry.exponential_literal }}
RETRY_MAX_WAIT_S = {{ retry.max_wait_s_literal }}
RETRY_ON_STATUS_CODES = {{ retry.status_codes_literal }}


# Connection errors/timeouts of whichever HTTP stacks this script uses:
# requests' own, and Playwright's (navigations and page.context.request).
def _retryable_exceptions():
    found = []
    try:
        import requests as _requests
        found.append(_requests.RequestException)
    except ImportError:
        pass
    try:
        from playwright.sync_api import Error as _PlaywrightError
        found.append(_PlaywrightError)
    except ImportError:
        pass
    return tuple(found)


_RETRYABLE_EXCEPTIONS = _retryable_exceptions()


# Retry-After is either a number of seconds or an HTTP date; anything
# unparseable is ignored in favour of the configured delay.
def _retry_after_seconds(response):
    try:
        headers = {str(k).lower(): v for k, v in dict(getattr(response, "headers", None) or {}).items()}
    except (TypeError, ValueError):
        return None
    value = str(headers.get("retry-after") or "").strip()
    if not value:
        return None
    if value.isdigit():
        return float(value)
    try:
        from datetime import datetime, timezone
        from email.utils import parsedate_to_datetime
        return max(0.0, (parsedate_to_datetime(value) - datetime.now(timezone.utc)).total_seconds())
    except (TypeError, ValueError, IndexError):
        return None


def _send_with_retry(send, url):
    attempt = 1
    while True:
        try:
            response = send()
            # requests: status_code; Playwright: status (page.goto may also return None)
            status = getattr(response, "status_code", None)
            if status is None:
                status = getattr(response, "status", None)
            if status not in RETRY_ON_STATUS_CODES or attempt >= RETRY_MAX_ATTEMPTS:
                return response
            reason = f"HTTP {status}"
            retry_after = _retry_after_seconds(response) if status in (429, 503) else None
        except _RETRYABLE_EXCEPTIONS as e:
            if attempt >= RETRY_MAX_ATTEMPTS:
                raise
            reason = e.__class__.__name__
            retry_after = None
        wait = retry_after if retry_after is not None else RETRY_DELAY_S * (2 ** (attempt - 1) if RETRY_EXPONENTIAL else 1)
        wait = min(wait, RETRY_MAX_WAIT_S)
        attempt += 1
        print(f"Retrying in {wait:.1f} s (attempt {attempt} of {RETRY_MAX_ATTEMPTS}) after {reason}: {url}", flush=True)
        time.sleep(wait)
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}


{{~ end ~}}
def main():
{{~ if change_detection.enabled ~}}
    previous_content = _read_previous_output(OUTPUT_PATH)
{{~ end ~}}
    root, blueprint_rows, blueprint_tree_elements = scrape()
{{~ if blueprint_mapping_enabled ~}}
    # Issue #192: BLUEPRINT_MAPPING flattens the tree into rows instead of
    # writing it out nested — `root` itself (used for hardening/change-
    # detection below) is unaffected, still the full, unflattened tree.
    output_fieldnames = [m["target"] for m in BLUEPRINT_MAPPING]
    output_rows = [{m["target"]: row.get(m["source"], "") for m in BLUEPRINT_MAPPING} for row in blueprint_rows]
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(output_rows, f, ensure_ascii=False, indent=2)
{{~ else ~}}
    with open(OUTPUT_PATH, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=output_fieldnames)
        writer.writeheader()
        writer.writerows(output_rows)
{{~ end ~}}
    count = len(output_rows)
{{~ else if blueprint_tree_mapping_enabled ~}}
    # Issue #244: BLUEPRINT_TREE_MAPPING builds a real nested output tree of
    # its own instead of denormalizing into rows — `root` itself (used for
    # hardening/change-detection below) is unaffected, still the full,
    # unmapped source tree.
    blueprint_tree_root = ET.Element("Ergebnis")
    for el in blueprint_tree_elements:
        blueprint_tree_root.append(el)
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(_xml_to_dict(blueprint_tree_root), f, ensure_ascii=False, indent=2)
{{~ else ~}}
    tree = ET.ElementTree(blueprint_tree_root)
    ET.indent(tree)
    tree.write(OUTPUT_PATH, encoding="utf-8", xml_declaration=True)
{{~ end ~}}
    count = len(blueprint_tree_root.findall(".//*"))
{{~ else ~}}
    output_root = _tree_without_hidden_fields(root)
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(_xml_to_dict(output_root), f, ensure_ascii=False, indent=2)
    count = len(root.findall(".//*"))
{{~ else ~}}
    tree = ET.ElementTree(output_root)
    ET.indent(tree)
    tree.write(OUTPUT_PATH, encoding="utf-8", xml_declaration=True)
    count = len(root.findall(".//*"))
{{~ end ~}}
{{~ end ~}}
    print(f"Done — {count} {{ if blueprint_mapping_enabled }}row(s){{ else }}elements{{ end }} written to {OUTPUT_PATH}")
{{~ if change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(root) or _report_required_fields_drops()
{{~ if hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(count)
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
