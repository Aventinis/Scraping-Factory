BASELINE_PATH = OUTPUT_PATH + ".hardening-baseline.json"


def _read_baseline():
    try:
        with open(BASELINE_PATH, "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(count):
    with open(BASELINE_PATH, "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)
{{~ end ~}}


def _run_hardening_checks(root):
    has_error = False
    result_count = len(root.findall(".//*"))
    for check in HARDENING:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = "No data was extracted — at least one selector or request likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            # Issue #130: matched globally by tag name across the whole
            # output tree, not scoped to whichever parent group the field is
            # nested under (see NullRateCheck's own doc comment) — catches a
            # field whose selector quietly starts matching the wrong thing
            # (still returns a value, always empty) even though the overall
            # element count stays healthy.
            field = check["field"]
            elements = list(root.iter(check["field"]))
            total = len(elements)
            if total == 0:
                continue
            empty = sum(1 for el in elements if not (el.text or "").strip())
            rate = empty / total
            if rate > check["threshold"]:
                message = f"Field '{field}': {rate:.0%} of occurrences are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            # Issue #131: catches a gradual drop in result volume that
            # neither noResult (only fires at exactly zero) nor nullRate
            # (only watches one field) would ever trip — e.g. a paginated
            # list quietly losing entries. No baseline yet (first run, or
            # the sidecar file was deleted) simply has nothing to compare
            # against.
            baseline = _read_baseline()
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error
{{~ end ~}}

_PATH_TOKEN_PATTERN = re.compile(r"[^.\[\]]+|\[\*\]|\[\d+\]")


# Minimal JSON-path DSL: dot-notation for object keys, "[*]" to flatten into
# every element of an array, "[n]" for a specific index. Returns every match
# as a flat list — a bare key/index yields at most one, but "[*]" can yield
# several, which is what lets one path (e.g. "results[*].items") reach into
# more than one array at once.
def _resolve_json_path(data, path):
    values = [data]
    for token in _PATH_TOKEN_PATTERN.findall(path):
        next_values = []
        if token == "[*]":
            for value in values:
                if isinstance(value, list):
                    next_values.extend(value)
        elif token.startswith("["):
            index = int(token[1:-1])
            for value in values:
                if isinstance(value, list) and -len(value) <= index < len(value):
                    next_values.append(value[index])
        else:
            for value in values:
                if isinstance(value, dict) and token in value:
                    next_values.append(value[token])
        values = next_values
    return values


# A group's Path is expected to resolve to "the list of instances", however
# it gets there — a path ending on the list itself (values == [the_list]) and
# a path that already fans out via "[*]" (values == [list_a, list_b, ...])
# both end up as one or more list matches, so flattening them one level
# always produces the intended flat instance list either way. An empty Path
# ("" — see ApiGroup.Path) resolves to values == [scope]: if scope itself is
# a list this still flattens it (the "two directly-nested repeating levels
# with no key between them" case), otherwise scope is treated as the single
# instance.
def _resolve_items(data, path):
    values = _resolve_json_path(data, path)
    if values and all(isinstance(value, list) for value in values):
        return [item for sublist in values for item in sublist]
    return values


def _resolve_field(record, path):
    values = _resolve_json_path(record, path)
    return values[0] if values else None


# Issue #84: best-effort numeric normalization for a "toNumber" transform —
# finds the first numeric-looking substring and normalizes its decimal
# separator to '.', stripping thousands separators/currency symbols. When
# both '.' and ',' appear, the rightmost one is treated as the decimal point
# (handles both "1.234,56" and "1,234.56"); a single separator appearing more
# than once is treated as a thousands separator and stripped; a single
# separator appearing exactly once is treated as the decimal point (so
# "12,99"/"12.99" both work, at the cost of a genuinely ambiguous
# single-occurrence case like "1.234" always being read as 1.234, never as
# 1234 — chain a regex-extract transform first if that's not what's wanted).
# Empty string if nothing numeric is found.
def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Applies a field's ordered transform chain (node["transform"], built by
# PythonFieldTransformLiteral) — each step's output feeds the next step's
# input, in the order the user configured them in.
def _apply_transforms(value, transforms):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
    return value


_DEFAULT_ISO_WEEK_FORMAT = "{yyyy}-W{ww}"
_DEFAULT_DATE_FORMAT = "{yyyy}-{mm}-{dd}"

# "{token}" mini-template, mirrored token-for-token by the companion's
# RangeFormat (used to validate From/To ahead of a real script run) — the
# site's own URL convention decides which tokens/separators are needed
# (e.g. ISO-8601 "2026-W35" vs. a site using "2026-35"), so this is
# configurable per RangeSource instead of hardcoded to one format.
_RANGE_FORMAT_TOKEN_PATTERNS = {"yyyy": r"\d{4}", "ww": r"\d{1,2}", "mm": r"\d{1,2}", "dd": r"\d{1,2}"}


def _compile_range_format(fmt):
    pattern = re.escape(fmt)
    for token, value_pattern in _RANGE_FORMAT_TOKEN_PATTERNS.items():
        pattern = pattern.replace(re.escape("{" + token + "}"), f"(?P<{token}>{value_pattern})")
    return re.compile(f"^{pattern}$")


def _parse_range_value(value, fmt):
    match = _compile_range_format(fmt).match(value)
    if not match:
        raise ValueError(f"Value '{value}' does not match format '{fmt}'.")
    return {token: int(v) for token, v in match.groupdict().items()}


def _render_range_value(tokens, fmt):
    rendered = fmt
    for token, value in tokens.items():
        width = 4 if token == "yyyy" else 2
        rendered = rendered.replace("{" + token + "}", f"{value:0{width}d}")
    return rendered


# IsoWeek resolves "today" for *both* From and To (they share this parse
# step) — unlike Date below, where only To gets that treatment.
def _parse_iso_week(value, fmt):
    if value == "today":
        year, week, _ = datetime.date.today().isocalendar()
        return year, week
    tokens = _parse_range_value(value, fmt)
    return tokens["yyyy"], tokens["ww"]


def _iso_week_range(from_value, to_value, fmt):
    start_year, start_week = _parse_iso_week(from_value, fmt)
    end_year, end_week = _parse_iso_week(to_value, fmt)
    start_ordinal = datetime.date.fromisocalendar(start_year, start_week, 1).toordinal()
    end_ordinal = datetime.date.fromisocalendar(end_year, end_week, 1).toordinal()

    weeks = []
    ordinal = start_ordinal
    while ordinal <= end_ordinal:
        iso_year, iso_week, _ = datetime.date.fromordinal(ordinal).isocalendar()
        weeks.append(_render_range_value({"yyyy": iso_year, "ww": iso_week}, fmt))
        ordinal += 7
    return weeks


def _date_range(from_value, to_value, fmt):
    start_tokens = _parse_range_value(from_value, fmt)
    start = datetime.date(start_tokens["yyyy"], start_tokens["mm"], start_tokens["dd"])
    if to_value == "today":
        end = datetime.date.today()
    else:
        end_tokens = _parse_range_value(to_value, fmt)
        end = datetime.date(end_tokens["yyyy"], end_tokens["mm"], end_tokens["dd"])

    dates = []
    current = start
    while current <= end:
        dates.append(_render_range_value({"yyyy": current.year, "mm": current.month, "dd": current.day}, fmt))
        current += datetime.timedelta(days=1)
    return dates


def _number_range(from_value, to_value):
    return [str(n) for n in range(int(from_value), int(to_value) + 1)]


def _build_headers():
    # Many sites (Wikipedia among them) reject the bare "python-requests/x.y"
    # default User-Agent with 403 Forbidden — an honest, identifying UA (not
    # a spoofed browser) is enough to pass that check on most sites. Set
    # first so a user-configured "User-Agent" header below still overrides
    # it (dict assignment order + requests' own case-insensitive header
    # handling means the later entry wins regardless of casing).
    headers = {"User-Agent": "Mozilla/5.0 (compatible; ScrapingFactory/1.0; +https://github.com/Aventinis/Scraping-Factory)"}
    for header in HEADERS:
        headers[header["name"]] = header["value"] if "value" in header else os.environ[header["envVar"]]
    return headers


# Discovery requests reuse the main HEADERS (e.g. an auth token) since a
# discovery endpoint is typically part of the same API as the main request.
def _resolve_parameter_values(source, headers):
    kind = source["kind"]
    if kind == "staticList":
        return list(source["values"])
    if kind == "range":
        range_type = source["type"]
        if range_type == "IsoWeek":
            return _iso_week_range(source["from"], source["to"], source.get("format", _DEFAULT_ISO_WEEK_FORMAT))
        if range_type == "Date":
            return _date_range(source["from"], source["to"], source.get("format", _DEFAULT_DATE_FORMAT))
        return _number_range(source["from"], source["to"])
    if kind == "discovery":
        response = requests.get(source["urlTemplate"], headers=headers, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10)
        response.raise_for_status()
        items = _resolve_items(response.json(), source["itemsPath"])
        return [str(_resolve_field(item, source["valuePath"])) for item in items]
    raise ValueError(f"Unknown parameter source: {kind}")


# Best-effort: every ApiParameterSource value is a plain string end to end
# (see _resolve_parameter_values above), so a body variable bound to a
# Number/Boolean parameter needs converting before it fits a strictly-typed
# request body (e.g. a GraphQL server rejecting a stringified number). An
# unparsable value falls back to the raw string rather than raising — a
# strictly-typed target server rejecting it is then a target-site problem
# this can only mitigate, not fully solve (see ApiBodyVariable.CoerceTo).
def _coerce_body_value(value, coerce_to):
    if coerce_to == "Number":
        try:
            return float(value) if "." in value else int(value)
        except ValueError:
            return value
    if coerce_to == "Boolean":
        return value.strip().lower() in ("true", "1", "yes")
    return value


# Renders BODY (Issue #55's request-body tree) into a plain JSON-able Python
# value for one already-resolved parameter combo — an object/array node just
# recurses over its own children, a variable node looks its current value up
# in combo (optionally coerced), and a literal node returns its fixed value
# (kind == "Null" is the one case with no "value" key to read at all, see
# PythonApiConfigLiteral.RenderBody).
def _render_body(node, combo):
    if node is None:
        return None
    if "properties" in node:
        return {key: _render_body(child, combo) for key, child in node["properties"].items()}
    if "items" in node:
        return [_render_body(item, combo) for item in node["items"]]
    if "parameterName" in node:
        return _coerce_body_value(combo[node["parameterName"]], node.get("coerceTo"))
    kind = node["kind"]
    return None if kind == "Null" else node["value"]


# Walks the API-Mode tree at runtime: a group node ("children" in node)
# resolves its path against `scope` (N instances if the result is a JSON
# array, at most 1 otherwise — see ApiGroup's doc comment on why this is
# inferred rather than an explicit flag like Container-Mode's "repeating")
# and recurses into each instance; a field leaf reads a single value from
# `scope` directly. One function handles any nesting depth without the
# template needing to mirror the tree structure — the same pattern
# extract_group() already uses for Container-Mode's CSS-selector tree.
def _extract_api_group(scope, node):
    if "children" in node:
        instances = _resolve_items(scope, node["path"])
        elements = []
        for instance in instances:
            el = ET.Element(node["name"])
            for child in node["children"]:
                result = _extract_api_group(instance, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    value = _resolve_field(scope, node["path"])
    el.text = "" if value is None else _apply_transforms(str(value), node["transform"])
    return el


{{~ if output_is_json ~}}
# Converts the group tree (already extracted into ET.Element form by
# _extract_api_group above) into nested dicts/lists for JSON output — same
# helper/reasoning as scraper_grouped.py.j2's own _xml_to_dict (Container-
# Mode). A tag occurring more than once among one element's children
# becomes a JSON list; a tag occurring exactly once stays a plain nested
# value.
def _xml_to_dict(element):
    children = list(element)
    if not children:
        return element.text or ""
    result = {}
    for child in children:
        value = _xml_to_dict(child)
        if child.tag not in result:
            result[child.tag] = value
        elif isinstance(result[child.tag], list):
            result[child.tag].append(value)
        else:
            result[child.tag] = [result[child.tag], value]
    return result
{{~ end ~}}


