# Walks the API-Mode tree at runtime: a group node ("children" in node)
# resolves its path against `scope` (N instances if the result is a JSON
# array, at most 1 otherwise — see ApiGroup's doc comment on why this is
# inferred rather than an explicit flag like Container-Mode's "repeating")
# and recurses into each instance; a field leaf reads a single value from
# `scope` directly. One function handles any nesting depth without the
# template needing to mirror the tree structure — the same pattern
# extract_group() already uses for Container-Mode's CSS-selector tree.
def _extract_api_group(scope, node, siblings=None):
    if "children" in node:
        instances = _resolve_items(scope, node["path"])
{{~ if hardening.enabled || dedup.enabled ~}}
        # Issue #204 (and #225's deduplication): ApiGroup has no explicit "repeating" flag (see its own
        # doc comment) — whether this node's Path resolved to a JSON array
        # (N droppable, row-like instances) or an object/scalar (at most
        # one, structurally-expected instance) is re-derived here the same
        # way _resolve_items itself infers it, so required-fields dropping
        # below only ever applies to a genuinely repeating group's own bad
        # instance — mirroring container mode's own "if node['repeating']"
        # gate on _passes_required_fields (a non-repeating instance has no
        # "row" to drop without removing structurally-expected content).
        _raw_matches = _resolve_json_path(scope, node["path"])
        _is_repeating_instance = bool(_raw_matches) and all(isinstance(v, list) for v in _raw_matches)
{{~ end ~}}
        elements = []
        for instance in instances:
            el = ET.Element(node["name"])
            # Issue #206: el is this group instance's own in-construction
            # element — see scraper_grouped.py.j2's own identical doc
            # comment on this same pattern.
            for child in node["children"]:
                result = _extract_api_group(instance, child, el)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
{{~ if hardening.enabled ~}}
            if _is_repeating_instance and not _passes_required_fields(el):
                continue
{{~ end ~}}
{{~ if dedup.enabled ~}}
            if _is_repeating_instance and not _dedup_register_instance(el):
                continue
{{~ end ~}}
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    # Issue #206 follow-up: a derived (combineFields/splitField) field has
    # no path of its own — _resolve_json_path("") would otherwise resolve to
    # the whole scope object rather than "nothing found", so this is
    # guarded explicitly rather than relying on that coincidence. The
    # transform chain still always runs (its own combine/split branch
    # ignores the "" passed here and reads siblings instead), unlike the
    # ordinary "path resolved to nothing" case just below.
    if not node["path"]:
        el.text = _apply_transforms("", node["transform"], siblings)
        return el
    value = _resolve_field(scope, node["path"])
    el.text = "" if value is None else _apply_transforms(str(value), node["transform"], siblings)
    return el


