def scrape(url):
    # One entry per block: a list of rows (flat) or a list of ET.Element
    # (group) accumulated across every paginated page of this one URL — the
    # same per-URL accumulation scraper_grouped.py.j2's own scrape() already
    # does for a single shape, just once per block here.
    results = {block["name"]: [] for block in BLOCKS}
    page_number = 1
    page_url = url
    while page_url:
{{~ if request_delay.enabled ~}}
        _pace_request()
{{~ end ~}}
{{~ if retry.enabled ~}}
        response = _checked_request("Request", page_url, lambda: _send_with_retry(lambda _u=page_url: requests.get(_u, headers=HEADERS, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10), page_url))
{{~ else ~}}
        response = _checked_request("Request", page_url, lambda: requests.get(page_url, headers=HEADERS, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10))
{{~ end ~}}
        _require_ok("Request", page_url, response)
{{~ if hardening_any ~}}
        _BLOCKING_RESPONSES.append({"url": page_url, "final_url": response.url, "length": len(response.content), "text": response.text})
{{~ end ~}}
        soup = BeautifulSoup(response.content, "html.parser")

        any_new = False
        for block in BLOCKS:
            if block["shape"] == "flat":
                page_rows = _extract_flat_block(block, soup)
                if page_rows:
                    any_new = True
                results[block["name"]].extend(page_rows)
            else:
                required = next((c["fieldNames"] for c in block["hardening"]["checks"] if c["kind"] == "requiredFields"), [])
                page_elements = []
                for node in block["groups"]:
                    page_elements.extend(extract_group(soup, node, required, block["name"]))
                if page_elements:
                    any_new = True
                results[block["name"]].extend(page_elements)

        if not any_new:
            break

{{~ if pagination.enabled ~}}
        if page_number >= PAGINATION_MAX_PAGES:
            break
        page_number += 1
{{~ if pagination.kind == "nextLink" ~}}
        next_tag = soup.select_one(PAGINATION_NEXT_LINK_SELECTOR)
        next_href = next_tag.get("href") if next_tag else None
        page_url = urljoin(page_url, next_href) if next_href else None
{{~ else ~}}
        page_url = PAGINATION_URL_TEMPLATE.format(url=url, page=page_number)
{{~ end ~}}
{{~ else ~}}
        page_url = None
{{~ end ~}}
    return results


