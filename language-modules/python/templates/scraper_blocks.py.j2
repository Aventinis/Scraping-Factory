# Issue #88 (proxy support): PROXY_ENV_VAR is an environment-variable
# *name* holding a comma-separated list of proxy URLs — never a literal
# proxy address baked into the script, same as FillStep credentials. If
# more than one is present, requests rotate through them round-robin. A
# missing (not just empty) env var doesn't abort the run — it's treated as
# "no proxy configured", with a warning printed and the run flagged via
# EXIT_MISSING_ENV_VAR at the very end, once the script has otherwise
# completed successfully.
EXIT_MISSING_ENV_VAR = 78

PROXY_ENV_VAR = {{ proxy.env_var_literal }}
_PROXY_ENV_VALUE = os.environ.get(PROXY_ENV_VAR)
_PROXY_ENV_MISSING = _PROXY_ENV_VALUE is None
if _PROXY_ENV_MISSING:
    print(f"Warning: environment variable '{PROXY_ENV_VAR}' is not set — connecting without a proxy.", file=sys.stderr)
_PROXY_LIST = [p.strip() for p in (_PROXY_ENV_VALUE or "").split(",") if p.strip()]
_proxy_cycle = itertools.cycle(_PROXY_LIST) if _PROXY_LIST else None


def _next_proxy():
    return next(_proxy_cycle) if _proxy_cycle else None


def _proxies_for_requests():
    proxy = _next_proxy()
    return {"http": proxy, "https": proxy} if proxy else None
{{~ end ~}}

{{~ if hardening_any ~}}
# Issue #129 (script hardening), generalized to per-block: each block's own
# HARDENING checks (block["hardening"]["checks"]) independently print a
# warning or an error and can fail the whole run once scraping is done — see
# _run_hardening_checks below, shared by flat and group blocks alike via a
# field_values callback instead of two separately-duplicated dispatchers.
EXIT_HARDENING_FAILED = 2

# Issue #132 (blocking-detection check): a snapshot of each request's raw
# response, captured once per page fetch (shared across every block, not
# per-block) since it's about the raw HTTP response, not any one block's own
# extracted data.
_BLOCKING_RESPONSES = []


def _read_baseline(block):
    try:
        with open(block["output_path"] + ".hardening-baseline.json", "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(block, count):
    with open(block["output_path"] + ".hardening-baseline.json", "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)


# field_values(field_name) -> list of raw string values for that field across
# the whole result — a flat block's rows or a group block's tree, so nullRate
# is the only kind that actually needs it; every other kind only needs
# result_count and (for "blocking") the shared _BLOCKING_RESPONSES above.
def _run_hardening_checks(block, result_count, field_values):
    has_error = False
    prefix = f"[{block['name']}] "
    for check in block["hardening"]["checks"]:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = prefix + "No data was extracted — at least one selector likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            field = check["field"]
            values = field_values(field)
            total = len(values)
            if total == 0:
                continue
            empty = sum(1 for v in values if not v.strip())
            rate = empty / total
            if rate > check["threshold"]:
                message = f"{prefix}Field '{field}': {rate:.0%} of occurrences are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            baseline = _read_baseline(block)
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"{prefix}Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "blocking":
            for entry in _BLOCKING_RESPONSES:
                reasons = []
                if urlsplit(entry["url"]).netloc != urlsplit(entry["final_url"]).netloc:
                    reasons.append(f"redirected to a different host ({entry['final_url']})")
                if check["minBodyLength"] is not None and entry["length"] < check["minBodyLength"]:
                    reasons.append(f"response body is only {entry['length']} bytes (minimum: {check['minBodyLength']})")
                matched_phrases = [p for p in check["blockPhrases"] if p.lower() in entry["text"].lower()]
                if matched_phrases:
                    reasons.append(f"matched block phrase(s): {', '.join(matched_phrases)}")
                if reasons:
                    message = f"{prefix}Possible blocking detected for {entry['url']}: {'; '.join(reasons)}."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error


# Issue #133 (required-fields check, flat blocks): unlike the checks above
# (a post-hoc pass over already-final data), this changes what actually gets
# written — called before a flat block's own output file is written.
def _filter_required_fields(block, data):
    check = next((c for c in block["hardening"]["checks"] if c["kind"] == "requiredFields"), None)
    if check is None:
        return data, False
    total = len(data)
    filtered = [row for row in data if all(str(row.get(name, "")).strip() for name in check["fieldNames"])]
    dropped = total - len(filtered)
    if dropped == 0:
        return filtered, False
    message = f"[{block['name']}] Dropped {dropped} of {total} row(s) missing a required field."
    if check["severity"] == "Error":
        print(f"ERROR: {message}", file=sys.stderr)
        return filtered, True
    print(f"WARNING: {message}", file=sys.stderr)
    return filtered, False


# Issue #133 (required-fields check, group blocks): mirrors
# scraper_grouped.py.j2's own _report_required_fields_drops, reading this
# block's own counter out of the shared _REQUIRED_FIELDS_DROPPED dict.
def _report_required_fields_drops(block):
    dropped = _REQUIRED_FIELDS_DROPPED.get(block["name"], 0)
    check = next((c for c in block["hardening"]["checks"] if c["kind"] == "requiredFields"), None)
    if check is None or dropped == 0:
        return False
    message = f"[{block['name']}] Dropped {dropped} element(s) missing a required field."
    if check["severity"] == "Error":
        print(f"ERROR: {message}", file=sys.stderr)
        return True
    print(f"WARNING: {message}", file=sys.stderr)
    return False
{{~ end ~}}


# Issue #84: best-effort numeric normalization for a "toNumber" transform —
# finds the first numeric-looking substring and normalizes its decimal
# separator to '.', stripping thousands separators/currency symbols. When
# both '.' and ',' appear, the rightmost one is treated as the decimal point
# (handles both "1.234,56" and "1,234.56"); a single separator appearing more
# than once is treated as a thousands separator and stripped; a single
# separator appearing exactly once is treated as the decimal point (so
# "12,99"/"12.99" both work, at the cost of a genuinely ambiguous
# single-occurrence case like "1.234" always being read as 1.234, never as
# 1234 — chain a regex-extract transform first if that's not what's wanted).
# Empty string if nothing numeric is found.
def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Applies a field's ordered transform chain — each step's output feeds the
# next step's input, in the order the user configured them in.
def _apply_transforms(value, transforms):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
    return value


def _extract_flat_block(block, soup):
    selectors = block["selectors"]
    columns = {name: soup.select(sel) for name, sel in selectors.items()}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name, elements in columns.items():
            if i < len(elements):
                attr = block["attributes"].get(name)
                raw_value = elements[i].get(attr, "").strip() if attr else elements[i].get_text(strip=True)
                row[name] = _apply_transforms(raw_value, block["transforms"].get(name, []))
            else:
                row[name] = ""
        rows.append(row)
    return rows


# Same tree walk as scraper_grouped.py.j2's own extract_group() — only
# difference is required_field_names/block_name are threaded through
# explicitly instead of read off module-level constants, since a group
# block's own requiredFields check is per-block here.
def extract_group(scope, node, required_field_names, block_name):
    if "children" in node:
        if node["repeating"]:
            matches = scope.select(node["selector"])
        else:
            found = scope.select_one(node["selector"])
            matches = [found] if found else []

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            for child in node["children"]:
                result = extract_group(match, child, required_field_names, block_name)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            if node["repeating"] and required_field_names:
                dropped = False
                for name in required_field_names:
                    for req_match in el.iter(name):
                        if not (req_match.text or "").strip():
                            _REQUIRED_FIELDS_DROPPED[block_name] += 1
                            dropped = True
                            break
                    if dropped:
                        break
                if dropped:
                    continue
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    if node["mode"] == "exists":
        el.text = "true" if scope.select_one(node["selector"]) else "false"
    else:
        found = scope.select_one(node["selector"])
        if found is None:
            el.text = ""
        elif node["mode"] == "attribute":
            el.text = _apply_transforms(found.get(node["attribute"], "") or "", node["transform"])
        elif node["mode"] == "ownText":
            own_text = "".join(c for c in found.contents if isinstance(c, str)).strip()
            el.text = _apply_transforms(own_text, node["transform"])
        else:
            el.text = _apply_transforms(found.get_text(strip=True), node["transform"])
    return el


{{~ if any_json_output ~}}
# Converts a group block's own built ET.Element tree into nested dicts/lists
# for JSON output — see scraper_grouped.py.j2's own _xml_to_dict doc comment.
def _xml_to_dict(element):
    children = list(element)
    if not children:
        return element.text or ""
    result = {}
    for child in children:
        value = _xml_to_dict(child)
        if child.tag not in result:
            result[child.tag] = value
        elif isinstance(result[child.tag], list):
            result[child.tag].append(value)
        else:
            result[child.tag] = [result[child.tag], value]
    return result
{{~ end ~}}


{{~ if change_detection_any ~}}
def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(block, diff_text):
    cd = block["change_detection"]
    host = os.environ[cd["smtp_host_env_var"]]
    port = int(os.environ[cd["smtp_port_env_var"]]) if cd["smtp_port_env_var"] else 587
    username = os.environ.get(cd["smtp_username_env_var"]) if cd["smtp_username_env_var"] else None
    password = os.environ.get(cd["smtp_password_env_var"]) if cd["smtp_password_env_var"] else None
    sender = os.environ[cd["from_env_var"]]
    recipient = os.environ[cd["to_env_var"]]

    msg = MIMEText(diff_text)
    msg["Subject"] = f"Scraping Factory: changes detected ({block['name']})"
    msg["From"] = sender
    msg["To"] = recipient

    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(block, diff_text):
    cd = block["change_detection"]
    url = os.environ[cd["webhook_url_env_var"]]
    payload = json.dumps({"subject": f"Scraping Factory: changes detected ({block['name']})", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


# Best-effort: by the time this runs, the current run's own output has
# already been written successfully — a notification failure (unreachable
# SMTP host, webhook down, ...) is reported but never fails the overall run.
def _notify_change(block, old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if block["change_detection"]["notify"] == "Email":
            _notify_email(block, diff_text)
        else:
            _notify_webhook(block, diff_text)
    except Exception as e:
        print(f"Warning: [{block['name']}] change notification failed: {e}")
{{~ end ~}}


def scrape(url):
    # One entry per block: a list of rows (flat) or a list of ET.Element
    # (group) accumulated across every paginated page of this one URL — the
    # same per-URL accumulation scraper_grouped.py.j2's own scrape() already
    # does for a single shape, just once per block here.
    results = {block["name"]: [] for block in BLOCKS}
    page_number = 1
    page_url = url
    while page_url:
        response = requests.get(page_url, headers=HEADERS, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10)
        response.raise_for_status()
{{~ if hardening_any ~}}
        _BLOCKING_RESPONSES.append({"url": page_url, "final_url": response.url, "length": len(response.content), "text": response.text})
{{~ end ~}}
        soup = BeautifulSoup(response.content, "html.parser")

        any_new = False
        for block in BLOCKS:
            if block["shape"] == "flat":
                page_rows = _extract_flat_block(block, soup)
                if page_rows:
                    any_new = True
                results[block["name"]].extend(page_rows)
            else:
                required = next((c["fieldNames"] for c in block["hardening"]["checks"] if c["kind"] == "requiredFields"), [])
                page_elements = []
                for node in block["groups"]:
                    page_elements.extend(extract_group(soup, node, required, block["name"]))
                if page_elements:
                    any_new = True
                results[block["name"]].extend(page_elements)

        if not any_new:
            break

{{~ if pagination.enabled ~}}
        if page_number >= PAGINATION_MAX_PAGES:
            break
        page_number += 1
{{~ if pagination.kind == "nextLink" ~}}
        next_tag = soup.select_one(PAGINATION_NEXT_LINK_SELECTOR)
        next_href = next_tag.get("href") if next_tag else None
        page_url = urljoin(page_url, next_href) if next_href else None
{{~ else ~}}
        page_url = PAGINATION_URL_TEMPLATE.format(url=url, page=page_number)
{{~ end ~}}
{{~ else ~}}
        page_url = None
{{~ end ~}}
    return results


def main():
{{~ if change_detection_any ~}}
    previous_contents = {block["name"]: (_read_previous_output(block["output_path"]) if block["change_detection"]["enabled"] else None) for block in BLOCKS}
{{~ end ~}}

    per_block_data = {block["name"]: [] for block in BLOCKS if block["shape"] == "flat"}
    per_block_roots = {block["name"]: ET.Element("Ergebnis") for block in BLOCKS if block["shape"] == "group"}
    for url in URLS:
        page_results = scrape(url)
        for block in BLOCKS:
            if block["shape"] == "flat":
                per_block_data[block["name"]].extend(page_results[block["name"]])
            else:
                for el in page_results[block["name"]]:
                    per_block_roots[block["name"]].append(el)

    hardening_failed = False
    for block in BLOCKS:
        name = block["name"]
        if block["shape"] == "flat":
            data = per_block_data[name]
{{~ if hardening_any ~}}
            data, required_fields_failed = _filter_required_fields(block, data)
{{~ end ~}}
            if block["output_is_json"]:
                with open(block["output_path"], "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
            else:
                with open(block["output_path"], "w", newline="", encoding="utf-8") as f:
                    writer = csv.DictWriter(f, fieldnames=block["field_order"])
                    writer.writeheader()
                    writer.writerows(data)
            count = len(data)
            print(f"Done — [{name}] {count} rows written to {block['output_path']}")
{{~ if hardening_any ~}}
            block_failed = _run_hardening_checks(block, count, lambda field, data=data: [str(row.get(field, "")) for row in data]) or required_fields_failed
{{~ end ~}}
        else:
            root = per_block_roots[name]
            if block["output_is_json"]:
                with open(block["output_path"], "w", encoding="utf-8") as f:
                    json.dump(_xml_to_dict(root), f, ensure_ascii=False, indent=2)
            else:
                tree = ET.ElementTree(root)
                ET.indent(tree)
                tree.write(block["output_path"], encoding="utf-8", xml_declaration=True)
            count = len(root.findall(".//*"))
            print(f"Done — [{name}] {count} elements written to {block['output_path']}")
{{~ if hardening_any ~}}
            required_fields_failed = _report_required_fields_drops(block)
            block_failed = _run_hardening_checks(block, count, lambda field, root=root: [(el.text or "") for el in root.iter(field)]) or required_fields_failed
{{~ end ~}}

{{~ if change_detection_any ~}}
        if block["change_detection"]["enabled"]:
            with open(block["output_path"], "r", encoding="utf-8") as f:
                new_content = f.read()
            if previous_contents[name] is not None and previous_contents[name] != new_content:
                _notify_change(block, previous_contents[name], new_content)
{{~ end ~}}

{{~ if hardening_any ~}}
        if block["hardening"]["has_baseline"] and not block_failed:
            _write_baseline(block, count)
        hardening_failed = hardening_failed or block_failed
{{~ end ~}}

{{~ if hardening_any ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
