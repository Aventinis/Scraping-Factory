# Issue #182: one or more independent extraction blocks, each with its own
# shape (flat/group), own output file, and own Hardening/ChangeDetection —
# see ExtractionBlockConfig. All of them share the navigation below (start
# URLs, pagination, proxy) instead of each fetching the page separately.
URLS = [{{ for u in urls }}"{{ u }}"{{ if !for.last }}, {{ end }}{{ end }}]

# Many sites (Wikipedia among them) reject the bare "python-requests/x.y"
# default User-Agent with 403 Forbidden — an honest, identifying UA (not a
# spoofed browser) is enough to pass that check on most sites.
HEADERS = {"User-Agent": "Mozilla/5.0 (compatible; ScrapingFactory/1.0; +https://github.com/Aventinis/Scraping-Factory)"}

BLOCKS = {{ blocks_literal }}

# Issue #133 (required-fields check, group-shaped blocks): keyed by block
# name rather than a single module-level counter, since more than one group
# block can each have its own requiredFields check — mirrors
# scraper_grouped.py.j2's own _required_fields_dropped_count, generalized to
# "one counter per block" instead of one global.
_REQUIRED_FIELDS_DROPPED = {block["name"]: 0 for block in BLOCKS}

{{~ if pagination.enabled ~}}
