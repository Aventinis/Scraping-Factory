def _extract_flat_block(block, soup):
    selectors = block["selectors"]
    columns = {name: soup.select(sel) for name, sel in selectors.items()}
    n = max((len(v) for v in columns.values()), default=0)

    rows = []
    for i in range(n):
        row = {}
        for name, elements in columns.items():
            if i < len(elements):
                attr = block["attributes"].get(name)
                raw_value = elements[i].get(attr, "").strip() if attr else elements[i].get_text(strip=True)
                row[name] = _apply_transforms(raw_value, block["transforms"].get(name, []), row)
            else:
                row[name] = ""
        rows.append(row)
    return rows


# Same tree walk as scraper_grouped.py.j2's own extract_group() — only
# difference is required_field_names/block_name are threaded through
# explicitly instead of read off module-level constants, since a group
# block's own requiredFields check is per-block here.
def extract_group(scope, node, required_field_names, block_name, siblings=None):
    if "children" in node:
        if node["repeating"]:
            matches = scope.select(node["selector"])
        else:
            found = scope.select_one(node["selector"])
            matches = [found] if found else []

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            # Issue #206: el is this group instance's own in-construction
            # element — see scraper_grouped.py.j2's own identical doc
            # comment on this same pattern.
            for child in node["children"]:
                result = extract_group(match, child, required_field_names, block_name, el)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            if node["repeating"] and required_field_names:
                dropped = False
                for name in required_field_names:
                    for req_match in el.iter(name):
                        if not (req_match.text or "").strip():
                            _REQUIRED_FIELDS_DROPPED[block_name] += 1
                            dropped = True
                            break
                    if dropped:
                        break
                if dropped:
                    continue
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    if node["mode"] == "exists":
        el.text = "true" if scope.select_one(node["selector"]) else "false"
    else:
        found = scope.select_one(node["selector"])
        if found is None:
            el.text = ""
        elif node["mode"] == "attribute":
            el.text = _apply_transforms(found.get(node["attribute"], "") or "", node["transform"], siblings)
        elif node["mode"] == "ownText":
            own_text = "".join(c for c in found.contents if isinstance(c, str)).strip()
            el.text = _apply_transforms(own_text, node["transform"], siblings)
        else:
            el.text = _apply_transforms(found.get_text(strip=True), node["transform"], siblings)
    return el


