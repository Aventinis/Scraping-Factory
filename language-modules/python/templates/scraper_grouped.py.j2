# Issue #192: optional Output Blueprint field mapping (see scraper.py.j2's
# own identical BLUEPRINT_MAPPING doc comment for the flat-mode case this
# extends) — for this tree-shaped mode, an active mapping doesn't just
# rename output columns, it *flattens* the tree into denormalized rows (see
# _flatten_group_tree_for_blueprint below): one row per instance of the
# single repeating group every mapped field's own ancestor chain shares,
# with any higher-level mapped field copied into every row generated
# beneath it. ScrapingPlanValidator's own OutputBlueprintFlattening check
# already guarantees, before this script was ever generated, that the
# mapping resolves to exactly one unambiguous row layout for Container-Mode
# (GroupNode.Repeating is known statically there) — empty list = tree mode's
# normal, unflattened xml/json output. Deliberately placed here,
# unconditionally (not nested inside hardening's own conditional block
# above, unlike REQUIRED_FIELD_NAMES/HARDENING itself) — a blueprint
# mapping is independent of whether hardening is configured at all.
BLUEPRINT_MAPPING = {{ blueprint_mapping_literal }}
BLUEPRINT_MAPPING_BY_SOURCE = {m["source"]: m["target"] for m in BLUEPRINT_MAPPING}


# True if `node`'s own subtree (recursively) contains at least one leaf
# field referenced by BLUEPRINT_MAPPING — used by
# _flatten_group_tree_for_blueprint to skip an entirely irrelevant branch
# (e.g. a repeating group with no mapped field anywhere inside it) without
# needlessly multiplying rows for data nothing in the mapping ever reads.
def _blueprint_subtree_has_mapped_field(node):
    if "children" in node:
        return any(_blueprint_subtree_has_mapped_field(child) for child in node["children"])
    return node["name"] in BLUEPRINT_MAPPING_BY_SOURCE


# Resolves one leaf field's raw value exactly like extract_group()'s own
# leaf branch — a small, deliberate duplication (same "no cross-function
# code sharing beyond a plain Python def" reasoning extract_group() and
# _apply_transforms already accept throughout this template) rather than
# reusing extract_group() itself, which returns an ET.Element, not a value.
# Issue #213 note: deliberately does NOT apply Download here — a flattened
# Output Blueprint row for an Attribute-mode field with Download enabled
# still gets the raw URL, not a local file path. Combining these two
# features is out of scope for this first version (undocumented anywhere
# else — the two simply haven't been wired together yet).
# Issue #206 note: for the same reason, this walk has no in-construction
# sibling element to pass as _apply_transforms' own `siblings` argument (it
# resolves one leaf value in isolation, not via extract_group()'s own
# recursive tree build) — a combineFields/splitField transform on a
# Blueprint-mapped field resolves every referenced sibling to "" here,
# rather than the value it would have during an ordinary (non-flattened)
# run. Same out-of-scope-for-now interaction as Download above.
def _resolve_flatten_leaf_value(scope, node):
    # Issue #206 follow-up: a derived (combineFields/splitField) field has
    # no selector of its own — same as extract_group()'s own guard below,
    # this resolves to "found nothing" here rather than calling
    # select_one("") (a combine/split transform already resolves every
    # referenced sibling to "" in this flattened context regardless, per
    # this function's own doc comment above).
    if not node["selector"]:
        return "false" if node["mode"] == "exists" else ""
    if node["mode"] == "exists":
        return "true" if scope.select_one(node["selector"]) else "false"
    found = scope.select_one(node["selector"])
    if found is None:
        return ""
    if node["mode"] == "attribute":
        return _apply_transforms(found.get(node["attribute"], "") or "", node["transform"])
    if node["mode"] == "ownText":
        own_text = "".join(c for c in found.contents if isinstance(c, str)).strip()
        return _apply_transforms(own_text, node["transform"])
    return _apply_transforms(found.get_text(strip=True), node["transform"])


# Flattens the group tree into denormalized rows for BLUEPRINT_MAPPING,
# instead of extract_group()'s nested ET.Element tree — always returns a
# list of context dicts (never a single dict), uniformly, whether or not a
# repeating boundary has been reached in this subtree yet: before one, the
# list always has exactly one entry (the single context accumulated so
# far); at and after one, one entry per row. A *non-repeating* group (or a
# repeating one holding no mapped field at all, see
# _blueprint_subtree_has_mapped_field) never multiplies the list — it
# simply threads `context` through, which is what lets a higher-level
# mapped field (e.g. a category name next to a repeating list of items)
# reach every row generated by a *deeper* repeating group without being
# written under its own name only once. Two independent repeating groups
# both holding a mapped field (mapped fields spanning more than one branch)
# is already rejected before this script was ever generated
# (OutputBlueprintFlattening) — this walker relies on that guarantee and
# does not re-check it itself.
def _flatten_group_tree_for_blueprint(scope, node, context):
    if "children" in node:
        if not _blueprint_subtree_has_mapped_field(node):
            return [context]

        if node["repeating"]:
            matches = scope.select(node["selector"])
        else:
            found = scope.select_one(node["selector"])
            matches = [found] if found else []

        all_contexts = []
        for match in matches:
            instance_contexts = [context]
            for child in node["children"]:
                next_contexts = []
                for ctx in instance_contexts:
                    next_contexts.extend(_flatten_group_tree_for_blueprint(match, child, ctx))
                instance_contexts = next_contexts
            all_contexts.extend(instance_contexts)
        return all_contexts

    value = _resolve_flatten_leaf_value(scope, node)
    if node["name"] in BLUEPRINT_MAPPING_BY_SOURCE:
        return [{**context, node["name"]: value}]
    return [context]


# Issue #244: a second, tree-shaped Output Blueprint target schema —
# BLUEPRINT_TREE_MAPPING mirrors the persisted blueprint's own target tree
# node-for-node (group: name+children, leaf: name+source), letting a mapping
# place two independent/sibling source repeating groups under two different
# target branches instead of the flat mapping's single shared row scope
# above. Mutually exclusive with BLUEPRINT_MAPPING for any one plan (see
# PythonOutputBlueprintLiteral's own doc comment) — at most one of them ever
# actually builds anything, but both constants are always emitted so the
# rest of this file doesn't need to branch on SchemaKind directly.
BLUEPRINT_TREE_MAPPING = {{ blueprint_tree_mapping_literal }}

# One-time, purely structural index of GROUPS, independent of any scraped
# data — built once at import time since the tree shape itself never
# changes across pages/paginated results within a single run.
# _BLUEPRINT_PATH_BY_NAME[name] is the ordered list of ancestor group dicts
# (both repeating and non-repeating) from the document root down to (not
# including) the node with that name; _BLUEPRINT_GROUP_BY_NAME/
# _BLUEPRINT_LEAF_BY_NAME let a resolved name be turned back into its own
# node dict. First occurrence wins for a duplicate name, the same "global by
# name" simplification NullRateCheck/RequiredFieldsCheck/BLUEPRINT_MAPPING
# above already established for this tree shape.
_BLUEPRINT_GROUP_BY_NAME = {}
_BLUEPRINT_LEAF_BY_NAME = {}
_BLUEPRINT_PATH_BY_NAME = {}


def _blueprint_index_source_tree(nodes, ancestors):
    for node in nodes:
        if "children" in node:
            _BLUEPRINT_GROUP_BY_NAME.setdefault(node["name"], node)
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _blueprint_index_source_tree(node["children"], ancestors + [node])
        else:
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _BLUEPRINT_LEAF_BY_NAME.setdefault(node["name"], node)


_blueprint_index_source_tree(GROUPS, [])


# The chain of REPEATING ancestor names only (mirrors the companion's own
# OutputBlueprintFlattening chain exactly) — used to find which source group
# a target group's own mapped fields agree on repeating within, and to tell
# a "broadcast" field (no repeating ancestor at all) apart from one that
# needs walking down into a specific repeating instance.
def _blueprint_repeating_chain(name):
    return [g["name"] for g in _BLUEPRINT_PATH_BY_NAME.get(name, []) if g["repeating"]]


# The FULL ancestor path (repeating and non-repeating alike) plus, when
# `name` itself names a group, that group's own node appended last — the
# actual sequence of selectors that must be walked, in order, to reach an
# instance of `name` from the document root.
def _blueprint_full_path(name):
    ancestors = _BLUEPRINT_PATH_BY_NAME.get(name, [])
    group = _BLUEPRINT_GROUP_BY_NAME.get(name)
    return ancestors + [group] if group is not None else ancestors


# Walks `scopes` through `suffix` (a list of ancestor group dicts, as
# returned by _blueprint_full_path) one group at a time, fanning out at
# every repeating step — the runtime counterpart of resolving a whole chain
# of GroupNode selectors at once instead of one at a time like
# extract_group() does through ordinary recursion.
def _blueprint_walk_suffix(scopes, suffix):
    for group in suffix:
        next_scopes = []
        for scope in scopes:
            if group["repeating"]:
                next_scopes.extend(scope.select(group["selector"]))
            else:
                found = scope.select_one(group["selector"])
                if found is not None:
                    next_scopes.append(found)
        scopes = next_scopes
    return scopes


# Resolves this target group's own row scope (the deepest repeating source
# ancestor its direct leaf fields — not counting any nested target group's
# own leaves, which resolve independently — agree on), falling back to
# ancestor_chain unchanged when none of them add any further nesting.
# Container-Mode's GroupNode.Repeating is a static, config-time flag, so
# ScrapingPlanValidator's own OutputBlueprintFlattening.
# ResolveContainerTreeRowScopes already guarantees, before this script was
# ever generated, that this always resolves unambiguously — this simply
# re-derives that same winner rather than re-validating it (contrast with
# scraper_api_grouped.py.j2's own version of this function, which has no
# such static guarantee available and validates it here instead).
def _blueprint_resolve_group_chain(target_children, ancestor_chain):
    chains = [_blueprint_repeating_chain(c["source"]) for c in target_children if "source" in c]
    non_empty = [c for c in chains if c]
    return max(non_empty, key=len) if non_empty else ancestor_chain


# Builds one target node's own output — a list of ET.Element for a target
# group (one per resolved row-scope instance, possibly just one when the
# group adds no further nesting) or a single ET.Element for a target leaf,
# mirroring extract_group()'s own "list for a group, single Element for a
# leaf" convention so a caller can use the same isinstance(result, list)
# dispatch. `top_scope` is the whole page's own top-level scope (needed to
# resolve a "broadcast" leaf — one with no repeating source ancestor at all
# — independently of how deep the current recursion already is, exactly
# like a page-level field in the flat mapping above is simply visited once
# via its own natural, shallow position in the tree); `scope`/
# `ancestor_full_path` track where the recursion has already navigated to
# relative to that root.
def _build_blueprint_node(top_scope, scope, ancestor_chain, ancestor_full_path, target_node):
    if "children" in target_node:
        row_chain = _blueprint_resolve_group_chain(target_node["children"], ancestor_chain)
        full_path = _blueprint_full_path(row_chain[-1]) if row_chain else ancestor_full_path
        instances = _blueprint_walk_suffix([scope], full_path[len(ancestor_full_path):])

        elements = []
        for instance in instances:
            el = ET.Element(target_node["name"])
            for child in target_node["children"]:
                result = _build_blueprint_node(top_scope, instance, row_chain, full_path, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            elements.append(el)
        return elements

    source_name = target_node["source"]
    leaf_node = _BLUEPRINT_LEAF_BY_NAME[source_name]
    chain = _blueprint_repeating_chain(source_name)
    if chain:
        scopes = _blueprint_walk_suffix([scope], _blueprint_full_path(source_name)[len(ancestor_full_path):])
    else:
        # Broadcast: this field has no repeating source ancestor at all, so
        # it's resolved relative to the whole page, not wherever the current
        # target group instance happens to be.
        scopes = _blueprint_walk_suffix([top_scope], _blueprint_full_path(source_name))

    resolved = scopes[0] if scopes else None
    el = ET.Element(target_node["name"])
    el.text = ("false" if leaf_node["mode"] == "exists" else "") if resolved is None else _resolve_flatten_leaf_value(resolved, leaf_node)
    return el


def _build_blueprint_tree(top_scope, target_roots):
    elements = []
    for target_node in target_roots:
        result = _build_blueprint_node(top_scope, top_scope, [], [], target_node)
        if isinstance(result, list):
            elements.extend(result)
        else:
            elements.append(result)
    return elements


#@include transforms


# Walks the container tree at runtime: a group node ("children" in node)
# resolves its selector against `scope` (once or repeatedly, depending on
# node["repeating"]) and recurses into each match; a data-field leaf reads
# text/attribute/existence from `scope` directly. One function handles any
# nesting depth without the template needing to mirror the tree structure.
def extract_group(scope, node, base_url, siblings=None):
    if "children" in node:
        if node["repeating"]:
            matches = scope.select(node["selector"])
        else:
            found = scope.select_one(node["selector"])
            # A non-repeating group with zero matches is simply omitted —
            # consistent with how a missing flat field is tolerated today,
            # not treated as an error (see planning doc "Offene Randfälle").
            matches = [found] if found else []

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            # Issue #206: el is this group instance's own in-construction
            # element — passed down as `siblings` so a combine/split
            # transform on a later child can look up an earlier child's
            # already-computed value via el.find(name). Only ever populated
            # with this instance's own direct children, matching
            # ValidateFieldTransformOrdering's "same immediate parent group"
            # scope exactly.
            for child in node["children"]:
                result = extract_group(match, child, base_url, el)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
{{~ if hardening.enabled ~}}
            if node["repeating"] and not _passes_required_fields(el):
                continue
{{~ end ~}}
{{~ if dedup.enabled ~}}
            if node["repeating"] and not _dedup_register_instance(el):
                continue
{{~ end ~}}
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    # Issue #206 follow-up: a derived (combineFields/splitField) field has
    # no selector of its own — unlike an ordinary missing-element case below
    # (which writes "" without ever running the transform chain, since
    # there's nothing more for it to do), a derived field's whole value
    # comes from this call — it must always run through _apply_transforms,
    # which reads sibling values already resolved into `siblings` and
    # ignores the "" passed here entirely.
    if not node["selector"]:
        el.text = "false" if node["mode"] == "exists" else _apply_transforms("", node["transform"], siblings)
        return el
    if node["mode"] == "exists":
        el.text = "true" if scope.select_one(node["selector"]) else "false"
    else:
        found = scope.select_one(node["selector"])
        if found is None:
            el.text = ""
        elif node["mode"] == "attribute":
            value = _apply_transforms(found.get(node["attribute"], "") or "", node["transform"], siblings)
            # Issue #213: replaces the raw URL with its own downloaded local
            # file path — applied AFTER transforms, so e.g. a `replace`
            # transform fixing up a protocol-relative "//host/x.jpg" URL is
            # already in effect by the time it's resolved/downloaded.
            el.text = _download_resource(value, base_url, node.get("maxDownloadSizeBytes"), node.get("allowedContentTypes")) if node.get("download") and value else value
        elif node["mode"] == "ownText":
            # Direct text-node children only, excluding any nested element's
            # own text — e.g. a badge <span> inside a name <h3> no longer
            # gets pulled into the name (unlike plain get_text() below, which
            # walks every descendant). NavigableString is itself a str
            # subclass, so this filters out child Tags without a separate
            # import.
            own_text = "".join(c for c in found.contents if isinstance(c, str)).strip()
            el.text = _apply_transforms(own_text, node["transform"], siblings)
        else:
            el.text = _apply_transforms(found.get_text(strip=True), node["transform"], siblings)
    return el


