BASELINE_PATH = OUTPUT_PATH + ".hardening-baseline.json"


def _read_baseline():
    try:
        with open(BASELINE_PATH, "r", encoding="utf-8") as f:
            return json.load(f).get("count")
    except (FileNotFoundError, ValueError, OSError):
        return None


def _write_baseline(count):
    with open(BASELINE_PATH, "w", encoding="utf-8") as f:
        json.dump({"count": count}, f)
{{~ end ~}}


def _run_hardening_checks(root):
    has_error = False
    result_count = len(root.findall(".//*"))
    for check in HARDENING:
        if check["kind"] == "noResult":
            if result_count == 0:
                message = "No data was extracted — at least one selector likely matched nothing."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "nullRate":
            # Issue #130: matched globally by tag name across the whole
            # output tree, not scoped to whichever parent group the field is
            # nested under (see NullRateCheck's own doc comment) — catches a
            # field whose selector quietly starts matching the wrong thing
            # (still returns a value, always empty) even though the overall
            # element count stays healthy.
            field = check["field"]
            elements = list(root.iter(check["field"]))
            total = len(elements)
            if total == 0:
                continue
            empty = sum(1 for el in elements if not (el.text or "").strip())
            rate = empty / total
            if rate > check["threshold"]:
                message = f"Field '{field}': {rate:.0%} of occurrences are empty (threshold: {check['threshold']:.0%})."
                if check["severity"] == "Error":
                    print(f"ERROR: {message}", file=sys.stderr)
                    has_error = True
                else:
                    print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "baseline":
            # Issue #131: catches a gradual drop in result volume that
            # neither noResult (only fires at exactly zero) nor nullRate
            # (only watches one field) would ever trip — e.g. a paginated
            # list quietly losing entries. No baseline yet (first run, or
            # the sidecar file was deleted) simply has nothing to compare
            # against.
            baseline = _read_baseline()
            if baseline:
                drop = (baseline - result_count) / baseline
                if drop > check["dropThreshold"]:
                    message = f"Result count dropped from {baseline} to {result_count} (more than the {check['dropThreshold']:.0%} threshold)."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
        elif check["kind"] == "blocking":
            # Issue #132: three signals, all evaluated per captured response
            # — a redirect to a different host (always checked), a body
            # shorter than minBodyLength (skipped when None), and a
            # case-insensitive match against blockPhrases.
            for entry in _BLOCKING_RESPONSES:
                reasons = []
                if urlsplit(entry["url"]).netloc != urlsplit(entry["final_url"]).netloc:
                    reasons.append(f"redirected to a different host ({entry['final_url']})")
                if check["minBodyLength"] is not None and entry["length"] < check["minBodyLength"]:
                    reasons.append(f"response body is only {entry['length']} bytes (minimum: {check['minBodyLength']})")
                matched_phrases = [p for p in check["blockPhrases"] if p.lower() in entry["text"].lower()]
                if matched_phrases:
                    reasons.append(f"matched block phrase(s): {', '.join(matched_phrases)}")
                if reasons:
                    message = f"Possible blocking detected for {entry['url']}: {'; '.join(reasons)}."
                    if check["severity"] == "Error":
                        print(f"ERROR: {message}", file=sys.stderr)
                        has_error = True
                    else:
                        print(f"WARNING: {message}", file=sys.stderr)
    return has_error
{{~ end ~}}

GROUPS = {{ groups_literal }}

# Issue #192: optional Output Blueprint field mapping (see scraper.py.j2's
# own identical BLUEPRINT_MAPPING doc comment for the flat-mode case this
# extends) — for this tree-shaped mode, an active mapping doesn't just
# rename output columns, it *flattens* the tree into denormalized rows (see
# _flatten_group_tree_for_blueprint below): one row per instance of the
# single repeating group every mapped field's own ancestor chain shares,
# with any higher-level mapped field copied into every row generated
# beneath it. ScrapingPlanValidator's own OutputBlueprintFlattening check
# already guarantees, before this script was ever generated, that the
# mapping resolves to exactly one unambiguous row layout for Container-Mode
# (GroupNode.Repeating is known statically there) — empty list = tree mode's
# normal, unflattened xml/json output. Deliberately placed here,
# unconditionally (not nested inside hardening's own conditional block
# above, unlike REQUIRED_FIELD_NAMES/HARDENING itself) — a blueprint
# mapping is independent of whether hardening is configured at all.
BLUEPRINT_MAPPING = {{ blueprint_mapping_literal }}
BLUEPRINT_MAPPING_BY_SOURCE = {m["source"]: m["target"] for m in BLUEPRINT_MAPPING}


# True if `node`'s own subtree (recursively) contains at least one leaf
# field referenced by BLUEPRINT_MAPPING — used by
# _flatten_group_tree_for_blueprint to skip an entirely irrelevant branch
# (e.g. a repeating group with no mapped field anywhere inside it) without
# needlessly multiplying rows for data nothing in the mapping ever reads.
def _blueprint_subtree_has_mapped_field(node):
    if "children" in node:
        return any(_blueprint_subtree_has_mapped_field(child) for child in node["children"])
    return node["name"] in BLUEPRINT_MAPPING_BY_SOURCE


# Resolves one leaf field's raw value exactly like extract_group()'s own
# leaf branch — a small, deliberate duplication (same "no cross-function
# code sharing beyond a plain Python def" reasoning extract_group() and
# _apply_transforms already accept throughout this template) rather than
# reusing extract_group() itself, which returns an ET.Element, not a value.
def _resolve_flatten_leaf_value(scope, node):
    if node["mode"] == "exists":
        return "true" if scope.select_one(node["selector"]) else "false"
    found = scope.select_one(node["selector"])
    if found is None:
        return ""
    if node["mode"] == "attribute":
        return _apply_transforms(found.get(node["attribute"], "") or "", node["transform"])
    if node["mode"] == "ownText":
        own_text = "".join(c for c in found.contents if isinstance(c, str)).strip()
        return _apply_transforms(own_text, node["transform"])
    return _apply_transforms(found.get_text(strip=True), node["transform"])


# Flattens the group tree into denormalized rows for BLUEPRINT_MAPPING,
# instead of extract_group()'s nested ET.Element tree — always returns a
# list of context dicts (never a single dict), uniformly, whether or not a
# repeating boundary has been reached in this subtree yet: before one, the
# list always has exactly one entry (the single context accumulated so
# far); at and after one, one entry per row. A *non-repeating* group (or a
# repeating one holding no mapped field at all, see
# _blueprint_subtree_has_mapped_field) never multiplies the list — it
# simply threads `context` through, which is what lets a higher-level
# mapped field (e.g. a category name next to a repeating list of items)
# reach every row generated by a *deeper* repeating group without being
# written under its own name only once. Two independent repeating groups
# both holding a mapped field (mapped fields spanning more than one branch)
# is already rejected before this script was ever generated
# (OutputBlueprintFlattening) — this walker relies on that guarantee and
# does not re-check it itself.
def _flatten_group_tree_for_blueprint(scope, node, context):
    if "children" in node:
        if not _blueprint_subtree_has_mapped_field(node):
            return [context]

        if node["repeating"]:
            matches = scope.select(node["selector"])
        else:
            found = scope.select_one(node["selector"])
            matches = [found] if found else []

        all_contexts = []
        for match in matches:
            instance_contexts = [context]
            for child in node["children"]:
                next_contexts = []
                for ctx in instance_contexts:
                    next_contexts.extend(_flatten_group_tree_for_blueprint(match, child, ctx))
                instance_contexts = next_contexts
            all_contexts.extend(instance_contexts)
        return all_contexts

    value = _resolve_flatten_leaf_value(scope, node)
    if node["name"] in BLUEPRINT_MAPPING_BY_SOURCE:
        return [{**context, node["name"]: value}]
    return [context]


# Issue #244: a second, tree-shaped Output Blueprint target schema —
# BLUEPRINT_TREE_MAPPING mirrors the persisted blueprint's own target tree
# node-for-node (group: name+children, leaf: name+source), letting a mapping
# place two independent/sibling source repeating groups under two different
# target branches instead of the flat mapping's single shared row scope
# above. Mutually exclusive with BLUEPRINT_MAPPING for any one plan (see
# PythonOutputBlueprintLiteral's own doc comment) — at most one of them ever
# actually builds anything, but both constants are always emitted so the
# rest of this file doesn't need to branch on SchemaKind directly.
BLUEPRINT_TREE_MAPPING = {{ blueprint_tree_mapping_literal }}

# One-time, purely structural index of GROUPS, independent of any scraped
# data — built once at import time since the tree shape itself never
# changes across pages/paginated results within a single run.
# _BLUEPRINT_PATH_BY_NAME[name] is the ordered list of ancestor group dicts
# (both repeating and non-repeating) from the document root down to (not
# including) the node with that name; _BLUEPRINT_GROUP_BY_NAME/
# _BLUEPRINT_LEAF_BY_NAME let a resolved name be turned back into its own
# node dict. First occurrence wins for a duplicate name, the same "global by
# name" simplification NullRateCheck/RequiredFieldsCheck/BLUEPRINT_MAPPING
# above already established for this tree shape.
_BLUEPRINT_GROUP_BY_NAME = {}
_BLUEPRINT_LEAF_BY_NAME = {}
_BLUEPRINT_PATH_BY_NAME = {}


def _blueprint_index_source_tree(nodes, ancestors):
    for node in nodes:
        if "children" in node:
            _BLUEPRINT_GROUP_BY_NAME.setdefault(node["name"], node)
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _blueprint_index_source_tree(node["children"], ancestors + [node])
        else:
            _BLUEPRINT_PATH_BY_NAME.setdefault(node["name"], ancestors)
            _BLUEPRINT_LEAF_BY_NAME.setdefault(node["name"], node)


_blueprint_index_source_tree(GROUPS, [])


# The chain of REPEATING ancestor names only (mirrors the companion's own
# OutputBlueprintFlattening chain exactly) — used to find which source group
# a target group's own mapped fields agree on repeating within, and to tell
# a "broadcast" field (no repeating ancestor at all) apart from one that
# needs walking down into a specific repeating instance.
def _blueprint_repeating_chain(name):
    return [g["name"] for g in _BLUEPRINT_PATH_BY_NAME.get(name, []) if g["repeating"]]


# The FULL ancestor path (repeating and non-repeating alike) plus, when
# `name` itself names a group, that group's own node appended last — the
# actual sequence of selectors that must be walked, in order, to reach an
# instance of `name` from the document root.
def _blueprint_full_path(name):
    ancestors = _BLUEPRINT_PATH_BY_NAME.get(name, [])
    group = _BLUEPRINT_GROUP_BY_NAME.get(name)
    return ancestors + [group] if group is not None else ancestors


# Walks `scopes` through `suffix` (a list of ancestor group dicts, as
# returned by _blueprint_full_path) one group at a time, fanning out at
# every repeating step — the runtime counterpart of resolving a whole chain
# of GroupNode selectors at once instead of one at a time like
# extract_group() does through ordinary recursion.
def _blueprint_walk_suffix(scopes, suffix):
    for group in suffix:
        next_scopes = []
        for scope in scopes:
            if group["repeating"]:
                next_scopes.extend(scope.select(group["selector"]))
            else:
                found = scope.select_one(group["selector"])
                if found is not None:
                    next_scopes.append(found)
        scopes = next_scopes
    return scopes


# Resolves this target group's own row scope (the deepest repeating source
# ancestor its direct leaf fields — not counting any nested target group's
# own leaves, which resolve independently — agree on), falling back to
# ancestor_chain unchanged when none of them add any further nesting.
# Container-Mode's GroupNode.Repeating is a static, config-time flag, so
# ScrapingPlanValidator's own OutputBlueprintFlattening.
# ResolveContainerTreeRowScopes already guarantees, before this script was
# ever generated, that this always resolves unambiguously — this simply
# re-derives that same winner rather than re-validating it (contrast with
# scraper_api_grouped.py.j2's own version of this function, which has no
# such static guarantee available and validates it here instead).
def _blueprint_resolve_group_chain(target_children, ancestor_chain):
    chains = [_blueprint_repeating_chain(c["source"]) for c in target_children if "source" in c]
    non_empty = [c for c in chains if c]
    return max(non_empty, key=len) if non_empty else ancestor_chain


# Builds one target node's own output — a list of ET.Element for a target
# group (one per resolved row-scope instance, possibly just one when the
# group adds no further nesting) or a single ET.Element for a target leaf,
# mirroring extract_group()'s own "list for a group, single Element for a
# leaf" convention so a caller can use the same isinstance(result, list)
# dispatch. `top_scope` is the whole page's own top-level scope (needed to
# resolve a "broadcast" leaf — one with no repeating source ancestor at all
# — independently of how deep the current recursion already is, exactly
# like a page-level field in the flat mapping above is simply visited once
# via its own natural, shallow position in the tree); `scope`/
# `ancestor_full_path` track where the recursion has already navigated to
# relative to that root.
def _build_blueprint_node(top_scope, scope, ancestor_chain, ancestor_full_path, target_node):
    if "children" in target_node:
        row_chain = _blueprint_resolve_group_chain(target_node["children"], ancestor_chain)
        full_path = _blueprint_full_path(row_chain[-1]) if row_chain else ancestor_full_path
        instances = _blueprint_walk_suffix([scope], full_path[len(ancestor_full_path):])

        elements = []
        for instance in instances:
            el = ET.Element(target_node["name"])
            for child in target_node["children"]:
                result = _build_blueprint_node(top_scope, instance, row_chain, full_path, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
            elements.append(el)
        return elements

    source_name = target_node["source"]
    leaf_node = _BLUEPRINT_LEAF_BY_NAME[source_name]
    chain = _blueprint_repeating_chain(source_name)
    if chain:
        scopes = _blueprint_walk_suffix([scope], _blueprint_full_path(source_name)[len(ancestor_full_path):])
    else:
        # Broadcast: this field has no repeating source ancestor at all, so
        # it's resolved relative to the whole page, not wherever the current
        # target group instance happens to be.
        scopes = _blueprint_walk_suffix([top_scope], _blueprint_full_path(source_name))

    resolved = scopes[0] if scopes else None
    el = ET.Element(target_node["name"])
    el.text = ("false" if leaf_node["mode"] == "exists" else "") if resolved is None else _resolve_flatten_leaf_value(resolved, leaf_node)
    return el


def _build_blueprint_tree(top_scope, target_roots):
    elements = []
    for target_node in target_roots:
        result = _build_blueprint_node(top_scope, top_scope, [], [], target_node)
        if isinstance(result, list):
            elements.extend(result)
        else:
            elements.append(result)
    return elements


# Issue #84: best-effort numeric normalization for a "toNumber" transform —
# finds the first numeric-looking substring and normalizes its decimal
# separator to '.', stripping thousands separators/currency symbols. When
# both '.' and ',' appear, the rightmost one is treated as the decimal point
# (handles both "1.234,56" and "1,234.56"); a single separator appearing more
# than once is treated as a thousands separator and stripped; a single
# separator appearing exactly once is treated as the decimal point (so
# "12,99"/"12.99" both work, at the cost of a genuinely ambiguous
# single-occurrence case like "1.234" always being read as 1.234, never as
# 1234 — chain a regex-extract transform first if that's not what's wanted).
# Empty string if nothing numeric is found.
def _to_number(value):
    match = re.search(r"-?\d[\d.,]*", value)
    if not match:
        return ""
    raw = match.group(0)
    last_dot = raw.rfind(".")
    last_comma = raw.rfind(",")
    if last_dot != -1 and last_comma != -1:
        decimal_pos = max(last_dot, last_comma)
        integer_part = raw[:decimal_pos].replace(".", "").replace(",", "")
        fractional_part = raw[decimal_pos + 1:]
        normalized = f"{integer_part}.{fractional_part}"
    elif raw.count(",") > 1 or raw.count(".") > 1:
        normalized = raw.replace(",", "").replace(".", "")
    else:
        normalized = raw.replace(",", ".")
    try:
        numeric = float(normalized)
    except ValueError:
        return ""
    return str(int(numeric)) if numeric.is_integer() else str(numeric)


# Issue #205: safe, explicit type-conversion transforms -- unlike toNumber's
# best-effort heuristic extraction, these either produce a well-formed value
# or fall back to their own clearly defined "onError" behavior
# ("KeepOriginal" leaves the pre-conversion value untouched, "UseDefault"
# substitutes the transform's own configured "defaultValue") rather than
# silently guessing.
_DATE_FORMAT_TOKEN_PATTERNS = {"yyyy": r"(?P<yyyy>\d{4})", "mm": r"(?P<mm>\d{1,2})", "dd": r"(?P<dd>\d{1,2})"}


def _type_conversion_fallback(value, on_error, default_value):
    return default_value if on_error == "UseDefault" else value


def _to_integer(value, on_error, default_value):
    stripped = value.strip()
    if re.fullmatch(r"[+-]?\d+", stripped):
        return str(int(stripped))
    return _type_conversion_fallback(value, on_error, default_value)


def _to_boolean(value, on_error, default_value):
    normalized = value.strip().lower()
    if normalized in ("true", "1", "yes", "y"):
        return "True"
    if normalized in ("false", "0", "no", "n"):
        return "False"
    return _type_conversion_fallback(value, on_error, default_value)


# source_format is the same "{yyyy}"/"{mm}"/"{dd}" mini-template
# RangeSource.Format (RangeFormat.cs) already uses for ISO week/date
# parameters, compiled into a regex the same way (escape the literal
# template, then substitute each placeholder for its own capture group) so a
# format string valid on the companion side parses identically here. Also
# rejects a structurally-matching but non-existent calendar date (e.g.
# "2026-02-30") via date()'s own ValueError, not just a pattern match.
def _to_date(value, source_format, on_error, default_value):
    pattern = re.escape(source_format)
    for token, token_pattern in _DATE_FORMAT_TOKEN_PATTERNS.items():
        pattern = pattern.replace(re.escape("{" + token + "}"), token_pattern)
    match = re.fullmatch(pattern, value.strip())
    if match:
        try:
            return date(int(match.group("yyyy")), int(match.group("mm")), int(match.group("dd"))).isoformat()
        except ValueError:
            pass
    return _type_conversion_fallback(value, on_error, default_value)


# Applies a field's ordered transform chain (node["transform"], built by
# PythonFieldTransformLiteral) — each step's output feeds the next step's
# input, in the order the user configured them in. Not called for
# node["mode"] == "exists" (a boolean-ish presence check, not a string
# pipeline) — see extract_group below.
def _apply_transforms(value, transforms):
    for t in transforms:
        kind = t["kind"]
        if kind == "trim":
            value = value.strip()
        elif kind == "regexExtract":
            match = re.search(t["pattern"], value)
            if match:
                try:
                    value = match.group(t.get("group", 0)) or ""
                except (IndexError, re.error):
                    value = ""
            else:
                value = ""
        elif kind == "replace":
            value = value.replace(t["find"], t["replacement"])
        elif kind == "toNumber":
            value = _to_number(value)
        elif kind == "toInteger":
            value = _to_integer(value, t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
        elif kind == "toBoolean":
            value = _to_boolean(value, t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
        elif kind == "toDate":
            value = _to_date(value, t.get("sourceFormat", "{yyyy}-{mm}-{dd}"), t.get("onError", "KeepOriginal"), t.get("defaultValue", ""))
    return value


# Walks the container tree at runtime: a group node ("children" in node)
# resolves its selector against `scope` (once or repeatedly, depending on
# node["repeating"]) and recurses into each match; a data-field leaf reads
# text/attribute/existence from `scope` directly. One function handles any
# nesting depth without the template needing to mirror the tree structure.
def extract_group(scope, node):
    if "children" in node:
        if node["repeating"]:
            matches = scope.select(node["selector"])
        else:
            found = scope.select_one(node["selector"])
            # A non-repeating group with zero matches is simply omitted —
            # consistent with how a missing flat field is tolerated today,
            # not treated as an error (see planning doc "Offene Randfälle").
            matches = [found] if found else []

        elements = []
        for match in matches:
            el = ET.Element(node["name"])
            for child in node["children"]:
                result = extract_group(match, child)
                if isinstance(result, list):
                    el.extend(result)
                else:
                    el.append(result)
{{~ if hardening.enabled ~}}
            if node["repeating"] and not _passes_required_fields(el):
                continue
{{~ end ~}}
            elements.append(el)
        return elements

    el = ET.Element(node["name"])
    if node["mode"] == "exists":
        el.text = "true" if scope.select_one(node["selector"]) else "false"
    else:
        found = scope.select_one(node["selector"])
        if found is None:
            el.text = ""
        elif node["mode"] == "attribute":
            el.text = _apply_transforms(found.get(node["attribute"], "") or "", node["transform"])
        elif node["mode"] == "ownText":
            # Direct text-node children only, excluding any nested element's
            # own text — e.g. a badge <span> inside a name <h3> no longer
            # gets pulled into the name (unlike plain get_text() below, which
            # walks every descendant). NavigableString is itself a str
            # subclass, so this filters out child Tags without a separate
            # import.
            own_text = "".join(c for c in found.contents if isinstance(c, str)).strip()
            el.text = _apply_transforms(own_text, node["transform"])
        else:
            el.text = _apply_transforms(found.get_text(strip=True), node["transform"])
    return el


{{~ if output_is_json ~}}
# Converts the group tree (already extracted into ET.Element form by
# extract_group above) into nested dicts/lists for JSON output — reusing the
# same extraction walk instead of a second, JSON-specific one. A tag that
# occurs more than once among one element's children — several matches of a
# repeating group, or same-named sibling fields/groups, which Container-Mode
# explicitly allows — becomes a JSON list; a tag occurring exactly once stays
# a plain nested value.
def _xml_to_dict(element):
    children = list(element)
    if not children:
        return element.text or ""
    result = {}
    for child in children:
        value = _xml_to_dict(child)
        if child.tag not in result:
            result[child.tag] = value
        elif isinstance(result[child.tag], list):
            result[child.tag].append(value)
        else:
            result[child.tag] = [result[child.tag], value]
    return result
{{~ end ~}}


{{~ if change_detection.enabled ~}}
def _read_previous_output(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def _notify_email(diff_text):
    host = os.environ[SMTP_HOST_ENV_VAR]
    port = int(os.environ[SMTP_PORT_ENV_VAR]) if SMTP_PORT_ENV_VAR else 587
    username = os.environ.get(SMTP_USERNAME_ENV_VAR) if SMTP_USERNAME_ENV_VAR else None
    password = os.environ.get(SMTP_PASSWORD_ENV_VAR) if SMTP_PASSWORD_ENV_VAR else None
    sender = os.environ[NOTIFY_EMAIL_FROM_ENV_VAR]
    recipient = os.environ[NOTIFY_EMAIL_TO_ENV_VAR]

    msg = MIMEText(diff_text)
    msg["Subject"] = "Scraping Factory: changes detected"
    msg["From"] = sender
    msg["To"] = recipient

    # EHLO first so has_extn() actually knows what the server advertises —
    # opportunistic STARTTLS (upgrade only if offered) works against both a
    # real provider and an unauthenticated local/internal relay that never
    # advertises it, without needing the caller to say which kind it is.
    with smtplib.SMTP(host, port, timeout=10) as server:
        server.ehlo()
        if server.has_extn("starttls"):
            server.starttls()
            server.ehlo()
        if username and password:
            server.login(username, password)
        server.sendmail(sender, [recipient], msg.as_string())


def _notify_webhook(diff_text):
    url = os.environ[WEBHOOK_URL_ENV_VAR]
    payload = json.dumps({"subject": "Scraping Factory: changes detected", "diff": diff_text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)


# Best-effort: by the time this runs, the current run's own output has
# already been written successfully — a notification failure (unreachable
# SMTP host, webhook down, ...) is reported but never fails the overall run.
def _notify_change(old_content, new_content):
    diff_text = "\n".join(difflib.unified_diff(
        old_content.splitlines(), new_content.splitlines(), fromfile="previous", tofile="current", lineterm="",
    ))
    try:
        if CHANGE_DETECTION_NOTIFY == "Email":
            _notify_email(diff_text)
        else:
            _notify_webhook(diff_text)
    except Exception as e:
        print(f"Warning: change notification failed: {e}")
{{~ end ~}}


def scrape(url):
    # Multiple top-level groups (e.g. "Vorspeisen" and "Suppen") are siblings
    # in GROUPS, but XML needs exactly one root element — wrap them all
    # (across every paginated page from this start URL, see below) in a
    # single <Ergebnis> element.
    root = ET.Element("Ergebnis")
    blueprint_rows = []
    blueprint_tree_elements = []
    page_number = 1
    page_url = url
    while page_url:
        response = requests.get(page_url, headers=HEADERS, {{ if proxy.enabled }}proxies=_proxies_for_requests(), {{ end }}timeout=10)
        response.raise_for_status()
{{~ if hardening.enabled ~}}
        _BLOCKING_RESPONSES.append({"url": page_url, "final_url": response.url, "length": len(response.content), "text": response.text})
{{~ end ~}}
        # Use response.content (bytes) instead of response.text: requests
        # guesses the encoding from the Content-Type header, defaulting to
        # ISO-8859-1 when no charset is given — which mangles UTF-8 pages
        # that only declare their charset via <meta charset>. BeautifulSoup
        # detects that meta tag itself.
        soup = BeautifulSoup(response.content, "html.parser")

        page_elements = []
        for node in GROUPS:
            page_elements.extend(extract_group(soup, node))
        if not page_elements:
            break
        for el in page_elements:
            root.append(el)
{{~ if blueprint_mapping_enabled ~}}
        for node in GROUPS:
            blueprint_rows.extend(_flatten_group_tree_for_blueprint(soup, node, {}))
{{~ end ~}}
{{~ if blueprint_tree_mapping_enabled ~}}
        blueprint_tree_elements.extend(_build_blueprint_tree(soup, BLUEPRINT_TREE_MAPPING))
{{~ end ~}}

{{~ if pagination.enabled ~}}
        if page_number >= PAGINATION_MAX_PAGES:
            break
        page_number += 1
{{~ if pagination.kind == "nextLink" ~}}
        next_tag = soup.select_one(PAGINATION_NEXT_LINK_SELECTOR)
        next_href = next_tag.get("href") if next_tag else None
        page_url = urljoin(page_url, next_href) if next_href else None
{{~ else ~}}
        page_url = PAGINATION_URL_TEMPLATE.format(url=url, page=page_number)
{{~ end ~}}
{{~ else ~}}
        page_url = None
{{~ end ~}}
    return root, blueprint_rows, blueprint_tree_elements


def main():
{{~ if change_detection.enabled ~}}
    previous_content = _read_previous_output(OUTPUT_PATH)
{{~ end ~}}
    # Issue #83: each URL's own scrape() already wraps its matches in an
    # <Ergebnis> element (see above) — combine every URL's children into one
    # final <Ergebnis>, the same sibling-merging pattern already used for
    # multiple root groups from a single URL.
    root = ET.Element("Ergebnis")
    blueprint_rows = []
    blueprint_tree_elements = []
    for url in URLS:
        page_root, page_blueprint_rows, page_blueprint_tree_elements = scrape(url)
        for el in page_root:
            root.append(el)
        blueprint_rows.extend(page_blueprint_rows)
        blueprint_tree_elements.extend(page_blueprint_tree_elements)
{{~ if blueprint_mapping_enabled ~}}
    # Issue #192: BLUEPRINT_MAPPING flattens the tree into rows instead of
    # writing it out nested — `root` itself (used for hardening/change-
    # detection below) is unaffected, still the full, unflattened tree.
    output_fieldnames = [m["target"] for m in BLUEPRINT_MAPPING]
    output_rows = [{m["target"]: row.get(m["source"], "") for m in BLUEPRINT_MAPPING} for row in blueprint_rows]
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(output_rows, f, ensure_ascii=False, indent=2)
{{~ else ~}}
    with open(OUTPUT_PATH, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=output_fieldnames)
        writer.writeheader()
        writer.writerows(output_rows)
{{~ end ~}}
    count = len(output_rows)
{{~ else if blueprint_tree_mapping_enabled ~}}
    # Issue #244: BLUEPRINT_TREE_MAPPING builds a real nested output tree of
    # its own instead of denormalizing into rows — `root` itself (used for
    # hardening/change-detection below) is unaffected, still the full,
    # unmapped source tree.
    blueprint_tree_root = ET.Element("Ergebnis")
    for el in blueprint_tree_elements:
        blueprint_tree_root.append(el)
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(_xml_to_dict(blueprint_tree_root), f, ensure_ascii=False, indent=2)
{{~ else ~}}
    tree = ET.ElementTree(blueprint_tree_root)
    ET.indent(tree)
    tree.write(OUTPUT_PATH, encoding="utf-8", xml_declaration=True)
{{~ end ~}}
    count = len(blueprint_tree_root.findall(".//*"))
{{~ else ~}}
{{~ if output_is_json ~}}
    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(_xml_to_dict(root), f, ensure_ascii=False, indent=2)
    count = len(root.findall(".//*"))
{{~ else ~}}
    tree = ET.ElementTree(root)
    ET.indent(tree)
    tree.write(OUTPUT_PATH, encoding="utf-8", xml_declaration=True)
    count = len(root.findall(".//*"))
{{~ end ~}}
{{~ end ~}}
    print(f"Done — {count} {{ if blueprint_mapping_enabled }}row(s){{ else }}elements{{ end }} written to {OUTPUT_PATH}")
{{~ if change_detection.enabled ~}}
    with open(OUTPUT_PATH, "r", encoding="utf-8") as f:
        new_content = f.read()
    if previous_content is not None and previous_content != new_content:
        _notify_change(previous_content, new_content)
{{~ end ~}}
{{~ if hardening.enabled ~}}
    hardening_failed = _run_hardening_checks(root) or _report_required_fields_drops()
{{~ if hardening.has_baseline ~}}
    if not hardening_failed:
        _write_baseline(count)
{{~ end ~}}
    if hardening_failed:
        sys.exit(EXIT_HARDENING_FAILED)
{{~ end ~}}
{{~ if proxy.enabled ~}}
    if _PROXY_ENV_MISSING:
        sys.exit(EXIT_MISSING_ENV_VAR)
{{~ end ~}}


if __name__ == "__main__":
    main()
