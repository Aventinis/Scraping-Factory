{
  "name": "extension",
  "version": "1.20.4",
  "description": "Scraping Factory browser extension — visual scraper builder UI.",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/dist/"
    ],
    "transform": {
      "\\.js$": "babel-jest",
      "\\.ts$": "<rootDir>/jest-transform.js"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "json"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "marked": "^18.1.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
}
