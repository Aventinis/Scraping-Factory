{
  "manifest_version": 3,
  "name": "Scraping Factory",
  "version": "0.1.0",
  "description": "Visueller Scraper-Builder — generiert eigenständige Python-Skripte.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["shared/logger.js", "content/content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/api-capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Scraping Factory"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "minimum_chrome_version": "114"
}
