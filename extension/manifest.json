{
  "manifest_version": 3,
  "name": "Scraping Factory",
  "version": "0.1.0",
  "description": "Visueller Scraper-Builder — generiert eigenständige Python-Skripte.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scraping Factory"
  }
}
