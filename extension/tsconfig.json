{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    // TypeScript sources are type-checked in full under `strict`. A remaining .js file is only checked when it carries a leading
    // "// @ts-check" pragma (Issue #238); the migration to .ts proceeds file by file (Issue #394).
    "strict": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "e2e", "dist"]
}
