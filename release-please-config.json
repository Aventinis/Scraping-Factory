{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "extra-files": [
        { "type": "json", "path": "extension/manifest.json", "jsonpath": "$.version" },
        { "type": "json", "path": "extension/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
